  "paths": {
    "/trusted-issuers/universities": {
      "get": {
        "operationId": "issuers",
        "summary": "",
        "description": "Get all universities defined as trusted issuers in BESU blockchain",
        "responses": {
          "200": {
            "description": "Fetch Resource."
          },
          "401": {
            "description": "The client is not allowed to access resource"
          }
        }
      },
      "post": {
        "operationId": "issuerPost",
        "summary": "",
        "description": "Create new university resource and add it to the Trusted issuers. This issuer signs for VA and VP. <br />The DID is generated by the Wallet from Enterprise Name <br />The ETH moderator address is currently the wallet address that deployed the smart contracts <br />In order to authorize please make a GET Request to the challenge API with the university DID that you want to insert and type = universities and create an ETH signature on that message",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UniversityBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "University created"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "The client is not allowed to access resource"
          }
        }
      }
    },
    "/trusted-issuers/governments": {
      "get": {
        "operationId": "issuersGov",
        "summary": "",
        "description": "Get all governments from besu blockchain",
        "responses": {
          "200": {
            "description": "Fetch Resource."
          },
          "401": {
            "description": "The client is not allowed to access resource"
          }
        }
      },
      "post": {
        "operationId": "issuerGovPost",
        "summary": "",
        "description": "Create new government resource and add it to the governments trusted issuers. This type of issuer signs for EIDs<br />The DID is generated by the Wallet from Enterprise Name <br />The ETH moderator address is currently the wallet address that deployed the smart contracts <br />In order to authorize please make a GET Request to the challenge API with the university DID that you want to insert and type = governments and create an ETH signature on that message",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GovernmentBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Accreditation added"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "The client is not allowed to access resource"
          }
        }
      }
    },
