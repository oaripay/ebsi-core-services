    }
    stages {
        stage('Setup') {
            steps {
                sh '''
                    source $NVM_DIR/nvm.sh > /dev/null 2>&1
                    nvm install > /dev/null 2>&1
                    yarn install --frozen-lockfile
                '''
            }
        }
        stage('Lint') {
            when {
                expression { params.api == 'all'}
            }
            steps {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                    sh '''
                        source $NVM_DIR/nvm.sh > /dev/null 2>&1
                        nvm use > /dev/null 2>&1
                        yarn lint:all
                    '''
                }
            }
        }
        stage('Authorisation-Api-v3') {
            when {
                expression { params.api == 'all' || params.api.contains('authorisation-api-v3') }
            }
            steps {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                    sh '''
                        source $NVM_DIR/nvm.sh > /dev/null 2>&1
                        nvm use > /dev/null 2>&1
                        yarn nx test:ci @ebsiint-api/authorisation-api-v3
                    '''
                }
                script {
                    sh 'rm ${WORKSPACE}/apis/authorisation-v3/.scannerwork/report-task.txt'
                }
            }
        }
