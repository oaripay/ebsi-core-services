        buildDiscarder(
            logRotator(
                numToKeepStr: '5',
                daysToKeepStr: '2'
            )
        )
    }
    //triggers{
    //    cron('0 8 * * *')
    //}
    parameters {
        extendedChoice(defaultValue: 'all', description: 'What API will be executed?', multiSelectDelimiter: ',', name: 'api', quoteValue: false, saveJSONParameterToFile: false, type: 'PT_CHECKBOX', value: 'all, authorisation-api-v2, authorisation-api-v3, did-registry-api-v3, did-registry-api-v4, ledger-api, notification-api, proxy-data-hub-api, storage-api, timestamp-api, trusted-apps-registry-api, trusted-issuers-registry-api-v3, trusted-issuers-registry-api-v4, trusted-policies-registry-api, trusted-schemas-registry-api', visibleItemCount: 17)
    }
    stages {
        stage('Setup') {
            steps {
                nodejs(nodeJSInstallationName: '16.17.1') {
                    sh 'yarn install --frozen-lockfile'
                }
            }
        }
        stage('Lint') {
            when {
                expression { params.api == 'all'}
            }
            steps {
                nodejs(nodeJSInstallationName: '16.17.1') {
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE'){
                        sh 'yarn lint:all'
                    }
                }
            }
        }
        stage('Authorisation-Api') {
            when {
                expression { params.api == 'all' || params.api.contains('authorisation-api-v2')}
            }
            steps {

                nodejs(nodeJSInstallationName: '16.17.1') {
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE'){
                    sh 'yarn nx test:ci @ebsiint-api/authorisation-api-v2'
                    }
                }
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE'){
                    withSonarQubeEnv('LocalSonar'){
                        sh "/var/lib/jenkins/tools/hudson.plugins.sonar.SonarRunnerInstallation/sonar-scanner/bin/sonar-scanner -Dsonar.host.url=https://infra.ebsi.xyz/sonar -Dsonar.projectName=authorisation-api-core-services -Dsonar.projectVersion=1.0 -Dsonar.projectKey=authorisation-api-core-services -Dsonar.sources=. -Dsonar.projectBaseDir=${WORKSPACE}/apis/authorisation"
                    }
                    waitForQualityGate abortPipeline: true
                }
                script{
                    sh 'rm ${WORKSPACE}/apis/authorisation/.scannerwork/report-task.txt'
                }
            }
        }
