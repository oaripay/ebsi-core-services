pipeline {
    agent any
    triggers{
        cron('0 8 * * *')
    }
    parameters {
        extendedChoice(defaultValue: 'all', description: 'What API will be executed?', multiSelectDelimiter: ',', name: 'api', quoteValue: false, saveJSONParameterToFile: false, type: 'PT_CHECKBOX', value: 'all, authorisation-api, did-registry-api, ledger-api, notification-api, proxy-data-hub-api, storage-api, timestamp-api, trusted-apps-registry-api, trusted-issuers-registry-api, trusted-ledgers-registry-api, trusted-policies-registry-api, trusted-schemas-registry-api, users-onboarding-api', visibleItemCount: 15)
    }
    stages {        
        stage('Setup') {
            steps {                
                nodejs(nodeJSInstallationName: '16.13.0') {
                    sh 'yarn install --frozen-lockfile'
                }                
            }
        }
        stage('Lint') {
            when {
                expression { params.api == 'all'}
            }
            steps {                
                nodejs(nodeJSInstallationName: '16.13.0') {                    
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE'){
                        sh 'yarn lint:all'
                    }
                }                
            }
        }
        stage('Authorisation-Api') {    
            when {
                expression { params.api == 'all' || params.api.contains('authorisation-api')}
            }        
            environment {
                API_PRIVATE_KEY=credentials('API_AUTHORISATION_PRIVATE_KEY')
            }
            steps {                
                nodejs(nodeJSInstallationName: '16.13.0') {           
                            
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE'){                        
                        sh 'yarn nx test:ci @ebsiint-api/authorisation'
                    }
                }                                     
            }       
        }
        stage('Did-Registry-Api') { 
            when {
                expression { params.api == 'all' || params.api.contains('did-registry-api')}
            }           
            environment {
                API_PRIVATE_KEY=credentials('TEST_DID_API_PRIVATE_KEY')
            }
            steps {                
                nodejs(nodeJSInstallationName: '16.13.0') {
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE'){
                        sh 'yarn nx test:ci @ebsiint-api/did-registry'
