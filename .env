# Default settings for the app
# You can override these settings by creating a new file called .env.local

# Supported values: "local" | "test" | "pilot" | "prod"
EBSI_ENV=

# A secp256k1 elliptic curve private key in hexadecimal
API_PRIVATE_KEY=

# API URL (default: "/timestamp/v2")
# API_URL_PREFIX=

# API NAME (default: timestamp-api)
# API_NAME=

# API KID, i.e. URL to the app in the TAR API
API_KID=

# API Authorisation name (default: authorisation-api)
# AUTHORISATION_API_NAME=

# API Authorisation did 
AUTHORISATION_API_DID=

# API Authorisation URL
# Default value: depends on the environment, see src/config/configuration.ts
# AUTHORISATION_API_URL=

# API Ledger name (default: ledger-api)
# LEDGER_API_NAME=

# API Ledger URL, e.g. "https://api.ebsi.xyz/ledger/v1"
# Default value depends on EBSI_ENV
# LEDGER_API_URL=

# Trusted Apps Registry URL
# Default value: depends on the environment, see src/config/configuration.ts
# TRUSTED_APPS_REGISTRY_API_URL=

# DID Registry URL
# Default value: depends on the environment, see src/config/configuration.ts
# DID_REGISTRY_API_URL=

# Port on which the server should listen
# Default value: 3000
# Warning: if you override this variable, make sure that docker-compose.yml opens the right port
# API_PORT=

# Supported values : "silent" | "error" | "warn" | "info" | "verbose" | "debug"
# Default value: depends on the environment, see src/config/configuration.ts
# "silent" turns the logger off
# LOG_LEVEL=

# Contract address, e.g. 0xCA40574d5aD8dBa0370A5E34eE830e4714a0Fa09
CONTRACT_ADDR=

# DOMAIN's default value depends on the EBSI_ENV environment
# E.g. "https://api.intebsi.xyz"
# DOMAIN=

# URL to call when performing a health check
# HEALTH_CHECK=
