# Default settings for the app
# You can override these settings by creating a new file called .env.local

# Supported values: "local" | "test" | "pilot" | "prod"
EBSI_ENV=

# A secp256k1 elliptic curve private key in hexadecimal
API_PRIVATE_KEY=

# API URL prefix
API_URL_PREFIX=/notifications/v1

# API URL origin
# Default value: depends on the environment
# E.g. for DEV: https://api.ebsi.xyz
# API_URL_ORIGIN=

# Port on which the server should listen
# Default value: 3000
# Warning: if you override this variable, make sure that docker-compose.yml opens the right port
# API_PORT=

# Supported values : "silent" | "error" | "warn" | "info" | "verbose" | "debug"
# Default value: depends on the environment, see src/config/configuration.ts
# "silent" turns the logger off
# LOG_LEVEL=

# Health check URLs
# Default values are provided src/config/configuration.ts
# HEALTHCHECK_EBSI_API=

# Cassandra variables

# Contact points
# Set contact points separated by commas
# Default value: cassandradb,localhost
# CASSANDRA_CONTACT_POINTS=

# Local datacenter
# Default value: datacenter1
# CASSANDRA_LOCAL_DATACENTER=

# Keyspace
# Default value: depends on the environment, see src/config/configuration.ts
# CASSANDRA_KEYSPACE=

# Consistency level for writing
# Supported values : "any" | "one" | "two" | "three" | "quorum" | "all" | "localQuorum" | "eachQuorum" | "localOne"
# Default value: one
# CASSANDRA_CONSISTENCY_WRITE=

# Consistency level for reading
# Supported values : "any" | "one" | "two" | "three" | "quorum" | "all" | "localQuorum" | "eachQuorum" | "localOne"
# Default value: one
# CASSANDRA_CONSISTENCY_READ=

# Cassandra authentication
CASSANDRA_USER=
CASSANDRA_PASSWORD=
