# Default settings for the app
# You can override these settings by creating a new file called .env.local

# Supported values: "local" | "test" | "pilot" | "prod"
EBSI_ENV=

# API URL
# API_URL_PREFIX=/storage/v2

# Port on which the server should listen
# Default value: 3000
# Warning: if you override this variable, make sure that docker-compose.yml opens the right port
# API_PORT=

# Supported values : "silent" | "error" | "warn" | "info" | "verbose" | "debug"
# Default value: depends on the environment, see src/config/configuration.ts
# "silent" turns the logger off
# LOG_LEVEL=

# DOMAIN's default value depends on EBSI_ENV
# E.g. "https://api.intebsi.xyz"
# DOMAIN=

# URL to call when performing a health check. Default value depend on EBSI_ENV
# E.g "https://api.test.intebsi.xyz/docs/"
# HEALTH_CHECK=

# Secret passphrase used to encrypt/decrypt pageState (Cassandra)
ENCRYPTION_SECRET=

# Cassandra user
CASSANDRA_USER=

# Cassandra password
CASSANDRA_PASSWORD=

# Cassandra read consistency level
# Default value: two
# CASSANDRA_CONSISTENCY_READ=

# Cassandra write consistency level
# Default value: two
# CASSANDRA_CONSISTENCY_WRITE=

# Cassandra contact points
# Default value: cassandradb,localhost
# CASSANDRA_CONTACT_POINTS=

# Cassandra local datacenter
# Default value: datacenter1
# CASSANDRA_LOCAL_DATACENTER=

# Cassandra keyspace
# Default value depends on EBSI_ENV
# CASSANDRA_KEYSPACE=
