# Default settings for the app
# You can override these settings by creating a new file called .env.local

# Supported values: "local" | "test" | "conformance" | "pilot" | "prod"
EBSI_ENV=

# API domain as per https://ec.europa.eu/digital-building-blocks/wikis/pages/viewpage.action?spaceKey=BLOCKCHAININT&title=Technical+transition+to+the+new+environments
# - localhost (for development purpose only)
# - test.intebsi.xyz
# - api-conformance.ebsi.eu
# - api-pilot.ebsi.[domain]
# - api-preprod.ebsi.[domain]
# - api.ebsi.[domain]
# Format as an uri starting with http(s)
DOMAIN=

# A secp256k1 elliptic curve private key in hexadecimal
API_PRIVATE_KEY=

# Node-specific API name, as registered in the Trusted Apps Registry
API_NAME=

# KID of the verification method to be used to sign the VC JWT
# e.g. "did:ebsi:xxxxx#key-1"
API_VERIFICATION_METHOD_KID=

# API URL
# API_URL_PREFIX=/users-onboarding/v2

# Port on which the server should listen
# Default value: 3000
# Warning: if you override this variable, make sure that docker-compose.yml opens the right port
# API_PORT=3000

# Supported values : "silent" | "error" | "warn" | "info" | "verbose" | "debug"
# Default value: depends on the environment, see src/config/configuration.ts
# "silent" turns the logger off
# LOG_LEVEL=

# Local API origin (Docker), e.g. "http://api.local"
# When defined, the API will first call this local API before querying the public API if the first request fails
# Default: empty string
# LOCAL_ORIGIN=

# EULOGIN SERVICE ENDPOINT
# EU_LOGIN_VALIDATE_SERVICE_URL=

# RECAPTCHA SERVICE ENDPOINT
# RECAPTCHA_SERVICE_URL=

# DOMAIN REGISTERED IN RECAPTCHA SERVICE
# RECAPTCHA_REGISTERED_HOSTNAME=

# AUTHORISATION CREDENTIAL SCHEMA
AUTHORISATION_CREDENTIAL_SCHEMA=

# RECAPTCHA API SECRET KEY
RECAPTCHA_API_KEY=

# Request timeout (number in milliseconds, default: 15000, i.e. 15s)
# Max amount of time a request **made by the API** can take before failing.
# REQUEST_TIMEOUT=
