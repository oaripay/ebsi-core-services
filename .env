# Default settings for the app
# You can override these settings by creating a new file called .env.local

# Supported values: "local" | "test" | "conformance" | "pilot" | "prod"
EBSI_ENV=

# A secp256k1 elliptic curve private key in hexadecimal
API_PRIVATE_KEY=

# API URL
# API_URL_PREFIX=/trusted-policies-registry/v1

# API KID, i.e. URL to the app in the TAR API
# For example: https://api.test.intebsi.xyz/trusted-apps-registry/v2/apps/0xc96461bad370d1cea896b38b44ac5e06b305e7580d48774289d9d55b6736454d
API_KID=

# Port on which the server should listen
# Default value: 3000
# Warning: if you override this variable, make sure that docker-compose.yml opens the right port
# API_PORT=

# API name, as registered in the TAR (default: trusted-policies-registry-api)
# API_NAME=

# Contract address, e.g. 0x5a2413Aee431Fa836905EF682D851e1Ba6CedbC4
CONTRACT_ADDR=

# Authorisation API DID, as registered in the DID Registry
AUTHORISATION_API_DID=

# Authorisation API URL (default: depends on the environment, see src/config/configuration.ts)
# AUTHORISATION_API_URL=

# DID Registry API URL
# Default value: depends on the environment, see src/config/configuration.ts
# DID_REGISTRY_API_URL=

# Supported values : "silent" | "error" | "warn" | "info" | "verbose" | "debug"
# Default value: depends on the environment, see src/config/configuration.ts
# "silent" turns the logger off
# LOG_LEVEL=

# DOMAIN's default value depends on the EBSI_ENV environment
# E.g. "https://api.intebsi.xyz"
# DOMAIN=

# Ledger API URL, e.g. "https://api.test.intebsi.xyz/ledger/v2"
# Default value depends on EBSI_ENV
# LEDGER_API_URL=

# Ledger API name, as registered in the TAR (default: "ledger-api")
# LEDGER_API_NAME=

# Local API origin (Docker), e.g. "http://api.local"
# When defined, the API will first call this local API before querying the public API if the first request fails
# Default: empty string
# LOCAL_ORIGIN=

# URL to call when performing a health check
# HEALTH_CHECK=
