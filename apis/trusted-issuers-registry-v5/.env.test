# Override .env settings for testing
# E.g. make sure all the tests run in "test" env
# You can override these settings by creating a new file called .env.test.local
NETWORK=test
DOMAIN=https://api-test.ebsi.eu
BESU_RPC_NODE=https://besu.local
BESU_READINESS_ENDPOINT=http://besu:8545/readiness
BESU_TRUSTED_ISSUERS_REGISTRY_ADDRESS=0xC2113689d64b794Dc311A38bFA1f7A1D5E4B6Cb9

# Test Client
# Used for e2e tests. This client must be registered in the DID Registry AND in the TPR SC as authorized.
# TEST_ADMIN_KID=
# TEST_ADMIN_PRIVATE_KEY=
# TEST_ADMIN_ACCREDITATION=

# DID of a Trusted Issuer with at least 1 proxy
# Its DID document MUST be registered in the DID Registry
# TEST_ISSUER_WITH_PROXY_KID="did:ebsi:z22tm1yE3NKzgo1Yf89o2M3x"
# TEST_ISSUER_WITH_PROXY_PRIVATE_KEY=

# Verifiable attestation schema ID
TEST_VERIFIABLE_ATTESTATION_SCHEMA_ID=zH74MKkYTbQ6ZfTxufi6A3Aw8giS4piGm8dpgxFmkJjmu

# The schema ID of the StatusList2021Credential JSON schema, as registered in the TSR
TEST_STATUS_LIST_2021_SCHEMA_ID=zrpwfYDBB5CcZweDGtFfvSb5xgMsFetkcCDGKPZAPwk4

# The schema ID of the BitstringStatusListCredential JSON schema, as registered in the TSR
TEST_BITSTRING_STATUS_LIST_SCHEMA_ID=zD1YFDrV5fwbMcqbLE14UFrd17rYjCfU86mwtJey1pDC2

# Env for e2e tests. Switch to remote API instance with `TEST_ENV=remote`
# TEST_ENV=

# Domain of a specific node in the network
# TEST_SPECIFIC_NODE_DOMAIN=

# Set `TEST_ENABLE_WRITE_OPS=true` to enable write operations during the tests
# TEST_ENABLE_WRITE_OPS=

# Test Blockscout
# BLOCKSCOUT_URL=
# BLOCKSCOUT_BEARER_TOKEN=
