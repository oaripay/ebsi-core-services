{
  "name": "@ebsiint-api/did-registry-api-v6",
  "private": true,
  "version": "6.0.0-rc.2",
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "build": "nest build -p tsconfig.production.json",
    "codegen": "graphclient build --fileType js",
    "docker:build": "docker build . -t ebsi/did-registry-api-v6:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint .",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:prettier": "prettier . --check",
    "lint:tsc": "tsc --noEmit --incremental false",
    "prebuild": "rimraf dist",
    "prepare": "yarn codegen && node patchGraphClient.js",
    "start": "nest start -p tsconfig.dev.json",
    "start:dev": "yarn start --watch",
    "start:debug": "yarn start:dev --debug",
    "start:prod": "node dist/main",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --run",
    "test:e2e": "vitest --run -c vitest.config.e2e.ts",
    "test:ci": "yarn test:unit --coverage --reporter=default"
  },
  "dependencies": {
    "@ebsiint-api/shared": "^1.1.0-rc.10",
    "@ebsiint-sc/did-registry-v4": "^4.0.0-rc.2",
    "@ebsiint-subgraph/did-registry-v4": "^0.0.0-rc.0",
    "@ethersproject/address": "^5.7.0",
    "@fastify/accepts": "^4.3.0",
    "@fastify/helmet": "^11.1.1",
    "@graphprotocol/client-cli": "^3.0.7",
    "@nestjs/axios": "^3.1.2",
    "@nestjs/common": "^10.4.12",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.12",
    "@nestjs/platform-fastify": "^10.4.12",
    "@nestjs/terminus": "^10.2.3",
    "axios": "^1.7.8",
    "axios-retry": "^4.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "ethers": "^5.7.2",
    "graphql": "^16.9.0",
    "joi": "^17.13.3",
    "jose": "^4.15.5",
    "nest-winston": "^1.9.7",
    "reflect-metadata": "^0.2.2",
    "safe-stable-stringify": "^2.5.0",
    "winston": "^3.17.0",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cef-ebsi/verifiable-credential": "^6.2.0-alpha.2",
    "@cef-ebsi/wallet-lib": "^6.0.0-alpha.2",
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.12",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@stoplight/spectral-cli": "^6.14.2",
    "@swc/core": "^1.9.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/node22": "^22.0.0",
    "@tsconfig/strictest": "^2.0.5",
    "@types/k6": "^0.54.2",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "did-jwt": "^8.0.4",
    "did-resolver": "^4.1.0",
    "hardhat": "^2.22.16",
    "msw": "^2.6.6",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
