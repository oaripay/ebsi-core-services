{
  "name": "@ebsiint-api/authorisation-api-v5",
  "private": true,
  "version": "5.0.0-rc.1",
  "type": "module",
  "license": "EUPL-1.2",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/authorisation-api-v5:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "start": "nest start -p tsconfig.dev.json",
    "start:dev": "yarn start --watch",
    "start:debug": "yarn start:dev --debug",
    "start:prod": "node dist/main",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:eslint": "eslint . --ext .js,.cjs,.ts",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --run",
    "test:e2e": "vitest --run -c vitest.config.e2e.ts",
    "test:ci": "yarn test:unit --coverage --reporter=default"
  },
  "dependencies": {
    "@cef-ebsi/ebsi-uri": "^0.1.0",
    "@cef-ebsi/verifiable-credential": "^6.0.4",
    "@cef-ebsi/verifiable-presentation": "^7.0.4",
    "@cef-ebsi/wallet-lib": "^5.0.4",
    "@ebsiint-api/shared": "^1.1.0-rc.10",
    "@fastify/formbody": "^7.4.0",
    "@fastify/helmet": "^11.1.1",
    "@nestjs/axios": "^3.0.3",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-fastify": "^10.4.1",
    "@nestjs/terminus": "^10.2.3",
    "@sphereon/pex": "^3.3.1",
    "axios": "^1.7.7",
    "cache-manager": "^5.7.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "did-jwt": "^8.0.4",
    "ethers": "^5.7.2",
    "joi": "^17.13.3",
    "jose": "^4.15.5",
    "nest-winston": "^1.9.7",
    "qs": "^6.13.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "winston": "^3.14.2",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.1",
    "@sphereon/pex-models": "^2.2.4",
    "@stoplight/spectral-cli": "^6.12.0",
    "@swc/core": "^1.7.26",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/node20": "^20.1.4",
    "@tsconfig/strictest": "^2.0.5",
    "@types/k6": "^0.53.1",
    "@types/node": "^20.14.14",
    "@types/qs": "^6.9.15",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.4.0",
    "did-resolver": "^4.1.0",
    "msw": "^2.3.5",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "5.3.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^1.4.0"
  }
}
