{
  "name": "@ebsiint-api/trusted-policies-registry-api-v4",
  "private": true,
  "version": "3.0.0-rc.3",
  "type": "module",
  "license": "EUPL-1.2",
  "scripts": {
    "build": "nest build -p tsconfig.production.json",
    "codegen": "graphclient build --fileType js",
    "docker:build": "docker build . -t ebsi/trusted-policies-registry-api-v4:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .js,.cjs,.ts",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:prettier": "prettier . --check",
    "lint:tsc": "tsc --noEmit --incremental false",
    "prebuild": "rimraf dist",
    "prepare": "yarn codegen && node patchGraphClient.js",
    "start": "nest start -p tsconfig.dev.json",
    "start:dev": "yarn start --watch",
    "start:debug": "yarn start:dev --debug",
    "start:prod": "node dist/main",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --run",
    "test:e2e": "vitest --run -c vitest.config.e2e.ts",
    "test:ci": "yarn test:unit --coverage --reporter=default"
  },
  "dependencies": {
    "@ebsiint-api/shared": "^1.1.0-rc.7",
    "@ebsiint-sc/trusted-policies-registry-v3": "^3.0.0-rc.0",
    "@ethersproject/address": "^5.7.0",
    "@ethersproject/bignumber": "^5.7.0",
    "@fastify/helmet": "^11.1.1",
    "@graphprotocol/client-cli": "^3.0.3",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "^10.3.5",
    "@nestjs/config": "^3.2.1",
    "@nestjs/core": "^10.3.5",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-fastify": "^10.3.5",
    "@nestjs/terminus": "^10.2.3",
    "async-mutex": "^0.5.0",
    "axios": "^1.6.8",
    "axios-retry": "^4.1.0",
    "cache-manager": "^5.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ethers": "^5.7.2",
    "graphql": "^16.8.1",
    "joi": "^17.12.2",
    "jose": "^4.15.5",
    "nest-winston": "^1.9.4",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "winston": "^3.13.0",
    "yaml": "^2.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cef-ebsi/ebsi-uri": "^0.1.0-alpha.1",
    "@cef-ebsi/verifiable-credential": "^6.0.0-alpha.1",
    "@cef-ebsi/verifiable-presentation": "^7.0.0-alpha.1",
    "@cef-ebsi/wallet-lib": "^5.0.2",
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.5",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@stoplight/spectral-cli": "^6.11.0",
    "@swc/core": "^1.4.11",
    "@tsconfig/node20": "^20.1.3",
    "@tsconfig/strictest": "^2.0.4",
    "@types/k6": "^0.50.0",
    "@types/node": "^20.11.30",
    "@types/passport-http-bearer": "^1.0.41",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^7.4.7",
    "@vitest/coverage-v8": "^1.4.0",
    "did-jwt": "^8.0.4",
    "hardhat": "~2.20.1",
    "msw": "^2.2.11",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "5.3.3",
    "unplugin-swc": "^1.4.4",
    "vitest": "^1.4.0"
  }
}
