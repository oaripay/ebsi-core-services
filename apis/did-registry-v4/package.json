    "@ebsiint-sc/bootstrap": "^1.0.0",
    "@ebsiint-sc/did-registry-v4": "^1.0.0",
    "@fastify/helmet": "^10.1.0",
    "@nestjs/axios": "^1.0.0",
    "@nestjs/common": "^9.2.1",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^9.2.1",
