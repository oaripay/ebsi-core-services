    "eslint-plugin-jest": "^27.1.6",
    "eslint-plugin-prettier": "^4.2.1",
    "hardhat": "^2.12.4",
    "jest": "^28.1.3",
    "jest-sonar": "^0.2.15",
    "key-encoder": "^2.0.3",
    "nock": "^13.2.9",
    "supertest": "^6.3.3",
    "ts-jest": "^28.0.8",
