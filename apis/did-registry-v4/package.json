    "@nestjs/terminus": "^9.1.4",
    "axios": "1.1.3",
    "canonicalize": "^1.0.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "did-jwt": "^6.11.0",
    "elliptic": "^6.5.4",
    "ethers": "^5.7.2",
    "joi": "^17.7.0",
    "jose": "^4.11.1",
    "multiformats": "^9.7.1",
    "multihashes": "^4.0.3",
    "nest-winston": "^1.8.0",
    "passport": "^0.6.0",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.6.0",
    "winston": "^3.8.1"
