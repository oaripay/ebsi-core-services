{
  "name": "@ebsiint-api/authorisation-api-v4",
  "private": true,
  "version": "4.0.0-rc.10",
  "type": "module",
  "license": "EUPL-1.2",
  "scripts": {
    "clean": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/authorisation-api-v4:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "prepare": "yarn clean",
    "start": "nest start -p tsconfig.dev.json",
    "start:dev": "yarn start --watch",
    "start:debug": "yarn start:dev --debug",
    "start:prod": "node dist/main",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:eslint": "eslint .",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --run",
    "test:e2e": "vitest --run -c vitest.config.e2e.ts",
    "test:ci": "yarn test:unit --coverage --reporter=default"
  },
  "dependencies": {
    "@cef-ebsi/ebsi-uri": "^1.0.1",
    "@cef-ebsi/verifiable-credential": "^8.0.0-alpha.4",
    "@cef-ebsi/verifiable-presentation": "^9.0.0-alpha.4",
    "@cef-ebsi/wallet-lib": "^6.0.3-alpha.1",
    "@ebsiint-api/shared": "^1.1.0-rc.14",
    "@fastify/accepts": "^5.0.3",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-fastify": "^11.1.9",
    "@nestjs/terminus": "^11.0.0",
    "@sphereon/pex": "^4.1.0",
    "axios": "^1.13.2",
    "cache-manager": "^6.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "did-jwt": "^8.0.18",
    "ethers": "^6.15.0",
    "joi": "^18.0.2",
    "jose": "^5.10.0",
    "keyv": "^5.5.4",
    "nestjs-pino": "^4.5.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "qs": "^6.14.0",
    "reflect-metadata": "^0.2.2",
    "safe-stable-stringify": "^2.5.0",
    "yaml": "^2.8.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@cef-ebsi/vcdm1.1-attestation-schema": "^2.0.0",
    "@cef-ebsi/vcdm2.0-attestation-schema": "^2.1.0-next.0",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@sphereon/pex-models": "^2.3.2",
    "@stoplight/spectral-cli": "^6.15.0",
    "@swc/core": "^1.15.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/node22": "^22.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/k6": "^1.4.0",
    "@types/node": "^22.17.0",
    "@types/qs": "^6.14.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "did-resolver": "^4.1.0",
    "msw": "^2.12.3",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.2.4"
  }
}
