{
  "name": "@ebsiint-api/trusted-policies-registry-api-v3",
  "private": true,
  "version": "3.0.0-rc.1",
  "type": "module",
  "license": "EUPL-1.2",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/trusted-policies-registry-api-v3:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .js,.cjs,.ts",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --run",
    "test:e2e": "vitest --run -c vitest.config.e2e.ts",
    "test:ci": "yarn test:unit --coverage --reporter=default --reporter=vitest-sonar-reporter"
  },
  "dependencies": {
    "@cef-ebsi/oauth2-auth": "^3.0.0",
    "@cef-ebsi/siop-auth": "^4.0.0",
    "@ebsiint-api/shared": "^1.1.0-rc.5",
    "@ebsiint-sc/trusted-policies-registry-v2": "^2.0.0-rc.1",
    "@fastify/helmet": "^11.1.1",
    "@nestjs/axios": "^3.0.1",
    "@nestjs/common": "^10.2.10",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.2.10",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-fastify": "^10.2.10",
    "@nestjs/terminus": "^10.2.0",
    "async-mutex": "^0.4.0",
    "axios": "^1.6.2",
    "axios-retry": "^4.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "did-jwt": "^7.4.5",
    "ethers": "^5.7.2",
    "joi": "^17.11.0",
    "nest-winston": "^1.9.4",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "winston": "^3.11.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.2.10",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@stoplight/spectral-cli": "^6.11.0",
    "@swc/core": "^1.3.100",
    "@tsconfig/node20": "^20.1.2",
    "@tsconfig/strictest": "^2.0.2",
    "@types/k6": "^0.48.0",
    "@types/node": "^20.10.4",
    "@types/passport-http-bearer": "^1.0.41",
    "@types/supertest": "^2.0.16",
    "@vitest/coverage-v8": "^0.34.6",
    "hardhat": "^2.19.2",
    "jose": "^4.15.4",
    "msw": "^2.0.10",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.1",
    "typescript": "5.2.2",
    "unplugin-swc": "^1.4.4",
    "vitest": "^0.34.6",
    "vitest-sonar-reporter": "^0.5.0"
  }
}
