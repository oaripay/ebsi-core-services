{
  "name": "@ebsiint-api/did-registry-api-v5",
  "private": true,
  "version": "5.0.0-rc.2",
  "type": "module",
  "license": "EUPL-1.2",
  "scripts": {
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/did-registry-api-v5:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .js,.cjs,.ts",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:prettier": "prettier . --check",
    "lint:tsc": "tsc --noEmit --incremental false",
    "prebuild": "rimraf dist",
    "start": "nest start -p tsconfig.dev.json",
    "start:dev": "yarn start --watch",
    "start:debug": "yarn start:dev --debug",
    "start:prod": "node dist/main",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --run",
    "test:e2e": "vitest --run -c vitest.config.e2e.ts",
    "test:ci": "yarn test:unit --coverage --reporter=default --reporter=vitest-sonar-reporter"
  },
  "dependencies": {
    "@cef-ebsi/oauth2-auth": "^3.0.0",
    "@ebsiint-api/shared": "^1.1.0-rc.6",
    "@ebsiint-sc/did-registry-v3": "^3.0.0-rc.2",
    "@ethersproject/address": "^5.7.0",
    "@ethersproject/bignumber": "^5.7.0",
    "@fastify/helmet": "^11.1.1",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/cache-manager": "^2.2.1",
    "@nestjs/common": "^10.3.3",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.3",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-fastify": "^10.3.3",
    "@nestjs/terminus": "^10.2.2",
    "async-mutex": "^0.4.1",
    "axios": "^1.6.7",
    "axios-retry": "^4.0.0",
    "cache-manager": "^5.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "elliptic": "^6.5.4",
    "ethers": "^5.7.2",
    "joi": "^17.12.1",
    "jose": "^4.15.4",
    "nest-winston": "^1.9.4",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "winston": "^3.11.0",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cef-ebsi/verifiable-credential": "^5.2.0",
    "@cef-ebsi/verifiable-presentation": "^6.2.0",
    "@cef-ebsi/wallet-lib": "^5.0.0",
    "@ethersproject/abstract-provider": "^5.7.0",
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.3",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@stoplight/spectral-cli": "^6.11.0",
    "@swc/core": "^1.4.1",
    "@total-typescript/ts-reset": "^0.5.1",
    "@tsconfig/node20": "^20.1.2",
    "@tsconfig/strictest": "^2.0.3",
    "@types/elliptic": "^6.4.18",
    "@types/k6": "^0.49.0",
    "@types/node": "^20.11.19",
    "@types/passport-http-bearer": "^1.0.41",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.2.2",
    "did-resolver": "^4.1.0",
    "hardhat": "^2.20.1",
    "msw": "^2.2.0",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "5.3.3",
    "unplugin-swc": "^1.4.4",
    "vitest": "^1.2.2",
    "vitest-sonar-reporter": "^1.0.0"
  }
}
