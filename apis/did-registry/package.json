{
  "name": "@ebsiint-api/did-registry-api-v3",
  "private": true,
  "version": "3.0.0-rc.6",
  "license": "EUPL-1.2",
  "scripts": {
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/did-registry-api-v3:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:prettier": "prettier . --check",
    "lint:tsc": "tsc --noEmit --incremental false",
    "prebuild": "rimraf dist",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar",
    "test:e2e": "jest --testPathPattern=tests/e2e --runInBand --verbose",
    "test:unit": "jest --testPathIgnorePatterns=e2e --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@cef-ebsi/oauth2-auth": "^2.3.0",
    "@cef-ebsi/siop-auth": "^3.1.0",
    "@ebsiint-api/shared": "^1.1.0-rc.3",
    "@ebsiint-sc/did-registry": "^1.1.0-rc.3",
    "@fastify/helmet": "^10.1.1",
    "@nestjs/axios": "^2.0.0",
    "@nestjs/common": "^9.4.0",
    "@nestjs/config": "^2.3.1",
    "@nestjs/core": "^9.4.0",
    "@nestjs/passport": "^9.0.3",
    "@nestjs/platform-fastify": "^9.4.0",
    "@nestjs/terminus": "9.2.2",
    "async-mutex": "^0.4.0",
    "axios": "^1.4.0",
    "axios-retry": "^3.5.0",
    "canonicalize": "^1.0.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "did-jwt": "^6.11.5",
    "ethers": "^5.7.2",
    "joi": "^17.9.2",
    "multihashes": "^4.0.3",
    "nest-winston": "^1.9.3",
    "passport": "^0.6.0",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "winston": "^3.9.0",
    "yaml": "^2.3.1"
  },
  "devDependencies": {
    "@cef-ebsi/verifiable-credential": "^4.4.2",
    "@cef-ebsi/verifiable-presentation": "^5.3.2",
    "@cef-ebsi/wallet-lib": "^4.1.0",
    "@ethersproject/abstract-provider": "^5.7.0",
    "@jest/globals": "^29.5.0",
    "@nestjs/cli": "^9.4.2",
    "@nestjs/schematics": "^9.1.0",
    "@nestjs/testing": "^9.4.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@stoplight/spectral-cli": "^6.8.0",
    "@tsconfig/node16": "^1.0.4",
    "@types/k6": "^0.45.0",
    "@types/node": "^16.18.11",
    "@types/passport-http-bearer": "^1.0.37",
    "@types/supertest": "^2.0.12",
    "did-resolver": "^4.1.0",
    "hardhat": "^2.16.0",
    "jest": "^29.5.0",
    "jest-sonar": "^0.2.16",
    "jose": "^4.14.4",
    "nock": "^13.3.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "4.9.5"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
