{
  "name": "@ebsiint-api/track-and-trace-api-v1",
  "private": true,
  "version": "1.0.0-rc.7",
  "type": "module",
  "license": "EUPL-1.2",
  "scripts": {
    "clean": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/track-and-trace-api-v1:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "prepare": "yarn clean",
    "start": "nest start -p tsconfig.dev.json",
    "start:dev": "yarn start --watch",
    "start:debug": "yarn start:dev --debug",
    "start:prod": "node dist/main",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:eslint": "eslint .",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --run",
    "test:e2e": "vitest --run -c vitest.config.e2e.ts",
    "test:ci": "yarn test:unit --coverage --reporter=default"
  },
  "dependencies": {
    "@cef-ebsi/ebsi-did-resolver": "^4.0.6",
    "@cef-ebsi/ebsi-uri": "^1.0.1",
    "@cef-ebsi/key-did-resolver": "^2.1.1",
    "@ebsiint-api/shared": "^1.1.0-rc.13",
    "@ebsiint-sc/track-and-trace": "1.0.0-rc.6",
    "@fastify/accepts": "^5.0.2",
    "@fastify/helmet": "^13.0.1",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.3",
    "@nestjs/terminus": "^11.0.0",
    "axios": "^1.10.0",
    "axios-retry": "^4.5.0",
    "cache-manager": "^6.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "did-resolver": "^4.1.0",
    "ethers": "^6.14.4",
    "joi": "^17.13.3",
    "jose": "^5.10.0",
    "keyv": "^5.3.4",
    "nestjs-pino": "^4.4.0",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "safe-stable-stringify": "^2.5.0",
    "validator": "^13.15.15",
    "yaml": "^2.8.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@cef-ebsi/verifiable-credential": "^7.1.0",
    "@cef-ebsi/verifiable-presentation": "^8.0.1",
    "@cef-ebsi/wallet-lib": "^6.0.1",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@nomicfoundation/hardhat-ethers": "^3.0.9",
    "@openzeppelin/hardhat-upgrades": "^3.9.0",
    "@stoplight/spectral-cli": "^6.15.0",
    "@swc/core": "^1.12.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/node22": "^22.0.2",
    "@tsconfig/strictest": "^2.0.5",
    "@types/k6": "^1.0.2",
    "@types/node": "^22.15.32",
    "@types/passport-http-bearer": "^1.0.41",
    "@types/supertest": "^6.0.3",
    "@types/validator": "^13.15.1",
    "@vitest/coverage-v8": "^3.2.4",
    "did-jwt": "^8.0.17",
    "hardhat": "^2.24.3",
    "msw": "^2.10.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3",
    "unplugin-swc": "^1.5.4",
    "vitest": "^3.2.4"
  }
}
