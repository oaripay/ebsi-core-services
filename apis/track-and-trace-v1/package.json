{
  "name": "@ebsiint-api/track-and-trace-api-v1",
  "private": true,
  "version": "1.0.0-rc.4",
  "type": "module",
  "license": "EUPL-1.2",
  "scripts": {
    "clean": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/track-and-trace-api-v1:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "prepare": "yarn clean",
    "start": "nest start -p tsconfig.dev.json",
    "start:dev": "yarn start --watch",
    "start:debug": "yarn start:dev --debug",
    "start:prod": "node dist/main",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:eslint": "eslint .",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --run",
    "test:e2e": "vitest --run -c vitest.config.e2e.ts",
    "test:ci": "yarn test:unit --coverage --reporter=default"
  },
  "dependencies": {
    "@cef-ebsi/ebsi-did-resolver": "^4.0.5",
    "@cef-ebsi/ebsi-uri": "^1.0.0",
    "@cef-ebsi/key-did-resolver": "^2.1.0",
    "@ebsiint-api/shared": "^1.1.0-rc.10",
    "@ebsiint-sc/track-and-trace": "1.0.0-rc.3",
    "@fastify/accepts": "^4.3.0",
    "@fastify/helmet": "^11.1.1",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/terminus": "^10.3.0",
    "axios": "^1.7.9",
    "axios-retry": "^4.5.0",
    "cache-manager": "^5.7.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "did-resolver": "^4.1.0",
    "ethers": "^6.13.5",
    "joi": "^17.13.3",
    "jose": "^4.15.5",
    "nest-winston": "^1.10.2",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.2.2",
    "safe-stable-stringify": "^2.5.0",
    "validator": "^13.12.0",
    "winston": "^3.17.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cef-ebsi/verifiable-credential": "^7.0.0",
    "@cef-ebsi/verifiable-presentation": "^8.0.0",
    "@cef-ebsi/wallet-lib": "^6.0.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@openzeppelin/hardhat-upgrades": "^3.9.0",
    "@stoplight/spectral-cli": "^6.14.2",
    "@swc/core": "^1.10.11",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/node22": "^22.0.0",
    "@tsconfig/strictest": "^2.0.5",
    "@types/k6": "^0.54.2",
    "@types/node": "^22.12.0",
    "@types/passport-http-bearer": "^1.0.41",
    "@types/supertest": "^6.0.2",
    "@types/validator": "^13.12.2",
    "@vitest/coverage-v8": "^3.0.4",
    "did-jwt": "^8.0.8",
    "hardhat": "^2.22.18",
    "msw": "^2.7.0",
    "rxjs": "^7.8.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.4"
  }
}
