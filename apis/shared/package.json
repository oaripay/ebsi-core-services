{
  "name": "@ebsiint-api/shared",
  "private": true,
  "version": "1.1.0-rc.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "EUPL-1.2",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "lint": "yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^10.1.0",
    "@cef-ebsi/ebsi-did-resolver": "^3.1.0",
    "@cef-ebsi/key-did-resolver": "^1.1.0",
    "@cef-ebsi/verifiable-credential": "^4.3.0",
    "@nestjs/common": "^9.4.0",
    "axios": "^1.4.0",
    "canonicalize": "^1.0.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "did-resolver": "^4.1.0",
    "elliptic": "^6.5.4",
    "joi": "^17.9.2",
    "jose": "^4.14.4",
    "key-encoder": "^2.0.3",
    "lodash.clonedeep": "^4.5.0",
    "multiformats": "^9.7.1",
    "multihashes": "^4.0.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.5.0",
    "@nestjs/cli": "^9.4.2",
    "@nestjs/schematics": "^9.0.4",
    "@tsconfig/node16": "^1.0.3",
    "@types/elliptic": "^6.4.14",
    "@types/lodash.clonedeep": "^4.5.7",
    "@types/node": "^16.18.11",
    "jest": "^29.5.0",
    "jest-sonar": "^0.2.16",
    "nock": "^13.3.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "4.9.5"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
