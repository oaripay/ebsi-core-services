  "devDependencies": {
    "@nestjs/cli": "^10.2.0",
    "@nestjs/schematics": "^10.0.2",
    "@tsconfig/node20": "^20.1.2",
    "@tsconfig/strictest": "^2.0.2",
    "@types/elliptic": "^6.4.16",
    "@types/lodash.clonedeep": "^4.5.8",
    "@types/node": "^20.8.9",
    "@vitest/coverage-v8": "^0.34.6",
    "eslint-plugin-vitest": "^0.3.8",
    "msw": "^2.0.0",
    "ts-node": "^10.9.1",
    "typescript": "5.2.2",
    "vitest": "^0.34.6",
    "vitest-sonar-reporter": "^0.4.1"
  }
