{
  "name": "@ebsiint-api/shared",
  "private": true,
  "version": "1.1.0-rc.4",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "EUPL-1.2",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "lint": "yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .js,.cjs,.ts",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --run",
    "test:ci": "yarn test:unit --coverage --reporter=default --reporter=vitest-sonar-reporter"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.1.0",
    "@cef-ebsi/ebsi-did-resolver": "^4.0.0-alpha.2",
    "@cef-ebsi/key-did-resolver": "^2.0.0-alpha.2",
    "@cef-ebsi/key-encoder": "^1.0.0-alpha.2",
    "@cef-ebsi/verifiable-credential": "^5.0.0-alpha.4",
    "@ethersproject/abstract-provider": "^5.7.0",
    "@nestjs/common": "^10.2.7",
    "axios": "^1.6.0",
    "canonicalize": "^2.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "did-resolver": "^4.1.0",
    "elliptic": "^6.5.4",
    "ethers": "^5.7.2",
    "joi": "^17.11.0",
    "jose": "^4.15.4",
    "lodash.clonedeep": "^4.5.0",
    "multiformats": "^12.1.3",
    "multihashes": "^4.0.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
