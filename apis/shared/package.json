    "@nestjs/testing": "^9.2.1",
    "@tsconfig/node16": "^1.0.3",
    "@types/elliptic": "^6.4.14",
    "@types/lodash.clonedeep": "^4.5.7",
    "@types/node": "^16.18.11",
    "@types/supertest": "^2.0.12",
    "jest": "^29.3.1",
    "jest-sonar": "^0.2.15",
    "nock": "^13.2.9",
