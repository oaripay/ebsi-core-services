{
  "name": "@ebsiint-api/storage-api-v3",
  "private": true,
  "version": "3.0.0-rc.6",
  "type": "module",
  "license": "EUPL-1.2",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/storage-api-v3:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "configure:cassandra": "yarn configure:cassandra:keyspace && yarn configure:cassandra:tables",
    "configure:cassandra:keyspace": "yarn dotenv -c test ./scripts/createKeyspace.sh",
    "configure:cassandra:tables": "yarn dotenv -c test ./scripts/createTables.sh",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:eslint": "eslint . --ext .js,.cjs,.ts",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --run",
    "test:e2e": "vitest --run -c vitest.config.e2e.ts",
    "test:ci": "yarn test:unit --coverage --reporter=default --reporter=vitest-sonar-reporter"
  },
  "dependencies": {
    "@cef-ebsi/oauth2-auth": "^3.0.0-alpha.4",
    "@cef-ebsi/siop-auth": "^4.0.0-alpha.4",
    "@ebsiint-api/shared": "^1.1.0-rc.3",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.0.0",
    "@nestjs/axios": "^3.0.1",
    "@nestjs/common": "^10.2.7",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.2.7",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-fastify": "^10.2.7",
    "@nestjs/terminus": "10.1.1",
    "axios": "^1.6.0",
    "cassandra-driver": "^4.7.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "did-jwt": "^7.4.4",
    "fast-json-patch": "^3.1.1",
    "joi": "^17.11.0",
    "nest-winston": "^1.9.4",
    "passport": "^0.6.0",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "winston": "^3.11.0",
    "yaml": "^2.3.3"
  },
  "devDependencies": {
    "@cef-ebsi/key-encoder": "^1.0.0-alpha.3",
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.2.7",
    "@stoplight/spectral-cli": "^6.11.0",
    "@swc/core": "^1.3.95",
    "@tsconfig/node20": "^20.1.2",
    "@tsconfig/strictest": "^2.0.2",
    "@types/busboy": "^1.5.2",
    "@types/elliptic": "^6.4.16",
    "@types/k6": "^0.47.1",
    "@types/node": "^20.8.9",
    "@types/passport-http-bearer": "^1.0.39",
    "@types/supertest": "^2.0.15",
    "@vitest/coverage-v8": "^0.34.6",
    "dotenv-cli": "^7.3.0",
    "elliptic": "^6.5.4",
    "jose": "^4.15.4",
    "msw": "^2.0.2",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.1",
    "typescript": "5.2.2",
    "unplugin-swc": "^1.4.3",
    "vitest": "^0.34.6",
    "vitest-sonar-reporter": "^0.4.1"
  }
}
