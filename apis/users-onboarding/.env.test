# Override .env settings for testing
# E.g. make sure all the tests run in "test" env
# You can override these settings by creating a new file called .env.test.local
DOMAIN=https://api.test.intebsi.xyz

# For e2e tests
EU_LOGIN_VALIDATE_SERVICE_URL=https://ecas.ec.europa.eu/cas/TicketValidationService
EU_LOGIN_SERVICE_PARAM=https://app.test.intebsi.xyz/users-onboarding/v2/authentication

# TODO: replace generic app with node-specific one
API_NAME=users-onboarding-api
API_VERIFICATION_METHOD_KID="did:ebsi:zwC56DZdiJh8kSxbgg4fMCu#keys-1"
# API_NAME=users-onboarding-api_test-03
# API_VERIFICATION_METHOD_KID="did:ebsi:ztNgQ4aGa5kihMqs6fYMR6t#keys-1"

AUTHORISATION_CREDENTIAL_SCHEMA=z3MgUFUkb722uq4x3dv5yAJmnNmzDFeK5UC8x83QoeLJM
RECAPTCHA_API_KEY=test

# A secp256k1 elliptic curve private key for the user
# TEST_USER_PRIVATE_KEY=

# DID, as registered in the DID Registry for the user
# TEST_USER_KID=

# EU Login test user
# TEST_EU_LOGIN_USERNAME=
# TEST_EU_LOGIN_PASSWORD=

# reCAPTCHA token
# TEST_RECAPTCHA_TOKEN=

# Env for e2e tests. Switch to remote API instance with `TEST_ENV=remote`
# TEST_ENV=

# Load balancer domain. Useful if you want to test a specific node and this node uses the LB's domain to sign JWTs.
# Example: DOMAIN=https://aio01-0-ebsi-test-lux.ebsi.eu and TEST_LB_DOMAIN=https://api.test.intebsi.xyz
# TEST_LB_DOMAIN=
