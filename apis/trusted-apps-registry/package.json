{
  "name": "@ebsiint-api/trusted-apps-registry-api-v3",
  "private": true,
  "version": "3.0.0-rc.3",
  "license": "EUPL-1.2",
  "scripts": {
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/trusted-apps-registry-api-v3:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:prettier": "prettier . --check",
    "lint:tsc": "tsc --noEmit --incremental false",
    "prebuild": "rimraf dist",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar",
    "test:e2e": "jest --testPathPattern=tests/e2e --runInBand --verbose",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@cef-ebsi/siop-auth": "^3.0.0-alpha.4",
    "@ebsiint-api/shared": "^1.1.0-rc.0",
    "@ebsiint-sc/bootstrap": "^1.0.1-rc.0",
    "@ebsiint-sc/trusted-apps-registry": "^2.0.1-rc.0",
    "@fastify/helmet": "^10.1.0",
    "@nestjs/axios": "^2.0.0",
    "@nestjs/common": "^9.3.9",
    "@nestjs/config": "^2.3.1",
    "@nestjs/core": "^9.3.9",
    "@nestjs/passport": "^9.0.3",
    "@nestjs/platform-fastify": "^9.3.9",
    "@nestjs/terminus": "^9.2.1",
    "axios": "^1.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "did-jwt": "^6.11.1",
    "ethers": "^5.7.2",
    "joi": "^17.8.3",
    "jose": "^4.13.0",
    "nest-winston": "^1.9.0",
    "passport": "^0.6.0",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "winston": "^3.8.1"
  },
  "devDependencies": {
    "@cef-ebsi/wallet-lib": "^4.0.0-alpha.4",
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/abstract-provider": "^5.7.0",
    "@ethersproject/bytes": "^5.7.0",
    "@ethersproject/providers": "^5.7.0",
    "@jest/globals": "^29.4.3",
    "@nestjs/cli": "^9.2.0",
    "@nestjs/schematics": "^9.0.4",
    "@nestjs/testing": "^9.3.9",
    "@nomiclabs/hardhat-ethers": "^2.2.2",
    "@openzeppelin/contracts": "^4.8.1",
    "@stoplight/spectral-cli": "^6.6.0",
    "@tsconfig/node16": "^1.0.3",
    "@typechain/ethers-v5": "^10.2.0",
    "@typechain/hardhat": "^6.1.5",
    "@types/k6": "^0.43.0",
    "@types/node": "^16.18.11",
    "@types/passport-http-bearer": "^1.0.37",
    "@types/supertest": "^2.0.12",
    "@types/ws": "^8.5.4",
    "hardhat": "^2.12.7",
    "jest": "^29.4.3",
    "jest-sonar": "^0.2.15",
    "nock": "^13.3.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "typechain": "^8.1.1",
    "typescript": "4.9.5"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
