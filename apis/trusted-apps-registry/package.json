{
  "name": "@ebsiint-api/trusted-apps-registry",
  "private": true,
  "version": "3.0.0-rc.1",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate --skip-dev",
    "build": "nest build -p tsconfig.production.json",
    "clean": "rimraf cache",
    "clinic:doctor": "yarn build && clinic doctor -- node dist/main",
    "clinic:bubbleprof": "yarn build && clinic bubbleprof -- node dist/main",
    "clinic:flame": "yarn build && clinic flame -- node dist/main",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:prettier": "prettier . --check",
    "lint:tsc": "tsc --noEmit --incremental false",
    "prebuild": "rimraf dist",
    "release": "standard-version",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar",
    "test:e2e": "jest --testPathPattern=tests/e2e --runInBand",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@ebsiint-sc/trusted-apps-registry": "file:../../contracts/trusted-apps-registry",
    "@cef-ebsi/ebsi-did-resolver": "^2.0.1",
    "@cef-ebsi/problem-details-errors": "^2.0.0",
    "@cef-ebsi/siop-auth": "^2.0.0",
    "@fastify/helmet": "^8.1.0",
    "@nestjs/axios": "^0.0.8",
    "@nestjs/common": "^8.4.6",
    "@nestjs/config": "^2.1.0",
    "@nestjs/core": "^8.4.6",
    "@nestjs/passport": "^8.2.1",
    "@nestjs/platform-fastify": "^8.4.6",
    "@nestjs/terminus": "^8.0.6",
    "axios": "^0.27.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "did-jwt": "^6.1.0",
    "ethers": "^5.6.9",
    "fastify": "3.29.0",
    "joi": "^17.6.0",
    "jose": "^4.8.1",
    "multiformats": "^9.6.5",
    "nest-winston": "^1.6.2",
    "passport": "^0.6.0",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.12",
    "rxjs": "^7.5.5",
    "winston": "^3.7.2",
    "yaml": "^2.1.1"
  },
  "devDependencies": {
    "@ebsiint-sc/bootstrap": "file:../../contracts/bootstrap",
    "@cef-ebsi/wallet-lib": "^2.0.0",
    "@ethersproject/abi": "^5.4.7",
    "@ethersproject/bytes": "^5.4.7",
    "@ethersproject/providers": "^5.4.7",
    "@ethersproject/abstract-provider": "^5.6.1",
    "@jest/globals": "^28.1.3",
    "@nestjs/cli": "^8.2.6",
    "@nestjs/schematics": "^8.0.11",
    "@nestjs/testing": "^8.4.6",
    "@nomiclabs/hardhat-ethers": "^2.0.6",
    "@tsconfig/node16": "^1.0.2",
    "@types/jest": "^28.1.0",
    "@types/k6": "^0.37.0",
    "@types/node": "^16.11.12",
    "@types/passport-http-bearer": "^1.0.37",
    "@types/supertest": "^2.0.12",
    "@types/ws": "^8.5.3",
    "@typescript-eslint/eslint-plugin": "^5.32.0",
    "@typescript-eslint/parser": "^5.32.0",
    "audit-ci": "^6.3.0",
    "clinic": "^11.1.0",
    "eslint": "^8.21.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^26.4.6",
    "eslint-plugin-prettier": "^4.2.1",
    "hardhat": "^2.9.9",
    "jest": "^28.1.0",
    "jest-sonar": "^0.2.11",
    "nock": "^13.2.4",
    "prettier": "^2.6.2",
    "rimraf": "^3.0.2",
    "standard-version": "^9.5.0",
    "supertest": "^6.2.3",
    "ts-jest": "^28.0.4",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.0.0",
    "typescript": "4.7.4"
  },
  "nx": {
    "namedInputs": {
      "default": [
        "{projectRoot}/src",
        "{projectRoot}/api"
      ],
      "prod": [
        "!{projectRoot}/tests/**/*.ts"
      ]
    },
    "targets": {
      "build": {
        "inputs": [
          "prod",
          "^prod"
        ],
        "outputs": [
          "dist"
        ],
        "dependsOn": [
          "^build"
        ]
      },
      "lint": {
        "inputs": [
          "default"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^prod"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      },
      "test:ci": {
        "inputs": [
          "default",
          "^prod"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
