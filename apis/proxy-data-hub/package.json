{
  "name": "@ebsiint-api/proxy-data-hub-api-v3",
  "private": true,
  "version": "3.0.0-rc.2",
  "license": "EUPL-1.2",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/proxy-data-hub-api-v3:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=tests/e2e --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar"
  },
  "dependencies": {
    "@cef-ebsi/oauth2-auth": "^2.2.0",
    "@cef-ebsi/problem-details-errors": "^2.1.0",
    "@cef-ebsi/siop-auth": "^2.2.0",
    "@ebsiint-api/shared": "^1.0.0",
    "@fastify/helmet": "^10.1.0",
    "@nestjs/axios": "^1.0.0",
    "@nestjs/common": "^9.2.1",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^9.2.1",
    "@nestjs/platform-fastify": "^9.2.1",
    "@nestjs/terminus": "9.1.4",
    "axios": "1.1.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "did-jwt": "^6.10.1",
    "fast-json-patch": "^3.1.1",
    "joi": "^17.7.0",
    "multiformats": "^9.7.1",
    "multihashes": "^4.0.3",
    "nest-winston": "^1.8.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.5.7",
    "winston": "^3.8.1"
  },
  "devDependencies": {
    "@cef-ebsi/wallet-lib": "^3.1.0",
    "@commitlint/cli": "^17.3.0",
    "@commitlint/config-conventional": "^17.3.0",
    "@jest/globals": "^28.1.3",
    "@nestjs/cli": "^9.1.5",
    "@nestjs/schematics": "^9.0.1",
    "@nestjs/testing": "^9.2.1",
    "@stoplight/spectral-cli": "^6.6.0",
    "@tsconfig/node16": "^1.0.3",
    "@types/jest": "^28.1.6",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/k6": "^0.41.0",
    "@types/node": "^16.18.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^27.1.6",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^28.1.3",
    "jest-sonar": "^0.2.12",
    "jose": "^4.11.1",
    "jsonwebtoken": "^8.5.1",
    "nock": "^13.2.9",
    "supertest": "^6.3.1",
    "ts-jest": "^28.0.8",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.0.0",
    "typescript": "4.8.4"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
