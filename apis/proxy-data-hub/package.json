{
  "name": "@ebsiint-api/proxy-data-hub-api-v3",
  "private": true,
  "version": "3.0.0-rc.4",
  "license": "EUPL-1.2",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/proxy-data-hub-api-v3:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=tests/e2e --runInBand --verbose",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar"
  },
  "dependencies": {
    "@cef-ebsi/oauth2-auth": "^2.2.2",
    "@cef-ebsi/siop-auth": "^3.0.0",
    "@ebsiint-api/shared": "^1.1.0-rc.1",
    "@fastify/helmet": "^10.1.0",
    "@nestjs/axios": "^2.0.0",
    "@nestjs/common": "^9.3.10",
    "@nestjs/config": "^2.3.1",
    "@nestjs/core": "^9.3.10",
    "@nestjs/platform-fastify": "^9.3.10",
    "@nestjs/terminus": "9.2.1",
    "axios": "^1.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "did-jwt": "^6.11.5",
    "fast-json-patch": "^3.1.1",
    "joi": "^17.9.0",
    "multiformats": "^9.7.1",
    "nest-winston": "^1.9.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "winston": "^3.8.1"
  },
  "devDependencies": {
    "@cef-ebsi/wallet-lib": "^4.0.0",
    "@jest/globals": "^29.5.0",
    "@nestjs/cli": "^9.3.0",
    "@nestjs/schematics": "^9.0.4",
    "@nestjs/testing": "^9.3.10",
    "@stoplight/spectral-cli": "^6.6.0",
    "@tsconfig/node16": "^1.0.3",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/k6": "^0.43.2",
    "@types/node": "^16.18.11",
    "@types/supertest": "^2.0.12",
    "jest": "^29.5.0",
    "jest-sonar": "^0.2.15",
    "jose": "^4.13.1",
    "jsonwebtoken": "^9.0.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "typescript": "4.9.5"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
