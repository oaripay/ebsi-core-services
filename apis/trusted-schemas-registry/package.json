{
  "name": "@ebsiint-api/trusted-schemas-registry-api-v2",
  "private": true,
  "version": "2.0.0-rc.11",
  "type": "module",
  "license": "EUPL-1.2",
  "scripts": {
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/trusted-schemas-registry-api-v2:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint .",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:prettier": "prettier . --check",
    "lint:tsc": "tsc --noEmit --incremental false",
    "prebuild": "rimraf dist",
    "prepare": "exit 0",
    "start": "nest start -p tsconfig.dev.json",
    "start:dev": "yarn start --watch",
    "start:debug": "yarn start:dev --debug",
    "start:prod": "node dist/main",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --run",
    "test:e2e": "vitest --run -c vitest.config.e2e.ts",
    "test:ci": "yarn test:unit --coverage --reporter=default"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.7.2",
    "@ebsiint-api/shared": "^1.1.0-rc.10",
    "@ebsiint-sc/trusted-schemas-registry": "^1.0.1-rc.8",
    "@fastify/accepts": "^4.3.0",
    "@fastify/helmet": "^11.1.1",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/common": "^10.4.13",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.13",
    "@nestjs/platform-fastify": "^10.4.13",
    "@nestjs/terminus": "^10.2.3",
    "axios": "^1.7.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ethers": "^5.7.2",
    "joi": "^17.13.3",
    "multiformats": "^9.6.2",
    "nest-winston": "^1.9.7",
    "p-limit": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "safe-stable-stringify": "^2.5.0",
    "winston": "^3.17.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@cef-ebsi/wallet-lib": "^6.0.0-alpha.2",
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.13",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@stoplight/spectral-cli": "^6.14.2",
    "@swc/core": "^1.10.0",
    "@tsconfig/node22": "^22.0.0",
    "@tsconfig/strictest": "^2.0.5",
    "@types/k6": "^0.54.2",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^7.4.7",
    "@vitest/coverage-v8": "^2.1.8",
    "hardhat": "^2.22.17",
    "msw": "^2.6.6",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
