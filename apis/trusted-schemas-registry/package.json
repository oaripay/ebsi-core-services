{
  "name": "@ebsiint-api/trusted-schemas-registry-api-v2",
  "private": true,
  "version": "2.0.0-rc.5",
  "license": "EUPL-1.2",
  "scripts": {
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/trusted-schemas-registry-api-v2:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .js,.ts",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:prettier": "prettier . --check",
    "lint:tsc": "tsc --noEmit --incremental false",
    "prebuild": "rimraf dist",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar",
    "test:e2e": "jest --testPathPattern=tests/e2e --runInBand --verbose",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^10.1.0",
    "@cef-ebsi/oauth2-auth": "^2.3.0",
    "@cef-ebsi/siop-auth": "^3.1.0",
    "@ebsiint-api/shared": "^1.1.0-rc.2",
    "@ebsiint-sc/trusted-schemas-registry": "^1.0.1-rc.2",
    "@fastify/helmet": "^10.1.1",
    "@nestjs/axios": "^2.0.0",
    "@nestjs/common": "^9.4.0",
    "@nestjs/config": "^2.3.1",
    "@nestjs/core": "^9.4.0",
    "@nestjs/passport": "^9.0.3",
    "@nestjs/platform-fastify": "^9.4.0",
    "@nestjs/terminus": "^9.2.2",
    "async-mutex": "^0.4.0",
    "axios": "^1.4.0",
    "axios-retry": "^3.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "did-jwt": "^6.11.5",
    "ethers": "^5.7.2",
    "joi": "^17.9.2",
    "jose": "^4.14.4",
    "multiformats": "^9.7.1",
    "nest-winston": "^1.9.3",
    "p-limit": "^3.1.0",
    "passport": "^0.6.0",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "winston": "^3.9.0",
    "yaml": "^2.3.1"
  },
  "devDependencies": {
    "@cef-ebsi/wallet-lib": "^4.1.0",
    "@ethersproject/abstract-provider": "^5.7.0",
    "@jest/globals": "^29.5.0",
    "@nestjs/cli": "^9.4.2",
    "@nestjs/schematics": "^9.0.4",
    "@nestjs/testing": "^9.4.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@stoplight/spectral-cli": "^6.8.0",
    "@tsconfig/node16": "^1.0.4",
    "@types/k6": "^0.45.0",
    "@types/node": "^16.18.11",
    "@types/passport-http-bearer": "^1.0.37",
    "@types/supertest": "^2.0.12",
    "hardhat": "^2.16.0",
    "jest": "^29.5.0",
    "jest-sonar": "^0.2.16",
    "nock": "^13.3.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "4.9.5"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
