# Override .env settings for testing
# E.g. make sure all the tests run in "test" env
# You can override these settings by creating a new file called .env.test.local
DOMAIN=https://api-test.ebsi.eu
CONTRACT_ADDR=0x82Fd4865F702E2b319f3B2f1E4FDE5836883aC5D
BESU_RPC_NODE=https://username:password@www-test.ebsi.eu/besu

# Test Clients
# Used for e2e tests
# TEST_USER_DID=
# TEST_USER_PRIVATE_KEY=
# This client must be registered in the DID Registry AND have the right attributes in TPR.
# TEST_ADMIN_DID=
# TEST_ADMIN_PRIVATE_KEY=

# Env for e2e tests. Switch to remote API instance with `TEST_ENV=remote`
# TEST_ENV=

# Set `TEST_ENABLE_WRITE_OPS=true` to enable write operations during the tests
# TEST_ENABLE_WRITE_OPS=

# Load balancer domain. Useful if you want to test a specific node and this node uses the LB's domain to sign JWTs.
# Example: DOMAIN=https://aio01-0-ebsi-test-lux.ebsi.eu and TEST_LB_DOMAIN=https://api-test.ebsi.eu
# TEST_LB_DOMAIN=

# Test Blockscout
# BLOCKSCOUT_URL=
# BLOCKSCOUT_BEARER_TOKEN=
