# Default settings for the app
# You can override these settings by creating a new file called .env.default.local

# Supported values: "local" | "test" | "conformance" | "pilot" | "prod"
EBSI_ENV=

# A secp256k1 elliptic curve private key in hexadecimal
API_PRIVATE_KEY=

# Node-specific API name, as registered in the Trusted Apps Registry
API_NAME=

# API URL prefix (default: "/notifications/v2")
# API_URL_PREFIX=

# Authorisation API URL
# Default value: depends on the environment, see src/config/configuration.ts
# AUTHORISATION_API_URL=

# Storage API name (default: storage-api)
# STORAGE_API_NAME=

# Storage API URL, e.g. "https://api.ebsi.xyz/storage/v3"
# Default value depends on EBSI_ENV
# STORAGE_API_URL=

# Trusted Apps Registry API URL
# Default value: depends on the environment, see src/config/configuration.ts
# TRUSTED_APPS_REGISTRY_API_URL=

# Port on which the server should listen
# Default value: 3000
# Warning: if you override this variable, make sure that docker-compose.yml opens the right port
# API_PORT=

# Supported values : "silent" | "error" | "warn" | "info" | "verbose" | "debug"
# Default value: depends on the environment, see src/config/configuration.ts
# "silent" turns the logger off
# LOG_LEVEL=

# DOMAIN's default value depends on the EBSI_ENV environment
# E.g. "https://api.intebsi.xyz"
# DOMAIN=

# Local API origin (Docker), e.g. "http://api.local"
# When defined, the API will first call this local API before querying the public API if the first request fails
# Default: empty string
# LOCAL_ORIGIN=

# Health check URLs
# Default values are provided src/config/configuration.ts
# HEALTH_CHECK=

# Secret passphrase used to encrypt/decrypt pageState (Cassandra)
ENCRYPTION_SECRET=

# Request timeout (number in milliseconds, default: 15000, i.e. 15s)
# Max amount of time a request **made by the API** can take before failing.
# REQUEST_TIMEOUT=
