{
  "name": "@ebsiint-api/authorisation-api-v3",
  "private": true,
  "version": "3.0.0-rc.0",
  "license": "EUPL-1.2",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/authorisation-api-v3:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=tests/e2e --runInBand --verbose",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar"
  },
  "dependencies": {
    "@cef-ebsi/verifiable-credential": "^4.0.0-alpha.6",
    "@cef-ebsi/verifiable-presentation": "^5.0.0-alpha.8",
    "@cef-ebsi/wallet-lib": "^4.0.0-alpha.4",
    "@ebsiint-api/shared": "^1.1.0-rc.0",
    "@fastify/formbody": "^7.4.0",
    "@fastify/helmet": "^10.1.0",
    "@nestjs/axios": "^2.0.0",
    "@nestjs/common": "^9.3.9",
    "@nestjs/config": "^2.3.1",
    "@nestjs/core": "^9.3.9",
    "@nestjs/platform-fastify": "^9.3.9",
    "@nestjs/terminus": "^9.2.1",
    "@sphereon/pex": "^1.1.5",
    "@sphereon/ssi-types": "^0.8.0",
    "axios": "^1.3.4",
    "cache-manager": "^5.1.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "did-jwt": "^6.11.1",
    "elliptic": "^6.5.4",
    "joi": "^17.8.3",
    "jose": "^4.13.0",
    "nest-winston": "^1.9.0",
    "qs": "^6.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "winston": "^3.8.1",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.4.3",
    "@nestjs/cli": "^9.2.0",
    "@nestjs/schematics": "^9.0.4",
    "@nestjs/testing": "^9.3.9",
    "@sphereon/pex-models": "^1.2.2",
    "@stoplight/spectral-cli": "^6.6.0",
    "@total-typescript/ts-reset": "^0.3.7",
    "@tsconfig/node16": "^1.0.3",
    "@types/elliptic": "^6.4.14",
    "@types/json-schema": "^7.0.11",
    "@types/k6": "^0.43.0",
    "@types/node": "^16.18.11",
    "@types/qs": "^6.9.7",
    "@types/supertest": "^2.0.12",
    "jest": "^29.4.3",
    "jest-sonar": "^0.2.15",
    "nock": "^13.3.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "typescript": "4.9.5"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
