{
  "name": "@ebsiint-api/authorisation-api-v3",
  "private": true,
  "version": "3.0.0-rc.10",
  "type": "module",
  "license": "EUPL-1.2",
  "scripts": {
    "clean": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/authorisation-api-v3:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "prepare": "yarn clean",
    "start": "nest start -p tsconfig.dev.json",
    "start:dev": "yarn start --watch",
    "start:debug": "yarn start:dev --debug",
    "start:prod": "node dist/main",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:eslint": "eslint .",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --run",
    "test:e2e": "vitest --run -c vitest.config.e2e.ts",
    "test:ci": "yarn test:unit --coverage --reporter=default"
  },
  "dependencies": {
    "@cef-ebsi/ebsi-uri": "^1.0.0-alpha.1",
    "@cef-ebsi/verifiable-credential": "^7.0.0-alpha.1",
    "@cef-ebsi/verifiable-presentation": "^8.0.0-alpha.1",
    "@cef-ebsi/wallet-lib": "^6.0.0-alpha.4",
    "@ebsiint-api/shared": "^1.1.0-rc.10",
    "@fastify/accepts": "^4.3.0",
    "@fastify/formbody": "^7.4.0",
    "@fastify/helmet": "^11.1.1",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/terminus": "^10.3.0",
    "@sphereon/pex": "~2.1.2",
    "axios": "^1.7.9",
    "cache-manager": "^5.7.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "did-jwt": "^8.0.8",
    "elliptic": "^6.5.5",
    "joi": "^17.13.3",
    "jose": "^4.15.5",
    "nest-winston": "^1.10.2",
    "qs": "^6.14.0",
    "reflect-metadata": "^0.2.2",
    "safe-stable-stringify": "^2.5.0",
    "winston": "^3.17.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cef-ebsi/vcdm1.1-attestation-schema": "^1.3.1",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@sphereon/pex-models": "2.1.2",
    "@sphereon/ssi-types": "^0.15.1",
    "@stoplight/spectral-cli": "^6.14.2",
    "@swc/core": "^1.10.11",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/node22": "^22.0.0",
    "@tsconfig/strictest": "^2.0.5",
    "@types/elliptic": "^6.4.18",
    "@types/json-schema": "^7.0.15",
    "@types/k6": "^0.54.2",
    "@types/node": "^22.12.0",
    "@types/qs": "^6.9.18",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.0.4",
    "did-resolver": "^4.1.0",
    "msw": "^2.7.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "type-fest": "^4.33.0",
    "typescript": "5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.4"
  }
}
