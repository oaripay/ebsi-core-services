{
  "name": "@ebsiint-api/trusted-ledgers-registry",
  "private": true,
  "version": "2.0.0-rc.1",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate --skip-dev",
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t trusted-ledgers-registry-api-v2",
    "docker:start": "docker-compose up",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:prettier": "prettier . --check",
    "lint:tsc": "tsc --noEmit --incremental false",
    "prebuild": "rimraf dist",
    "release": "standard-version",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar",
    "test:e2e": "jest --testPathPattern=tests/e2e --runInBand",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@ebsiint-sc/trusted-ledgers-registry": "^1.0.0",
    "@cef-ebsi/oauth2-auth": "2.1.1",
    "@cef-ebsi/problem-details-errors": "2.0.0",
    "@cef-ebsi/siop-auth": "2.1.0",
    "@fastify/helmet": "^9.1.0",
    "@nestjs/axios": "^0.1.0",
    "@nestjs/common": "^9.0.8",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^9.0.8",
    "@nestjs/passport": "^9.0.0",
    "@nestjs/platform-fastify": "^9.0.8",
    "@nestjs/terminus": "^9.1.0",
    "axios": "^0.27.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "did-jwt": "^6.2.1",
    "ethers": "^5.6.9",
    "@jest/globals": "^28.1.3",
    "joi": "^17.6.0",
    "nest-winston": "^1.7.0",
    "passport": "^0.6.0",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.5.6",
    "winston": "^3.8.1",
    "yaml": "^2.1.1"
  },
  "devDependencies": {
    "@ethersproject/abstract-provider": "^5.6.1",
    "@ethersproject/abi": "^5.4.7",
    "@ethersproject/bytes": "^5.4.7",
    "@ethersproject/providers": "^5.4.7",
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.1",
    "@nestjs/testing": "^9.0.8",
    "@nomiclabs/hardhat-ethers": "^2.1.0",
    "@openzeppelin/contracts": "^4.7.2",
    "@stoplight/spectral-cli": "^6.5.0",
    "@tsconfig/node16": "^1.0.3",
    "@typechain/ethers-v5": "^10.1.0",
    "@typechain/hardhat": "^6.1.2",
    "@types/jest": "^28.1.6",
    "@types/k6": "^0.37.1",
    "@types/node": "^16.11.12",
    "@types/passport-http-bearer": "^1.0.37",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.32.0",
    "@typescript-eslint/parser": "^5.32.0",
    "audit-ci": "^6.3.0",
    "eslint": "^8.21.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^26.7.0",
    "eslint-plugin-prettier": "^4.2.1",
    "hardhat": "^2.10.1",
    "jest": "^28.1.3",
    "jest-sonar": "^0.2.12",
    "jose": "^4.8.3",
    "nock": "^13.2.9",
    "supertest": "^6.2.4",
    "ts-jest": "^28.0.7",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.0.0",
    "typechain": "^8.1.0"
  },
  "nx": {
    "namedInputs": {
      "default": [
        "{projectRoot}/src",
        "{projectRoot}/api"
      ],
      "prod": [
        "!{projectRoot}/tests/**/*.ts"
      ]
    },
    "targets": {
      "build": {
        "inputs": [
          "prod",
          "^prod"
        ],
        "outputs": [
          "dist"
        ],
        "dependsOn": [
          "^build"
        ]
      },
      "lint": {
        "inputs": [
          "default"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^prod"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      },
      "test:ci": {
        "inputs": [
          "default",
          "^prod"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
