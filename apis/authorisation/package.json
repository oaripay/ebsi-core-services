{
  "name": "@ebsiint-api/authorisation-api-v2",
  "private": true,
  "version": "2.0.0-rc.9",
  "type": "module",
  "license": "EUPL-1.2",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/authorisation-api-v2:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "start": "nest start -p tsconfig.dev.json",
    "start:dev": "yarn start --watch",
    "start:debug": "yarn start:dev --debug",
    "start:prod": "node dist/main",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:eslint": "eslint . --ext .js,.cjs,.ts",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --run",
    "test:e2e": "vitest --run -c vitest.config.e2e.ts",
    "test:ci": "yarn test:unit --coverage --reporter=default --reporter=vitest-sonar-reporter"
  },
  "dependencies": {
    "@cef-ebsi/oauth2-auth": "^3.0.1-alpha.1",
    "@cef-ebsi/siop-auth": "^4.0.1-alpha.1",
    "@cef-ebsi/verifiable-credential": "^5.2.1-alpha.3",
    "@cef-ebsi/verifiable-presentation": "^6.2.1-alpha.3",
    "@ebsiint-api/shared": "^1.1.0-rc.6",
    "@fastify/helmet": "^11.1.1",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/common": "^10.3.3",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.3",
    "@nestjs/platform-fastify": "^10.3.3",
    "@nestjs/terminus": "^10.2.3",
    "axios": "^1.6.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "did-jwt": "^8.0.1",
    "joi": "^17.12.2",
    "jose": "^4.15.5",
    "multiformats": "^12.1.3",
    "nest-winston": "^1.9.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "winston": "^3.12.0",
    "yaml": "^2.4.1"
  },
  "devDependencies": {
    "@cef-ebsi/key-encoder": "^1.0.1-alpha.0",
    "@cef-ebsi/wallet-lib": "^5.0.1-alpha.2",
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.3",
    "@stoplight/spectral-cli": "^6.11.0",
    "@swc/core": "^1.4.6",
    "@total-typescript/ts-reset": "^0.5.1",
    "@tsconfig/node20": "^20.1.2",
    "@tsconfig/strictest": "^2.0.3",
    "@types/elliptic": "^6.4.18",
    "@types/k6": "^0.49.1",
    "@types/node": "^20.11.25",
    "@types/secp256k1": "^4.0.6",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.3.1",
    "did-resolver": "^4.1.0",
    "elliptic": "^6.5.5",
    "ethers": "^5.7.2",
    "msw": "^2.2.3",
    "secp256k1": "^5.0.0",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "5.3.3",
    "unplugin-swc": "^1.4.4",
    "vitest": "^1.3.1",
    "vitest-sonar-reporter": "^2.0.0"
  }
}
