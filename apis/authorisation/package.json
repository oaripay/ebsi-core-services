{
  "name": "@ebsiint-api/authorisation-api-v2",
  "private": true,
  "version": "2.0.0-rc.2",
  "license": "EUPL-1.2",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t ebsi/authorisation-api-v2:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=tests/e2e --runInBand --verbose",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar"
  },
  "dependencies": {
    "@cef-ebsi/oauth2-auth": "^2.2.2-alpha.2",
    "@cef-ebsi/siop-auth": "^3.0.0-alpha.2",
    "@cef-ebsi/verifiable-credential": "^4.0.0-alpha.1",
    "@cef-ebsi/verifiable-presentation": "^5.0.0-alpha.1",
    "@ebsiint-api/shared": "^1.0.0",
    "@fastify/helmet": "^10.1.0",
    "@nestjs/axios": "^1.0.1",
    "@nestjs/common": "^9.2.1",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^9.2.1",
    "@nestjs/platform-fastify": "^9.2.1",
    "@nestjs/terminus": "^9.1.4",
    "axios": "1.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "did-jwt": "^6.11.0",
    "joi": "^17.7.0",
    "jose": "^4.11.2",
    "multiformats": "^9.7.1",
    "nest-winston": "^1.8.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "winston": "^3.8.1"
  },
  "devDependencies": {
    "@cef-ebsi/wallet-lib": "^4.0.0-alpha.2",
    "@jest/globals": "^29.3.1",
    "@nestjs/cli": "^9.1.8",
    "@nestjs/schematics": "^9.0.4",
    "@nestjs/testing": "^9.2.1",
    "@stoplight/spectral-cli": "^6.6.0",
    "@tsconfig/node16": "^1.0.3",
    "@types/elliptic": "^6.4.14",
    "@types/k6": "^0.42.0",
    "@types/node": "^16.18.11",
    "@types/secp256k1": "^4.0.3",
    "@types/supertest": "^2.0.12",
    "did-resolver": "^4.0.1",
    "elliptic": "^6.5.4",
    "ethers": "^5.7.2",
    "jest": "^29.3.1",
    "jest-sonar": "^0.2.15",
    "key-encoder": "^2.0.3",
    "nock": "^13.3.0",
    "secp256k1": "^5.0.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "typescript": "4.9.4"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
