{
  "name": "@ebsiint-api/authorisation",
  "private": true,
  "version": "2.0.0-rc.1",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate --skip-dev -a GHSA-5fg8-2547-mr8q",
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "docker:build": "docker build . -t authorisation-api-v2",
    "docker:start": "docker-compose up",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "release": "standard-version",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=tests/e2e --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar"
  },
  "dependencies": {
    "@cef-ebsi/oauth2-auth": "^2.1.1",
    "@cef-ebsi/problem-details-errors": "2.0.0",
    "@cef-ebsi/siop-auth": "^2.1.0",
    "@cef-ebsi/verifiable-credential": "^2.1.0",
    "@cef-ebsi/verifiable-presentation": "^2.1.0",
    "@fastify/helmet": "^9.1.0",
    "@nestjs/axios": "^0.1.0",
    "@nestjs/common": "^9.0.8",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^9.0.8",
    "@nestjs/platform-fastify": "^9.0.8",
    "@nestjs/terminus": "^9.1.0",
    "axios": "^0.27.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "did-jwt": "^6.2.1",
    "joi": "^17.5.0",
    "jose": "^4.8.3",
    "multiformats": "^9.7.1",
    "nest-winston": "^1.7.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.5.6",
    "winston": "^3.8.1",
    "yaml": "^2.1.1"
  },
  "devDependencies": {
    "@cef-ebsi/wallet-lib": "^2.0.0",
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.1",
    "@nestjs/testing": "^9.0.8",
    "@stoplight/spectral-cli": "^6.5.0",
    "@tsconfig/node16": "^1.0.3",
    "@types/elliptic": "^6.4.14",
    "@types/jest": "28.1.6",
    "@types/k6": "^0.37.1",
    "@types/node": "^16.11.12",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.32.0",
    "@typescript-eslint/parser": "^5.32.0",
    "audit-ci": "^6.3.0",
    "did-resolver": "^3.2.2",
    "elliptic": "^6.5.4",
    "eslint": "^8.21.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^26.7.0",
    "eslint-plugin-prettier": "^4.2.1",
    "ethers": "^5.6.9",
    "jest": "^28.1.3",
    "jest-sonar": "^0.2.12",
    "key-encoder": "^2.0.3",
    "nock": "^13.2.9",
    "secp256k1": "^4.0.3",
    "supertest": "^6.2.4",
    "ts-jest": "^28.0.7",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "4.0.0"
  },
  "nx": {
    "namedInputs": {
      "default": [
        "{projectRoot}/src",
        "{projectRoot}/api"
      ],
      "prod": [
        "!{projectRoot}/tests/**/*.ts"
      ]
    },
    "targets": {
      "build": {
        "inputs": [
          "prod",
          "^prod"
        ],
        "outputs": [
          "dist"
        ],
        "dependsOn": [
          "^build"
        ]
      },
      "docker:start": {
        "inputs": [],
        "outputs": [],
        "dependsOn": [
          "docker:build"
        ]
      },
      "lint": {
        "inputs": [
          "default"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^prod"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      },
      "test:ci": {
        "inputs": [
          "default",
          "^prod"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
