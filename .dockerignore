# ignore .git and .cache folders
.git
.cache

# ignore node modules and local development
node_modules
docker-compose.*
Dockerfile
.dockerignore
.gitignore
.gitattributes
LICENSE
Jenkinsfile
.editorconfig

# env or secret files
.env
.secret

# Documentation
*.md
!README*.md
README-secret.md

# log files
logs
*.log
tmp/

# Runtime data
pids
*.pid
*.seed

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
