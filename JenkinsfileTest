pipeline {
  agent any

  stages {
    stage('Fetch main branch') {
      when {
        not {
          branch 'nx'
        }
      }
      steps {
        sh 'git fetch origin nx:nx'
      }
    }
    stage('Setup') {
      steps {
        nodejs(nodeJSInstallationName: '16.17.1') {
          sh 'yarn install --frozen-lockfile'
        }
      }
    }
    stage('Lint') {
      when {
        branch 'nx'
      }
      steps {
        nodejs(nodeJSInstallationName: '16.17.1') {
          sh "yarn lint:all"
        }
      }
    }
    stage('Build docker images') {
      when {
        branch 'nx'
      }
      steps {
        nodejs(nodeJSInstallationName: '16.17.1') {
          sh "yarn docker-build:all"
        }
      }
    }
