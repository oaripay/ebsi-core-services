pipeline {
    agent any
    environment {
        NODE_ENV='integration'
    }
    stages {
        stage('Clone repo') {
            steps {
               checkout scm;
            }
        }
        stage('Unit test') {
            steps {
                sh 'npm install'
                withCredentials([string(credentialsId: 'TEST_APP_PRIVATE_KEY', variable: 'WALLET_PRIV_KEY')]) {
                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                        sh 'npm run test:cov'
                    }
                }
            }
        }
        stage('SonarQube Analysis') {
            steps{
                sh "/var/lib/jenkins/tools/hudson.plugins.sonar.SonarRunnerInstallation/sonar-scanner/bin/sonar-scanner -Dsonar.host.url=https://infra.ebsi.xyz/sonar -Dsonar.projectName=4-ebsi-trusted-app-register-api -Dsonar.projectVersion=1.0 -Dsonar.projectKey=4-ebsi-trusted-app-register-api -Dsonar.sources=. -Dsonar.projectBaseDir=/var/lib/jenkins/workspace/4-ebsi-trusted-app-register-api"
            }
        }
    }
}
