pipeline {
    agent any
    environment {
        EBSI_ENV="integration"
        BESU_ADDRESS_NOTARY="0x3c5316F3223626f8D8Ea50Eed697F739c2778D3b"
    }
    stages {
        stage('Clone repo') {
            steps {
               checkout scm;
            }
        }
        stage('Unit test') {
            steps {
                dir('api/besu') {
                    sh 'npm install'
                    withCredentials([string(credentialsId: 'TEST_APP_PRIVATE_KEY', variable: 'API_LEDGER_PRIVATE_KEY')]) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            sh 'npm run test'
                        }
                    }
                }
            }
        }
        stage('SonarQube Analysis') {
            steps{
                sh "/var/lib/jenkins/tools/hudson.plugins.sonar.SonarRunnerInstallation/sonar-scanner/bin/sonar-scanner -Dsonar.host.url=https://infra.ebsi.xyz/sonar -Dsonar.projectName=ledger-api -Dsonar.projectVersion=1.0 -Dsonar.projectKey=ledger-api -Dsonar.sources=. -Dsonar.projectBaseDir=/var/lib/jenkins/workspace/ledger-api-test_${env.BRANCH_NAME}"
            }
        }
    }
}
