def deployment_needed = false;

pipeline {
  agent any
  // environment {
  //   NX_CACHE_DIRECTORY = "/tmp/nx-cache"
  // }
  environment {
    NVM_DIR = '/var/lib/jenkins/.nvm'
  }
  stages {
    stage('Fetch main branch') {
      steps {
        sh 'git fetch origin main:main'
      }
    }
    stage('Setup') {
      steps {
        sh '''
          source $NVM_DIR/nvm.sh > /dev/null 2>&1
          nvm install > /dev/null 2>&1
          node -v
          yarn install --frozen-lockfile
        '''
      }
    }
    stage("Build and test the feature branch") {
      when {
        not {
          branch 'main'
        }
      }
      failFast true
      parallel {
        stage('Check changesets status') {
          steps {
            sh '''
              source $NVM_DIR/nvm.sh > /dev/null 2>&1
              nvm use > /dev/null 2>&1
              node -v
              yarn changeset status --since=main
            '''
          }
        }

        stage ('Lint Dockerfile-s') {
          agent {
            docker {
                image 'hadolint/hadolint:latest-debian'
                reuseNode true
            }
          }
          steps {
            sh 'hadolint Dockerfile apis/**/Dockerfile'
          }
        }

        stage('Lint affected packages') {
          steps {
            sh '''
              source $NVM_DIR/nvm.sh > /dev/null 2>&1
              nvm use > /dev/null 2>&1
              node -v
              yarn lint
            '''
          }
        }

        stage('Audit dependencies') {
          steps {
            sh '''
              source $NVM_DIR/nvm.sh > /dev/null 2>&1
              nvm use > /dev/null 2>&1
              node -v
              yarn run audit
            '''
          }
        }

        stage('Unit test affected packages') {
          environment {
            API_PRIVATE_KEY=credentials('API_PRIVATE_KEY')
          }
          steps {
            sh '''
              source $NVM_DIR/nvm.sh > /dev/null 2>&1
              nvm use > /dev/null 2>&1
              node -v
              yarn test --parallel=1
            '''
          }
        }
      }
    }
    stage("Build and deploy docker images from the main branch") {
      when {
        branch 'main'
      }
      stages {
        stage('Print affected') {
          steps {
            script {
              try {
                sh '''
                  source $NVM_DIR/nvm.sh > /dev/null 2>&1
                  nvm use > /dev/null 2>&1
                  node -v
                  yarn print-affected
                '''
                script { deployment_needed = true }
              } catch (Exception e) {
                echo 'Exception occurred: ' + e.toString()
              }
            }
          }
        }
        stage('Build docker images') {
          when { expression { deployment_needed == true } }
          environment {
            DOCKER_BUILDKIT=1
          }
          steps {
            sh '''
              source $NVM_DIR/nvm.sh > /dev/null 2>&1
              nvm use > /dev/null 2>&1
              node -v
              yarn docker-build:affected --base=main~1 --head=main
            '''
          }
        }
        stage('Run trivy scan') {
          when { expression { deployment_needed == true } }
          steps {
            sh 'scripts/run_trivy.sh main'
          }
        }
        stage('Run Slither Scan') {
          when { expression { deployment_needed == true } }
          steps {
            script {
              catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                  sh 'scripts/run_slither.sh 0.8.12 "Error,High,Medium,Low,Informational,Optimization" ./contracts ./slither_report.json'
              }
            }
          }
        }
        stage('Run Mythril Scan') {
          when { expression { deployment_needed == true } }
          steps {
            script {
              catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                  sh 'scripts/run_mythril.sh 10 "./contracts" "./mythril_reports"'
              }
            }
          }
        }
        stage('Push to ECR') {
          when { expression { deployment_needed == true } }
          steps {
            sh 'scripts/run_update_ecr.sh'
          }
        }
        stage('Modify YAML & Commit') {
          when { expression { deployment_needed == true } }
          steps {
            sh 'scripts/run_update_yaml.sh'
          }
        }
        stage('Deploy on network') {
          when { expression { deployment_needed == true } }
          steps {
            withCredentials([sshUserPrivateKey(credentialsId: 'ebsi1-robot', keyFileVariable: 'PK')]) {
              sh 'scripts/run_deploy.sh'
            }
          }
        }
        stage('Verify Deployment') {
          when { expression { deployment_needed == true } }
          steps {
            withCredentials([sshUserPrivateKey(credentialsId: 'ebsi1-robot', keyFileVariable: 'PK')]) {
              sh 'scripts/run_verify.sh'
            }
          }
        }
      }
    }
  }

  post {
    always {

      // Stop and remove any lingering Mythril containers
      sh 'docker stop $(docker ps -a -q --filter label=mythril) || true'
      sh 'docker rm $(docker ps -a -q --filter label=mythril) || true'

      cleanWs()
      dir("${env.WORKSPACE}@script") {
        deleteDir()
      }
    }
  }
}
