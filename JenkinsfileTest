pipeline {
  agent any

  stages {

    stage('Setup') {
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh 'yarn install --frozen-lockfile'
        }
      }
    }

    stage('Lint all') {
      when {
        branch 'nx'
      }
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh "yarn lint:all"
        }
      }
    }

    stage('Lint affected') {
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh "yarn lint"
        }
      }
    }

    stage('Build the builder image') {
      when {
        branch 'nx'
      }
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh "yarn docker-build"
        }
      }
    }

    // stage('Build all docker images') {
    //   when {
    //     branch 'nx'
    //   }
    //   steps {
    //     nodejs(nodeJSInstallationName: '16.13.0') {
    //       sh "yarn docker-build:all"
    //     }
    //   }
    // }

    // stage('Build docker images affected') {
    //   steps {
    //     nodejs(nodeJSInstallationName: '16.13.0') {
    //       sh "yarn docker-build" // build the docker builder image "core-services"
    //       sh "yarn docker-build:affected" // build services' docker images from the builder
    //     }
    //   }
    // }

    stage('Unit test all') {
      when {
        branch 'nx'
      }
      environment {
        API_PRIVATE_KEY=credentials('API_PRIVATE_KEY')
      }
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh 'yarn test:all'
        }
      }
    }

    stage('Unit test affected') {
      environment {
        API_PRIVATE_KEY=credentials('API_PRIVATE_KEY')
      }
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh 'yarn test'
        }
      }
    }
  }

  post {
    always {
      cleanWs()
      dir("${env.WORKSPACE}@script") {
        deleteDir()
      }
    }
  }
}
