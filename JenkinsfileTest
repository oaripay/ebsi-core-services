pipeline {
  agent any

  options {
    // This is required if you want to clean before build
    skipDefaultCheckout(true)
  }

  stages {

    stage('Setup') {
      steps {
        // Clean before build
        cleanWs()
        // We need to explicitly checkout from SCM here
        checkout scm

        nodejs(nodeJSInstallationName: '16.13.0') {
          sh 'yarn install --frozen-lockfile'
        }
      }
    }

    stage('Lint all') {
      when {
        branch 'nx'
      }
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh "yarn lint:all"
        }
      }
    }

    stage('Lint affected') {
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh "yarn lint"
        }
      }
    }

    stage('Unit test all') {
      when {
        branch 'nx'
      }
      environment {
        API_PRIVATE_KEY=credentials('API_PRIVATE_KEY')
      }
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh 'yarn test:all'
        }
      }
    }

    stage('Unit test affected') {
      environment {
        API_PRIVATE_KEY=credentials('API_PRIVATE_KEY')
      }
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh 'yarn test'
        }
      }
    }
  }

  // post {
  //   cleanup {
  //     cleanWs()
  //     dir("${env.WORKSPACE}@script") {
  //       deleteDir()
  //     }
  //   }
  // }
}
