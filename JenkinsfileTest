pipeline {
  agent any

  stages {
    stage('Fetch main branch') {
      when {
        not {
          branch 'nx'
        }
      }
      steps {
        sh 'git fetch origin nx:nx'
      }
    }

    stage('Setup') {
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh 'yarn install --frozen-lockfile'
        }
      }
    }

    stage('Lint') {
      when {
        branch 'nx'
      }
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh "yarn lint:all"
        }
      }
    }

    // stage('Build docker images') {
    //   when {
    //     branch 'nx'
    //   }
    //   steps {
    //     nodejs(nodeJSInstallationName: '16.13.0') {
    //       sh "yarn docker-build:all"
    //     }
    //   }
    // }

    stage('Test') {
      when {
        branch 'nx'
      }
      environment {
        API_PRIVATE_KEY=credentials('API_PRIVATE_KEY')
      }
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh 'yarn test:all'
        }
      }
    }

    // stage('Check changesets status') {
    //   when {
    //     // Only check changes when not in the main branch
    //     not {
    //       branch 'nx'
    //     }
    //   }
    //   steps {
    //     nodejs(nodeJSInstallationName: '16.13.0') {
    //       sh 'yarn changeset status --since=nx'
    //     }
    //   }
    // }
  }

  post {
    always {
      cleanWs()
      dir("${env.WORKSPACE}@script") {
        deleteDir()
      }
    }
  }
}

