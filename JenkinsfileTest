pipeline {
  agent any

  stages {

    stage('Fetch main branch') {
      when {
        not {
          branch 'nx'
        }
      }
      steps {
        sh 'git fetch origin nx:nx'
      }
    }

    stage('Setup') {
      steps {
        nodejs(nodeJSInstallationName: '16.17.1') {
          sh 'yarn install --frozen-lockfile'
        }
      }
    }

    // Case: pull request
    stage('Lint affected') {
      steps {
        nodejs(nodeJSInstallationName: '16.17.1') {
          sh "yarn lint"
        }
      }
    }

    stage('Test affected') {
      environment {
        API_PRIVATE_KEY=credentials('API_PRIVATE_KEY')
      }
      steps {
        nodejs(nodeJSInstallationName: '16.17.1') {
          sh 'yarn test'
        }
      }
    }

    // Case: trunk (main branch) updated
    stage('Lint') {
      when {
        branch 'nx'
      }
      steps {
        nodejs(nodeJSInstallationName: '16.17.1') {
          sh "yarn lint:all"
        }
      }
    }

    stage('Test') {
      when {
        branch 'nx'
      }
      environment {
        API_PRIVATE_KEY=credentials('API_PRIVATE_KEY')
      }
      steps {
        nodejs(nodeJSInstallationName: '16.17.1') {
          sh 'yarn test:all'
        }
      }
    }

    stage('Build docker images') {
      when {
        branch 'nx'
      }
      steps {
        nodejs(nodeJSInstallationName: '16.17.1') {
          sh "yarn docker-build:all"
        }
      }
    }

    stage('Push to ECR') {
      when {
        branch 'nx'
      }
      steps {
        sh '/usr/local/bin/update_ecr.bash ${GIT_COMMIT}'
      }
    }

    stage('Modify YAML & Commit') {
      when {
        branch 'nx'
      }
      steps {
        sh '/usr/local/bin/update_yaml.bash ${GIT_COMMIT}'
      }
    }

    stage('Deploy on network') {
      when {
        branch 'nx'
      }
      steps {
        withCredentials([sshUserPrivateKey(credentialsId: 'ebsi1-robot', keyFileVariable: 'PK')]) {
          sh 'ssh mco /usr/local/bin/puppet_run_containers_only.sh test aio'
        }
      }
    }

  }

  post {
    always {
      cleanWs()
      dir("${env.WORKSPACE}@script") {
        deleteDir()
      }
    }
  }

}
