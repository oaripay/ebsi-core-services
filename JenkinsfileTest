pipeline {
  agent any

  stages {

    stage('Setup') {
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh 'yarn install --frozen-lockfile'
        }
      }
    }

    stage('Lint all') {
      when {
        branch 'nx'
      }
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh "yarn lint:all"
        }
      }
    }

    stage('Lint') {
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh "yarn lint"
        }
      }
    }

    stage('Unit tests all') {
      when {
        branch 'nx'
      }
      environment {
        API_PRIVATE_KEY=credentials('API_PRIVATE_KEY')
      }
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh 'yarn test:all'
        }
      }
    }

    stage('Unit tests') {
      environment {
        API_PRIVATE_KEY=credentials('API_PRIVATE_KEY')
      }
      steps {
        nodejs(nodeJSInstallationName: '16.13.0') {
          sh 'yarn test'
        }
      }
    }
  }

  post {
    always {
      cleanWs()
      dir("${env.WORKSPACE}@script") {
        deleteDir()
      }
    }
  }
}
