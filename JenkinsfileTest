pipeline {
    agent any
    stages {
        stage('Setup') {
            steps {
                nodejs(nodeJSInstallationName: '16.13.0') {
                    sh 'yarn install --frozen-lockfile'
                    // sh 'yarn run audit'
                }
            }
        }
        // stage('Lint') {
        //     steps {
        //         nodejs(nodeJSInstallationName: '16.13.0') {
        //             sh 'yarn lint'
        //         }
        //     }
        // }
        stage('Lint only affected') {
            steps {
                nodejs(nodeJSInstallationName: '16.13.0') {
                    sh 'yarn nx affected --target=lint --base=origin/nx --parallel'
                }
            }
        }
        stage('Unit tests') {
            environment {
                API_PRIVATE_KEY=credentials('API_AUTHORISATION_PRIVATE_KEY')
            }
            steps {
                nodejs(nodeJSInstallationName: '16.13.0') {
                    sh 'yarn test'
                }
            }
        }
    }
    post {
        always {
            cleanWs()
            dir("${env.WORKSPACE}@script") {
                deleteDir()
            }
        }
    }
}
