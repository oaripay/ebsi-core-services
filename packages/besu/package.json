{
  "private": true,
  "scripts": {
    "prettier-format": "prettier --write 'src/**/*.{js,ts,tsx}'",
    "start": "node src/start.js",
    "test": "yarn run test:unit && yarn run test:e2e",
    "test:unit": "jest --runInBand --detectOpenHandles --coverage --reporters=default --reporters=jest-sonar",
    "test:e2e": "jest --config ./tests/jest-e2e.json",
    "lint-staged": "lint-staged",
    "lint": "yarn run lint:js && yarn run lint:prettier",
    "lint:js": "eslint \"*/**/*.{js,ts}\"",
    "lint:prettier": "prettier --check \"**/*.{md,mdx,html,json,yml,js,jsx,ts,tsx,css,scss}\""
  },
  "keywords": [
    "EBSI",
    "REST",
    "API"
  ],
  "dependencies": {
    "@cef-ebsi/app-jwt": "0.0.6",
    "axios": "^0.19.0",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^8.1.0",
    "ethereumjs-common": "^1.5.1",
    "ethereumjs-tx": "^2.1.2",
    "ethers": "^4.0.40",
    "express": "^4.17.1",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "eslint": "^6.8.0",
    "eslint-config-airbnb-base": "^14.1.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jest": "^23.8.2",
    "eslint-plugin-prettier": "^3.1.3",
    "jest": "^25.1.0",
    "jest-express": "^1.12.0",
    "jest-sonar": "^0.2.5",
    "jose": "^1.27.2",
    "lint-staged": "^10.1.3",
    "prettier": "^2.0.4",
    "supertest": "^4.0.2",
    "web3": "^1.2.9"
  },
  "jest": {
    "coverageDirectory": "./coverage/",
    "testEnvironment": "node"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{md,mdx,html,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
