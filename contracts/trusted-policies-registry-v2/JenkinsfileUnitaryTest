pipeline {
  agent any
  options {
      skipDefaultCheckout()
  }

  stages {
    stage('Checkout'){
      steps {
          checkout poll: false,
              scm: [$class: 'GitSCM',
              branches:[[name: "${env.BRANCH_NAME}"]],
              doGenerateSubmoduleConfigurations: false,
              extensions: [[$class: 'RelativeTargetDirectory', relativeTargetDir: 'core-services']],
              submoduleCfg: [],
              userRemoteConfigs: [[url: 'https://ebsi1-robot@ec.europa.eu/digital-building-blocks/code/scm/ebsi/core-services.git', credentialsId: 'b257a49a-5fed-4971-a6df-e05d3200edc0']]]
      }
    }
    stage('Setup') {
      steps {
        dir('core-services') {
            nodejs(nodeJSInstallationName: '16.17.1') {
                sh 'yarn install --ignore-engines'
            }
        }
      }
    }
    stage('Test Lint') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
          dir('core-services') {
            nodejs(nodeJSInstallationName: '16.17.1') {
              sh 'yarn nx lint @ebsiint-sc/trusted-policies-registry-v2'
            }
          }
        }
      }
    }
    stage('Test functional') {
      steps{
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
          dir('core-services') {
              nodejs(nodeJSInstallationName: '16.17.1') {
                  sh 'yarn nx test:unit @ebsiint-sc/trusted-policies-registry-v2'
              }
          }
        }
      }
    }
  }
  post {
    always {
      cleanWs()
      dir("${env.WORKSPACE}@script") {
        deleteDir()
      }
    }
  }
}
