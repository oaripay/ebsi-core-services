{
  "name": "@ebsiint-sc/trusted-policies-registry",
  "version": "1.0.0",
  "main": "dist/src/types/index.js",
  "types": "dist/src/types/index.d.ts",
  "license": "EUPL-1.2",
  "scripts": {
    "clean": "rimraf artifacts cache src dist",
    "fork": "hardhat node --fork https://eth-mainnet.alchemyapi.io/v2/GVQRQezmyi7tO268bhIl5CSo6lM9ubfp --fork-block-number 11095000",
    "prettier-format": "prettier --write '**/*.{ts,json,md,sol}'",
    "build": "yarn compile",
    "compile": "hardhat compile && yarn tsc",
    "coverage": "hardhat coverage --testfiles 'tests/*.ts'",
    "lint": "yarn lint:prettier && yarn lint:eslint && yarn lint:tsc && yarn run lint:sol",
    "lint:sol": "npx solhint 'contracts/**/*.sol'",
    "lint:eslint": "eslint . --ext .js,.ts",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "hardhat compile && hardhat test"
  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.0.5",
    "@nomiclabs/hardhat-solhint": "^2.0.0",
    "@nomiclabs/hardhat-waffle": "^2.0.2",
    "@typechain/ethers-v5": "^10.1.0",
    "@typechain/hardhat": "^6.1.2",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.1.0",
    "@types/node": "^16.11.26",
    "@typescript-eslint/eslint-plugin": "^5.12.1",
    "@typescript-eslint/parser": "^5.12.1",
    "chai": "^4.3.6",
    "eslint": "^8.9.0",
    "eslint-config-airbnb-typescript": "^16.1.0",
    "eslint-config-prettier": "^8.4.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-prettier": "^4.0.0",
    "ethereum-waffle": "^3.2.2",
    "ethers": "^5.6.9",
    "hardhat": "^2.8.4",
    "hardhat-abi-exporter": "^2.8.0",
    "rimraf": "^3.0.2",
    "solidity-coverage": "^0.7.20",
    "ts-generator": "^0.1.1",
    "ts-node": "^10.5.0",
    "typechain": "^8.1.0",
    "typescript": "^4.1.3"
  },
  "dependencies": {
    "@ebsiint-sc/bootstrap": "^1.0.0",
    "@openzeppelin/contracts": "^4.5.0"
  },
  "nx": {
    "namedInputs": {
      "default": [
        "{projectRoot}/contracts",
        "{projectRoot}/scripts"
      ],
      "prod": [
        "!{projectRoot}/tests/*.spec.ts"
      ]
    },
    "targets": {
      "build": {
        "inputs": [
          "prod",
          "^prod"
        ],
        "outputs": [
          "dist"
        ],
        "dependsOn": [
          "^build"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^prod"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
