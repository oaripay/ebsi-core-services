{
  "name": "@ebsiint-sc/timestamp",
  "private": true,
  "version": "1.0.1-rc.10",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "EUPL-1.2",
  "scripts": {
    "clean": "rimraf artifacts cache src dist",
    "fork": "hardhat node --fork https://eth-mainnet.alchemyapi.io/v2/GVQRQezmyi7tO268bhIl5CSo6lM9ubfp --fork-block-number 11095000",
    "prettier-format": "prettier --write '**/*.{js,json,md,sol}'",
    "build": "yarn compile",
    "compile": "hardhat compile && yarn tsc --project tsconfig.build.json && copyfiles -f src/types/hardhat.d.ts dist",
    "coverage": "hardhat coverage --testfiles 'tests/*.ts'",
    "lint": "yarn run lint:prettier && yarn lint:eslint && yarn lint:tsc && yarn run lint:sol",
    "lint:sol": "solhint -c .solhint.json \"contracts/**/*.sol\"",
    "lint:eslint": "eslint .",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check && yarn prettier --list-different --plugin=prettier-plugin-solidity \"contracts/**/*.sol\"",
    "lint:write": "prettier .  --write && yarn prettier --write --plugin=prettier-plugin-solidity \"contracts/**/*.sol\"",
    "prepare": "yarn clean",
    "test": "hardhat compile && hardhat test",
    "test:unit": "yarn test",
    "test:ci": "hardhat compile && hardhat test && yarn coverage"
  },
  "dependencies": {
    "@ebsiint-sc/bootstrap": "^1.0.1-rc.10",
    "@ebsiint-sc/trusted-policies-registry": "^1.0.1-rc.10"
  },
  "devDependencies": {
    "@gnosis-guild/typechain-ethers-v6": "^0.5.5",
    "@gnosis-guild/typechain-hardhat": "^9.2.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomiclabs/hardhat-solhint": "^4.0.1",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.14",
    "chai": "^4.5.0",
    "ethers": "^6.14.0",
    "hardhat": "^2.23.0",
    "hardhat-abi-exporter": "^2.11.0",
    "solidity-coverage": "^0.8.15",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/artifacts",
          "{projectRoot}/dist",
          "{projectRoot}/src/types"
        ]
      },
      "lint": {
        "dependsOn": [
          "build"
        ]
      },
      "test:unit": {
        "dependsOn": [
          "build"
        ]
      },
      "test:ci": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
