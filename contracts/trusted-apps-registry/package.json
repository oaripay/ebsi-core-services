{
  "name": "@ebsiint-sc/trusted-apps-registry",
  "version": "2.0.0",
  "license": "EUPL-1.2",
  "private": true,
  "description": "Trusted Apps Registry",
  "main": "dist/src/types/index.js",
  "types": "dist/src/types/index.d.ts",
  "scripts": {
    "clean": "rimraf artifacts cache src dist",
    "fork": "hardhat node --fork https://eth-mainnet.alchemyapi.io/v2/GVQRQezmyi7tO268bhIl5CSo6lM9ubfp --fork-block-number 11095000",
    "build": "yarn compile",
    "compile": "hardhat compile && yarn tsc",
    "coverage": "hardhat coverage --testfiles 'tests/*.ts'",
    "lint": "yarn run lint:prettier && yarn lint:eslint && yarn lint:tsc && yarn run lint:sol",
    "lint:sol": "hardhat check",
    "lint:eslint": "eslint . --ext .js,.ts",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "hardhat compile && hardhat test",
    "test:ci": "hardhat compile && hardhat test && yarn coverage"
  },
  "devDependencies": {
    "@ethersproject/abi": "^5.4.7",
    "@ethersproject/bytes": "^5.4.7",
    "@ethersproject/providers": "^5.4.7",
    "@nomiclabs/hardhat-ethers": "^2.0.2",
    "@nomiclabs/hardhat-solhint": "^2.0.0",
    "@nomiclabs/hardhat-waffle": "^2.0.1",
    "@typechain/ethers-v5": "^10.1.0",
    "@typechain/hardhat": "^6.1.2",
    "@types/chai": "^4.2.19",
    "@types/mocha": "^9.0.0",
    "@types/node": "^16.11.26",
    "@typescript-eslint/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^5.10.0",
    "chai": "^4.3.4",
    "eslint": "^8.7.0",
    "eslint-config-airbnb-typescript": "^16.1.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-prettier": "^4.0.0",
    "ethereum-waffle": "^3.4.0",
    "ethers": "^5.6.9",
    "hardhat": "^2.4.1",
    "hardhat-abi-exporter": "^2.8.0",
    "rimraf": "^3.0.2",
    "solidity-coverage": "^0.7.18",
    "ts-generator": "^0.1.1",
    "ts-node": "^10.0.0",
    "typechain": "^8.1.0",
    "typescript": "^4.3.5"
  },
  "dependencies": {
    "@ebsiint-sc/bootstrap": "^1.0.0",
    "@ebsiint-sc/did-registry": "^1.0.0",
    "@ebsiint-sc/trusted-policies-registry": "^1.0.0",
    "@openzeppelin/contracts": "^4.4.2"
  },
  "nx": {
    "namedInputs": {
      "default": [
        "{projectRoot}/contracts",
        "{projectRoot}/scripts"
      ],
      "prod": [
        "!{projectRoot}/tests/*.spec.ts"
      ]
    },
    "targets": {
      "build": {
        "inputs": [
          "prod",
          "^prod"
        ],
        "outputs": [
          "dist"
        ],
        "dependsOn": [
          "^build"
        ]
      },
      "lint": {
        "inputs": [
          "default"
        ],
        "outputs": [],
        "dependsOn": [
          "^build",
          "build"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^prod"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      },
      "test:ci": {
        "inputs": [
          "default",
          "^prod"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
