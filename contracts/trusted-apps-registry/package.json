{
  "name": "@ebsiint-sc/trusted-apps-registry",
  "version": "2.0.1-rc.2",
  "license": "EUPL-1.2",
  "private": true,
  "description": "Trusted Apps Registry",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf artifacts cache src dist",
    "fork": "hardhat node --fork https://eth-mainnet.alchemyapi.io/v2/GVQRQezmyi7tO268bhIl5CSo6lM9ubfp --fork-block-number 11095000",
    "build": "yarn compile",
    "compile": "hardhat compile && yarn tsc --project tsconfig.build.json",
    "coverage": "hardhat coverage --testfiles 'tests/*.ts'",
    "lint": "yarn run lint:prettier && yarn lint:eslint && yarn lint:tsc && yarn run lint:sol",
    "lint:sol": "hardhat check",
    "lint:eslint": "eslint . --ext .js,.ts",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "hardhat compile && hardhat test",
    "test:unit": "yarn test",
    "test:ci": "hardhat compile && hardhat test && yarn coverage"
  },
  "dependencies": {
    "@ebsiint-sc/bootstrap": "^1.0.1-rc.2",
    "@ebsiint-sc/did-registry": "^1.1.0-rc.2",
    "@ebsiint-sc/trusted-policies-registry": "^1.0.1-rc.2"
  },
  "devDependencies": {
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/providers": "^5.7.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-solhint": "^3.0.1",
    "@nomiclabs/hardhat-waffle": "^2.0.5",
    "@typechain/ethers-v5": "^10.2.0",
    "@typechain/hardhat": "^6.1.5",
    "@types/chai": "^4.3.5",
    "@types/mocha": "^10.0.1",
    "@types/node": "^16.18.11",
    "chai": "^4.3.7",
    "ethereum-waffle": "^4.0.10",
    "ethers": "^5.7.2",
    "hardhat": "^2.14.0",
    "hardhat-abi-exporter": "^2.10.1",
    "solidity-coverage": "^0.8.2",
    "ts-node": "^10.9.1",
    "typechain": "^8.1.1"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/src/types"
        ]
      },
      "lint": {
        "dependsOn": [
          "build"
        ]
      },
      "test:unit": {
        "dependsOn": [
          "build"
        ]
      },
      "test:ci": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
