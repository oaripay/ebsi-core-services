{
  "name": "@ebsiint-sc/admin-scripts",
  "private": true,
  "version": "1.0.1-rc.0",
  "main": "index.js",
  "license": "EUPL-1.2",
  "scripts": {
    "clean": "rimraf artifacts cache src",
    "fork": "hardhat node --fork https://eth-mainnet.alchemyapi.io/v2/GVQRQezmyi7tO268bhIl5CSo6lM9ubfp --fork-block-number 11095000",
    "prettier-format": "prettier . --write",
    "prepare-contracts": "scripts/prepare-contracts.sh",
    "compile": "yarn run prepare-contracts && hardhat --config hardhat.config.compiler.ts compile",
    "coverage": "hardhat coverage --testfiles 'tests/*.ts'",
    "lint": "yarn run lint:prettier && yarn lint:eslint && yarn lint:tsc",
    "lint:eslint": "eslint . --ext .js,.ts",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "hardhat test"
  },
  "dependencies": {
    "@ebsiint-sc/bootstrap": "^1.0.1-rc.0",
    "@ebsiint-sc/did-registry": "^1.0.1-rc.0",
    "@ebsiint-sc/proxy": "^1.0.1-rc.0",
    "@ebsiint-sc/timestamp": "^1.0.1-rc.0",
    "@ebsiint-sc/trusted-apps-registry": "^2.0.1-rc.0",
    "@ebsiint-sc/trusted-issuers-registry": "^3.0.1-rc.0",
    "@ebsiint-sc/trusted-ledgers-sc-registry": "^1.0.1-rc.0",
    "@ebsiint-sc/trusted-policies-registry": "^1.0.1-rc.0",
    "@ebsiint-sc/trusted-schemas-registry": "^1.0.1-rc.0",
    "@openzeppelin/contracts": "^4.8.2",
    "elliptic": "^6.5.4"
  },
  "devDependencies": {
    "@nomiclabs/eslint-plugin-hardhat-internal-rules": "^1.0.2",
    "@nomiclabs/hardhat-ethers": "^2.2.2",
    "@nomiclabs/hardhat-etherscan": "^3.1.6",
    "@nomiclabs/hardhat-solhint": "^3.0.0",
    "@nomiclabs/hardhat-waffle": "^2.0.5",
    "@openzeppelin/test-environment": "^0.1.9",
    "@typechain/ethers-v5": "^10.2.0",
    "@typechain/hardhat": "^6.1.5",
    "@types/chai": "^4.3.4",
    "@types/elliptic": "^6.4.14",
    "@types/mocha": "^9.1.1",
    "@types/node": "^16.18.11",
    "canonicalize": "^1.0.8",
    "chai": "^4.3.7",
    "dotenv": "^16.0.3",
    "ethereum-waffle": "^3.4.4",
    "ethers": "^5.7.2",
    "hardhat": "^2.12.7",
    "hardhat-abi-exporter": "^2.10.1",
    "hardhat-deploy": "^0.11.24",
    "hardhat-deploy-ethers": "^0.3.0-beta.13",
    "jose": "^4.13.0",
    "solidity-coverage": "^0.8.2",
    "ts-generator": "^0.1.1",
    "ts-node": "^10.9.1",
    "typechain": "^8.1.1"
  },
  "nx": {
    "targets": {
      "prepare-contracts": {
        "inputs": [
          "^production"
        ],
        "outputs": [
          "{projectRoot}/contracts"
        ]
      },
      "compile": {
        "outputs": [
          "{projectRoot}/src"
        ],
        "dependsOn": [
          "prepare-contracts"
        ]
      },
      "lint": {
        "dependsOn": [
          "^compile",
          "compile"
        ]
      }
    }
  }
}
