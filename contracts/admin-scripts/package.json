{
  "name": "@ebsiint-sc/admin-scripts",
  "private": true,
  "version": "2.0.0-rc.7",
  "main": "index.js",
  "license": "EUPL-1.2",
  "scripts": {
    "clean": "rimraf artifacts cache src",
    "fork": "hardhat node --fork https://eth-mainnet.alchemyapi.io/v2/GVQRQezmyi7tO268bhIl5CSo6lM9ubfp --fork-block-number 11095000",
    "prettier-format": "prettier . --write",
    "prepare-contracts": "scripts/prepare-contracts.sh",
    "compile": "yarn run prepare-contracts && hardhat --config hardhat.config.compiler.ts compile",
    "lint": "yarn run lint:prettier && yarn lint:eslint && yarn lint:tsc",
    "lint:eslint": "eslint . --ext .js,.cjs,.ts",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check"
  },
  "dependencies": {
    "@ebsiint-sc/bootstrap": "^1.0.1-rc.7",
    "@ebsiint-sc/bootstrap-v2": "^2.0.0-rc.3",
    "@ebsiint-sc/did-registry": "^1.1.0-rc.7",
    "@ebsiint-sc/did-registry-v2": "^2.0.0-rc.6",
    "@ebsiint-sc/did-registry-v3": "^3.0.0-rc.3",
    "@ebsiint-sc/proxy": "^2.0.0-rc.7",
    "@ebsiint-sc/timestamp": "^1.0.1-rc.7",
    "@ebsiint-sc/timestamp-v2": "^2.0.0-rc.3",
    "@ebsiint-sc/trusted-apps-registry": "^2.0.1-rc.7",
    "@ebsiint-sc/trusted-apps-registry-v3": "^3.0.0-rc.3",
    "@ebsiint-sc/trusted-issuers-registry": "^2.0.0-rc.7",
    "@ebsiint-sc/trusted-issuers-registry-v3": "^3.0.0-rc.4",
    "@ebsiint-sc/trusted-policies-registry": "^1.0.1-rc.7",
    "@ebsiint-sc/trusted-policies-registry-v2": "^2.0.0-rc.3",
    "@ebsiint-sc/trusted-schemas-registry": "^1.0.1-rc.7",
    "@ebsiint-sc/trusted-schemas-registry-v2": "^2.0.0-rc.3",
    "@openzeppelin/contracts": "^4.9.3",
    "@openzeppelin/contracts-upgradeable": "^4.9.3",
    "elliptic": "^6.5.5"
  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-solhint": "^3.0.1",
    "@nomiclabs/hardhat-waffle": "^2.0.6",
    "@openzeppelin/hardhat-upgrades": "^1.28.0",
    "@typechain/ethers-v5": "^11.1.2",
    "@typechain/hardhat": "^9.1.0",
    "@types/elliptic": "^6.4.18",
    "@types/node": "^20.11.30",
    "canonicalize": "^2.0.0",
    "dotenv": "^16.4.5",
    "ethereum-waffle": "^4.0.10",
    "ethers": "^5.7.2",
    "hardhat": "~2.20.1",
    "hardhat-abi-exporter": "^2.10.1",
    "hardhat-deploy": "^0.11.45",
    "hardhat-deploy-ethers": "^0.3.0-beta.13",
    "jose": "^4.15.4",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2"
  },
  "nx": {
    "targets": {
      "prepare-contracts": {
        "inputs": [
          "^production"
        ],
        "outputs": [
          "{projectRoot}/contracts"
        ]
      },
      "compile": {
        "outputs": [
          "{projectRoot}/src"
        ],
        "dependsOn": [
          "prepare-contracts"
        ]
      },
      "lint": {
        "dependsOn": [
          "^compile",
          "compile"
        ]
      }
    }
  }
}
