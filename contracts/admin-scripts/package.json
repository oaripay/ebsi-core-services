{
  "name": "@ebsiint-sc/admin-scripts",
  "private": true,
  "version": "1.0.0",
  "main": "index.js",
  "license": "EUPL-1.2",
  "scripts": {
    "clean": "rimraf artifacts cache src/abi src/types",
    "fork": "hardhat node --fork https://eth-mainnet.alchemyapi.io/v2/GVQRQezmyi7tO268bhIl5CSo6lM9ubfp --fork-block-number 11095000",
    "prettier-format": "prettier . --write",
    "compile": "mkdir -p src/abi; hardhat --config hardhat.config.compiler.ts compile",
    "coverage": "hardhat coverage --testfiles 'tests/*.ts'",
    "lint": "yarn run lint:prettier && yarn lint:eslint && yarn lint:tsc",
    "lint:eslint": "eslint . --ext .js,.ts",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "hardhat test"
  },
  "dependencies": {
    "@ebsiint-sc/bootstrap": "^1.0.0",
    "@ebsiint-sc/did-registry": "^1.0.0",
