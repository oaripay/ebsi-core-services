{
  "name": "@ebsiint-sc/trusted-schemas-registry",
  "private": true,
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "EUPL-1.2",
  "scripts": {
    "clean": "rimraf artifacts cache src dist",
    "fork": "hardhat node --fork https://eth-mainnet.alchemyapi.io/v2/GVQRQezmyi7tO268bhIl5CSo6lM9ubfp --fork-block-number 11095000",
    "prettier-format": "prettier --write '**/*.{ts,json,md,sol}'",
    "build": "yarn compile",
    "compile": "hardhat compile && yarn tsc",
    "coverage": "hardhat coverage --testfiles 'tests/*.ts'",
    "lint": "yarn lint:prettier && yarn lint:eslint && yarn lint:tsc && yarn run lint:sol",
    "lint:sol": "solhint -c .solhint.json 'contracts/trusted-schemas-registry/**/*.sol'",
    "lint:eslint": "eslint . --ext .js,.ts",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "hardhat compile && hardhat test",
    "test:unit": "yarn test",
    "test:ci": "hardhat compile && hardhat test && yarn coverage"
  },
  "dependencies": {
    "@ebsiint-sc/bootstrap": "^1.0.0",
    "@ebsiint-sc/trusted-policies-registry": "^1.0.0",
    "@openzeppelin/contracts": "^4.8.0"
  },
  "devDependencies": {
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/providers": "^5.7.0",
    "@nomiclabs/hardhat-ethers": "^2.2.1",
    "@nomiclabs/hardhat-solhint": "^2.0.1",
    "@nomiclabs/hardhat-waffle": "^2.0.3",
    "@typechain/ethers-v5": "^10.2.0",
    "@typechain/hardhat": "^6.1.5",
    "@types/chai": "^4.3.4",
    "@types/mocha": "^9.1.1",
    "@types/node": "^16.18.0",
    "@typescript-eslint/eslint-plugin": "^5.46.1",
    "@typescript-eslint/parser": "^5.46.1",
    "chai": "^4.3.7",
    "eslint": "^8.29.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "ethereum-waffle": "^3.4.4",
    "ethers": "^5.7.2",
    "hardhat": "^2.12.4",
    "hardhat-abi-exporter": "^2.10.1",
    "solidity-coverage": "^0.8.2",
    "ts-generator": "^0.1.1",
    "ts-node": "^10.9.1",
    "typechain": "^8.1.1"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/src/types"
        ]
      },
      "lint": {
        "dependsOn": [
          "build"
        ]
      },
      "test:unit": {
        "dependsOn": [
          "build"
        ]
      },
      "test:ci": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
