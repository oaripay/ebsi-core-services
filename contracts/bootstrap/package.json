{
  "name": "@ebsiint-sc/bootstrap",
  "private": true,
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf artifacts cache src dist",
    "build": "yarn compile",
    "compile": "hardhat compile && yarn tsc",
    "coverage": "npx hardhat coverage --network coverage",
    "lint": "yarn run lint:prettier && yarn run lint:eslint && npm run lint:sol",
    "lint:prettier": "prettier . --check",
    "lint:eslint": "eslint . --ext .js,.ts",
    "lint:sol": "solhint --max-warnings 0 \"contracts/**/*.sol\"",
    "test": "hardhat test",
    "test:unit": "yarn test",
    "test:ci": "hardhat compile && hardhat test"
  },
  "license": "EUPL-1.2",
  "devDependencies": {
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/bytes": "^5.7.0",
    "@ethersproject/providers": "^5.7.0",
    "@nomiclabs/hardhat-ethers": "^2.2.0",
    "@nomiclabs/hardhat-etherscan": "^3.1.1",
    "@nomiclabs/hardhat-solhint": "^2.0.1",
    "@nomiclabs/hardhat-waffle": "^2.0.3",
    "@openzeppelin/hardhat-upgrades": "^1.21.0",
    "@typechain/ethers-v5": "^10.1.0",
    "@typechain/hardhat": "^6.1.2",
    "@types/chai": "^4.3.1",
    "@types/mocha": "^9.1.1",
    "@types/node": "^16.11.12",
    "@typescript-eslint/eslint-plugin": "^5.40.0",
    "@typescript-eslint/parser": "^5.40.0",
    "chai": "^4.3.6",
    "chai-bignumber": "^3.1.0",
    "eslint": "^8.25.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "ethereum-waffle": "^3.4.4",
    "ethers": "^5.6.9",
    "hardhat": "^2.12.0",
    "hardhat-abi-exporter": "^2.10.1",
    "hardhat-gas-reporter": "^1.0.4",
    "ts-generator": "^0.1.1",
    "ts-node": "^10.9.1",
    "typechain": "^8.1.0"
  },
  "nx": {
    "namedInputs": {
      "default": [
        "{projectRoot}/contracts"
      ],
      "prod": [
        "!{projectRoot}/tests/*.spec.ts"
      ]
    },
    "targets": {
      "build": {
        "inputs": [
          "prod",
          "^prod"
        ],
        "outputs": [
          "dist"
        ],
        "dependsOn": [
          "^build"
        ]
      },
      "lint": {
        "inputs": [
          "default"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      },
      "test:unit": {
        "inputs": [
          "default",
          "^prod"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      },
      "test:ci": {
        "inputs": [
          "default",
          "^prod"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
