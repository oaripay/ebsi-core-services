{
  "name": "@ebsiint-sc/bootstrap-v2",
  "private": true,
  "version": "2.0.0-rc.8",
  "license": "EUPL-1.2",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf artifacts cache src dist",
    "build": "yarn compile",
    "compile": "hardhat compile && yarn tsc --project tsconfig.build.json && copyfiles -f src/types/hardhat.d.ts dist",
    "coverage": "npx hardhat coverage --network coverage",
    "lint": "yarn run lint:prettier && yarn run lint:eslint && yarn run lint:sol",
    "lint:prettier": "prettier . --check && yarn prettier --list-different --plugin=prettier-plugin-solidity \"contracts/**/*.sol\"",
    "lint:write": "prettier .  --write && yarn prettier --write --plugin=prettier-plugin-solidity \"contracts/**/*.sol\"",
    "lint:eslint": "eslint .",
    "lint:sol": "solhint \"contracts/**/*.sol\"",
    "prepare": "yarn clean",
    "test": "hardhat test",
    "test:unit": "yarn test",
    "test:ci": "hardhat compile && hardhat test"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0"
  },
  "devDependencies": {
    "@gnosis-guild/typechain-ethers-v6": "^0.5.5",
    "@gnosis-guild/typechain-hardhat": "^9.2.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomiclabs/hardhat-solhint": "^4.1.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.9",
    "ethers": "^6.14.4",
    "hardhat": "^2.26.1",
    "hardhat-abi-exporter": "^2.11.0",
    "solidity-coverage": "^0.8.17",
    "typechain": "^8.3.2"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/artifacts",
          "{projectRoot}/dist",
          "{projectRoot}/src/types"
        ]
      }
    }
  }
}
