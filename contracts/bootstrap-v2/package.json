{
  "name": "@ebsiint-sc/bootstrap-v2",
  "private": true,
  "version": "2.0.0-rc.2",
  "license": "EUPL-1.2",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf artifacts cache src dist",
    "build": "yarn compile",
    "compile": "hardhat compile && yarn tsc --project tsconfig.build.json",
    "coverage": "npx hardhat coverage --network coverage",
    "lint": "yarn run lint:prettier && yarn run lint:eslint && yarn run lint:sol",
    "lint:prettier": "prettier . --check",
    "lint:eslint": "eslint . --ext .js,.cjs,.ts",
    "lint:sol": "solhint \"contracts/**/*.sol\"",
    "test": "hardhat test",
    "test:unit": "yarn test",
    "test:ci": "hardhat compile && hardhat test"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.3"
  },
  "devDependencies": {
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/providers": "^5.7.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-solhint": "^3.0.1",
    "@nomiclabs/hardhat-waffle": "^2.0.6",
    "@openzeppelin/hardhat-upgrades": "^1.28.0",
    "@typechain/ethers-v5": "^11.1.2",
    "@typechain/hardhat": "^9.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.19",
    "ethereum-waffle": "^4.0.10",
    "ethers": "^5.7.2",
    "hardhat": "^2.20.1",
    "hardhat-abi-exporter": "^2.10.1",
    "solidity-coverage": "^0.8.7",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/artifacts",
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
