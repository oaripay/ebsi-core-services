{
  "name": "@ebsiint-sc/proxy",
  "private": true,
  "version": "1.0.0",
  "description": "Proxy Smart Contract",
  "main": "dist/index.d.ts",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf build src dist coverage",
    "prettier-format": "prettier --write '**/*.{js,json,md,sol}'",
    "ganache": "ganache-cli --gasLimit=8000000 --allowUnlimitedContractSize -i 5042 >/dev/null 2>&1 &",
    "generate-types": "typechain --target=truffle-v5 'build/contracts/*.json' --out-dir 'dist'",
    "compile": "truffle compile contracts",
    "build": "truffle build --compile-all && yarn generate-types",
    "lint": "yarn run lint:prettier && yarn run lint:js && yarn run lint:sol",
    "lint:sol": " solhint 'contracts/**/*.sol'",
    "lint:prettier": "prettier . --check",
    "lint:js": "eslint --ext .js . --fix --ignore-pattern '*.json'",
    "test": "truffle compile && jest --verbose",
    "test:ci": "yarn run test"
  },
  "author": "",
  "license": "EUPL-1.2",
  "dependencies": {
    "@ebsiint-sc/bootstrap": "^1.0.0",
    "@truffle/hdwallet-provider": "^1.2.1",
    "ganache-core": "^2.13.2",
    "web3": "^1.3.1",
    "web3-eth-contract": "^1.3.1"
  },
  "devDependencies": {
    "@openzeppelin/test-environment": "^0.1.9",
    "@openzeppelin/test-helpers": "^0.5.10",
    "@typechain/truffle-v5": "^8.0.1",
    "eslint": "^8.21.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^26.7.0",
    "eslint-plugin-prettier": "^4.2.1",
    "ganache-cli": "^6.12.2",
    "jest": "^28.1.3",
    "truffle": "^5.1.62",
    "truffle-flattener": "^1.5.0",
    "truffle-typings": "^1.0.8",
    "typechain": "^8.1.0"
  },
  "nx": {
    "namedInputs": {
      "default": [
        "{projectRoot}/contracts",
        "{projectRoot}/scripts"
      ],
      "prod": [
        "!{projectRoot}/tests/*.spec.ts"
      ]
    },
    "targets": {
      "build": {
        "inputs": [
          "prod",
          "^prod"
        ],
        "outputs": [
          "build"
        ],
        "dependsOn": [
          "^build"
        ]
      },
      "lint": {
        "inputs": [
          "default"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^prod"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      },
      "test:ci": {
        "inputs": [
          "default",
          "^prod"
        ],
        "outputs": [],
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
