{
  "name": "@ebsiint-sc/proxy",
  "version": "2.0.0-rc.6",
  "license": "EUPL-1.2",
  "private": true,
  "description": "Proxy Smart Contract",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf artifacts cache src dist",
    "prettier-format": "prettier --write '**/*.{js,json,md,sol}'",
    "compile": "hardhat compile && yarn tsc --project tsconfig.build.json",
    "lint": "yarn run lint:prettier && yarn run lint:eslint && yarn run lint:sol",
    "lint:sol": " solhint \"contracts/**/*.sol\"",
    "lint:prettier": "prettier . --check && yarn prettier --list-different --plugin=prettier-plugin-solidity \"contracts/**/*.sol\"",
    "lint:write": "prettier .  --write && yarn prettier --write --plugin=prettier-plugin-solidity \"contracts/**/*.sol\"",
    "lint:eslint": "eslint --ext .js . --fix --ignore-pattern '*.json'",
    "test": "hardhat compile && hardhat test",
    "test:unit": "yarn test",
    "test:ci": "hardhat compile && hardhat test"
  },
  "dependencies": {
    "@ebsiint-sc/bootstrap-v2": "^2.0.0-rc.2"
  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-solhint": "^3.0.1",
    "@nomiclabs/hardhat-waffle": "^2.0.6",
    "@typechain/ethers-v5": "^11.1.2",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.12",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.25",
    "chai": "^4.3.10",
    "ethereum-waffle": "^4.0.10",
    "ethers": "^5.7.2",
    "hardhat": "~2.20.1",
    "hardhat-abi-exporter": "^2.10.1",
    "solidity-coverage": "^0.8.11",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/artifacts",
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
