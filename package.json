{
  "name": "@ebsi/core-services",
  "version": "0.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --skip-dev --moderate",
    "clean": "nx run-many --target=clean --all",
    "build": "nx affected --target=build --parallel=1",
    "build:all": "nx run-many --target=build --all",
    "docker-build:core": "docker build . -t ebsi/core-services:${GIT_COMMIT}",
    "docker-build:affected": "yarn docker-build:core && nx affected --target=docker:build",
    "docker-build:all": "yarn docker-build:core && nx run-many --target=docker:build --all",
    "lint": "nx affected --target=lint",
    "lint:all": "nx run-many --target=lint --all",
    "test": "nx affected --target=test:unit",
    "test:all": "nx run-many --target=test:unit --all",
    "lint-staged": "lint-staged",
    "prepare": "is-ci || husky",
    "print-affected": "scripts/print-affected.js",
    "postinstall": "yarn run patch-package",
    "patch-package": "patch-package"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@changesets/types": "^6.0.0",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.2",
    "@nx/workspace": "17.2.8",
    "@stoplight/spectral-cli": "^6.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "audit-ci": "^6.6.1",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vitest": "^0.3.22",
    "husky": "^9.0.11",
    "is-ci": "^3.0.1",
    "lint-staged": "^15.2.2",
    "nx": "17.2.8",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.2.5",
    "prettier-plugin-solidity": "^1.3.1",
    "rimraf": "^5.0.5",
    "solhint": "^3.6.2",
    "typescript": "5.3.3"
  },
  "workspaces": {
    "packages": [
      "apis/*",
      "contracts/*"
    ],
    "nohoist": [
      "**/@types/**",
      "**/undici-types"
    ]
  },
  "resolutions": {
    "**/solidity-coverage/mocha": "^10.0.0",
    "**/ganache/bufferutil": "^4.0.8",
    "**/ganache/utf-8-validate": "^6.0.3",
    "**/@ganache/utils/@trufflesuite/bigint-buffer": "1.1.10"
  }
}
