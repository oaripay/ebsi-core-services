{
  "private": true,
  "version": "1.0.0",
  "license": "EUPL-1.2",
  "repository": {
    "type": "bitbucket",
    "url": "https://ec.europa.eu/cefdigital/code/scm/ebsi/identity-hub-api.git"
  },
  "scripts": {
    "audit": "audit-ci --moderate",
    "start": "node dist/start.js",
    "start:dev": "nodemon --watch src --exec 'ts-node' src/start.ts",
    "build": "yarn clean && tsc -p tsconfig-build.json",
    "clean": "rm -rf ./dist ./coverage ./log ./build",
    "clearCache": "jest --clearCache",
    "compile": "tsc",
    "compile:dev": "tsc -w",
    "coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.{js,ts}' 'tests/**/*.{js,ts}' --quiet",
    "full-lint": "tsc --noEmit && eslint 'src/**/*.{js,ts}' --quiet --fix && prettier --write 'src/**/*.{js,ts}'",
    "format": "prettier --write 'src/**/*.{js,ts}' 'tests/**/*.{js,ts}'",
    "test": "jest --clearCache && jest --runInBand --verbose false",
    "test:unit": "jest --clearCache && jest --runInBand --verbose false --testPathPattern=unit",
    "test:integration": "jest --clearCache && jest --runInBand --verbose false --testPathPattern=integration",
    "test:e2e": "jest --clearCache && jest --runInBand --verbose false --testPathPattern=e2e"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.0",
    "@types/cors": "^2.8.7",
    "@types/express": "^4.17.8",
    "@types/jest": "^26.0.14",
    "@types/node": "^12.12.61",
    "@types/supertest": "^2.0.10",
    "@types/swagger-ui-express": "^4.1.2",
    "@types/uuid": "^8.3.0",
    "@types/yamljs": "^0.2.31",
    "@typescript-eslint/eslint-plugin": "^3.8.0",
    "@typescript-eslint/parser": "^3.8.0",
    "audit-ci": "^3.1.1",
    "eslint": "^7.9.0",
    "eslint-config-airbnb-typescript": "^9.0.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-jest": "^23.20.0",
    "eslint-plugin-prettier": "^3.1.4",
    "husky": "^4.3.0",
    "jest": "^26.4.2",
    "jest-sonar": "^0.2.11",
    "lint-staged": "^10.4.0",
    "node-mocks-http": "^1.9.0",
    "nodemon": "^2.0.4",
    "prettier": "^2.1.2",
    "supertest": "^4.0.2",
    "ts-jest": "^26.3.0",
    "ts-node": "^8.10.2",
    "typescript": "^3.9.7"
  },
  "dependencies": {
    "@cef-ebsi/app-jwt": "0.0.11",
    "@cef-ebsi/express-problem-details": "0.0.2",
    "@cef-ebsi/problem-details-errors": "0.0.3",
    "axios": "^0.19.2",
    "base64url": "^3.0.1",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "eciesjs": "^0.3.7",
    "ethers": "^5.0.14",
    "express": "^4.17.1",
    "fast-deep-equal": "^3.1.3",
    "form-data": "^3.0.0",
    "jose": "^1.27.3",
    "swagger-ui-express": "^4.1.4",
    "uuid": "^8.3.0",
    "winston": "^3.3.3",
    "winston-daily-rotate-file": "^4.5.0",
    "yamljs": "^0.3.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
