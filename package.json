{
  "name": "@ebsi/core-services",
  "version": "0.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --skip-dev --moderate",
    "clean": "nx run-many --target=clean --all",
    "build": "nx affected --target=build --parallel=1",
    "build:all": "nx run-many --target=build --all",
    "docker-build:core": "docker build . -t ebsi/core-services:${GIT_COMMIT}",
    "docker-build:affected": "yarn docker-build:core && nx affected --target=docker:build",
    "docker-build:all": "yarn docker-build:core && nx run-many --target=docker:build --all",
    "lint": "nx affected --target=lint",
    "lint:all": "nx run-many --target=lint --all",
    "test": "nx affected --target=test:unit",
    "test:all": "nx run-many --target=test:unit --all",
    "lint-staged": "lint-staged",
    "prepare": "is-ci || husky",
    "print-affected": "scripts/print-affected.js",
    "postinstall": "yarn run patch-package",
    "patch-package": "patch-package"
  },
  "dependencies": {
    "keyv": "^5.3.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@changesets/types": "^6.1.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.29.0",
    "@nx/workspace": "20.8.1",
    "@scaleway/changesets-renovate": "^2.2.1",
    "@stoplight/spectral-cli": "^6.15.0",
    "@tsconfig/node22": "^22.0.2",
    "@tsconfig/strictest": "^2.0.5",
    "@types/mustache": "^4.2.6",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "audit-ci": "^7.1.0",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-regexp": "^2.9.0",
    "eslint-plugin-unicorn": "^59.0.1",
    "eslint-plugin-vitest": "^0.5.4",
    "glob": "^11.0.3",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^15.5.2",
    "mustache": "^4.2.0",
    "nx": "20.8.1",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^1.4.3",
    "read-pkg": "^9.0.1",
    "rimraf": "^6.0.1",
    "solhint": "~5.0.2",
    "spdx-license-list": "^6.10.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.35.0"
  },
  "workspaces": {
    "packages": [
      "apis/*",
      "contracts/*",
      "subgraphs/*"
    ],
    "nohoist": [
      "**/@types/**",
      "**/undici-types",
      "**/@graphprotocol/graph-ts",
      "**/@graphprotocol/graph-ts/**",
      "**/matchstick-as",
      "**/vite",
      "**/vitest",
      "**/@sphereon/**",
      "**/@tsconfig/*"
    ]
  },
  "resolutions": {
    "**/@ethersproject/providers/ws": "^7.5.10",
    "**/@ethersproject/signing-key/elliptic": "^6.6.0",
    "**/@graphprotocol/graph-cli/undici": "7.5.0",
    "**/@graphprotocol/graph-ts/assemblyscript": "0.19.23",
    "**/gluegun/cross-spawn": "^7.0.6",
    "**/gluegun/semver": "^7.7.1",
    "**/gluegun/ejs": "^3.1.10"
  },
  "packageManager": "yarn@1.22.21+sha1.1959a18351b811cdeedbd484a8f86c3cc3bbaf72"
}
