{
  "private": true,
  "version": "0.1.0",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate",
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:hmr": "nest build --webpack --webpackPath webpack-hmr.config.js",
    "start:debug": "nest start --debug --watch",
    "start:openapi": "openapi preview-docs api/openapi.yaml",
    "start:prod": "node dist/main",
    "configure:cassandra": "yarn configure:cassandra:keyspace && yarn configure:cassandra:table",
    "configure:cassandra:keyspace": "dotenv -c -- ./scripts/createKeyspace.sh",
    "configure:cassandra:table": "dotenv -c -- ./scripts/createTable.sh",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:openapi && yarn lint:ts && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "openapi lint api/openapi.yaml",
    "lint:ts": "eslint . --ext .js,.ts ",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "release": "standard-version",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar"
  },
  "dependencies": {
    "@cef-ebsi/problem-details-errors": "0.0.3",
    "@nestjs/common": "^7.4.4",
    "@nestjs/config": "^0.5.0",
    "@nestjs/core": "^7.4.4",
    "@nestjs/platform-fastify": "^7.4.4",
    "@nestjs/terminus": "^7.0.1",
    "cassandra-driver": "^4.6.0",
    "class-transformer": "^0.3.1",
    "class-validator": "^0.12.2",
    "fastify": "^3.7.0",
    "fastify-helmet": "^5.0.3",
    "joi": "^17.3.0",
    "jwt-decode": "^3.1.1",
    "nest-winston": "^1.4.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^6.6.3",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^11.0.0",
    "@nestjs/cli": "^7.5.1",
    "@nestjs/schematics": "^7.1.2",
    "@nestjs/testing": "^7.4.4",
    "@redocly/openapi-cli": "^1.0.0-beta.18",
    "@tsconfig/node12": "^1.0.7",
    "@types/jest": "26.0.15",
    "@types/k6": "^0.28.1",
    "@types/node": "^12.12.67",
    "@types/supertest": "^2.0.9",
    "@typescript-eslint/eslint-plugin": "^4.6.0",
    "@typescript-eslint/parser": "^4.6.0",
    "audit-ci": "^3.0.0",
    "base64url": "^3.0.1",
    "dotenv-cli": "^4.0.0",
    "eslint": "^7.12.1",
    "eslint-config-airbnb-typescript": "^12.0.0",
    "eslint-config-prettier": "^6.14.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jest": "^24.1.0",
    "eslint-plugin-prettier": "^3.1.3",
    "ethers": "^5.0.19",
    "husky": "^4.3.0",
    "jest": "^26.6.1",
    "jest-sonar": "^0.2.11",
    "jose": "^2.0.3",
    "lint-staged": "^10.5.0",
    "prettier": "^2.1.2",
    "rimraf": "^3.0.2",
    "standard-version": "^9.0.0",
    "start-server-webpack-plugin": "^2.2.5",
    "supertest": "^5.0.0",
    "ts-jest": "^26.4.3",
    "ts-loader": "^8.0.7",
    "ts-node": "^9.0.0",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^4.0.5",
    "webpack": "^4.44.1",
    "webpack-node-externals": "^2.5.2"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  }
}
