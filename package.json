{
  "private": true,
  "version": "2.0.0-beta.0",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate",
    "build": "nest build -p tsconfig.production.json",
    "copy:types": "rimraf src/contracts/trusted-schemas && copyfiles submodules/trusted-schemas-registry-ethereum-sc/src/types/*.ts submodules/trusted-schemas-registry-ethereum-sc/src/types/factories/*.ts src/contracts/trusted-schemas --up 4",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:openapi": "openapi lint api/openapi.yaml",
    "lint:prettier": "prettier . --check",
    "lint:tsc": "tsc --noEmit --incremental false",
    "postinstall": "cd submodules/trusted-schemas-registry-ethereum-sc && yarn install --frozen-lockfile && CI=true yarn compile && cd ../.. && yarn copy:types",
    "prebuild": "rimraf dist",
    "release": "standard-version",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:openapi": "openapi preview-docs api/openapi.yaml",
    "start:prod": "node dist/main",
    "test": "jest --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar",
    "test:e2e": "jest --testPathPattern=e2e --runInBand",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@cef-ebsi/app-jwt": "^0.0.13",
    "@cef-ebsi/problem-details-errors": "0.0.4",
    "@nestjs/common": "^7.6.14",
    "@nestjs/config": "^0.6.2",
    "@nestjs/core": "^7.6.14",
    "@nestjs/platform-fastify": "^7.6.14",
    "@nestjs/terminus": "^7.0.1",
    "axios": "^0.21.1",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.13.1",
    "ethers": "^5.0.32",
    "fastify": "3.14.0",
    "fastify-helmet": "^5.2.0",
    "joi": "^17.3.0",
    "nest-winston": "^1.4.0",
    "p-limit": "^3.1.0",
    "reflect-metadata": "^0.1.12",
    "rxjs": "^6.6.6",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^12.0.1",
    "@commitlint/config-conventional": "^12.0.1",
    "@nestjs/cli": "^7.5.6",
    "@nestjs/schematics": "^7.3.0",
    "@nestjs/testing": "^7.6.14",
    "@redocly/openapi-cli": "^1.0.0-beta.35",
    "@tsconfig/node14": "^1.0.0",
    "@types/jest": "^26.0.20",
    "@types/k6": "^0.30.0",
    "@types/node": "^14.14.34",
    "@types/supertest": "^2.0.9",
    "@typescript-eslint/eslint-plugin": "^4.17.0",
    "@typescript-eslint/parser": "^4.17.0",
    "audit-ci": "^3.1.1",
    "copyfiles": "^2.4.1",
    "eslint": "^7.22.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-airbnb-typescript": "^12.0.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jest": "^24.3.1",
    "eslint-plugin-prettier": "^3.3.1",
    "ganache-core": "^2.13.2",
    "husky": "^4.3.8",
    "jest": "^26.6.3",
    "jest-sonar": "^0.2.11",
    "lint-staged": "^10.5.3",
    "prettier": "^2.2.1",
    "rimraf": "^3.0.2",
    "standard-version": "^9.1.1",
    "supertest": "^6.1.3",
    "ts-jest": "^26.5.3",
    "ts-node": "^9.1.1",
    "tsc-watch": "^4.2.8",
    "tsconfig-paths": "^3.9.0",
    "typescript": "~4.2.3"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  }
}
