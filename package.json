{
  "private": true,
  "version": "1.0.0-rc.10",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate --skip-dev",
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:openapi": "openapi preview-docs api/openapi.yaml",
    "start:prod": "node dist/main",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "openapi lint api/openapi.yaml",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "prepare": "is-ci || husky install",
    "release": "standard-version",
    "test": "jest -c jest-puppeteer.config.js --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest -c jest-puppeteer.config.js --testPathPattern=e2e --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar"
  },
  "dependencies": {
    "@cef-ebsi/ebsi-did-resolver": "^1.0.0-alpha.4",
    "@cef-ebsi/problem-details-errors": "^1.0.0-alpha.10",
    "@cef-ebsi/siop-auth": "^1.0.0-alpha.9",
    "@cef-ebsi/verifiable-credential": "^1.0.1",
    "@nestjs/axios": "^0.0.4",
    "@nestjs/common": "^8.2.6",
    "@nestjs/config": "^1.1.6",
    "@nestjs/core": "^8.2.6",
    "@nestjs/platform-fastify": "^8.2.6",
    "@nestjs/terminus": "^8.0.4",
    "axios": "^0.24.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "did-jwt": "^5.12.3",
    "did-resolver": "^3.1.5",
    "eth-crypto": "^2.1.0",
    "fastify-helmet": "^7.0.1",
    "joi": "^17.5.0",
    "jose": "^4.3.9",
    "key-encoder": "^2.0.3",
    "nest-winston": "^1.6.2",
    "reflect-metadata": "^0.1.12",
    "rxjs": "^7.5.2",
    "winston": "^3.4.0",
    "xml2js": "^0.4.23"
  },
  "devDependencies": {
    "@cef-ebsi/wallet-lib": "^1.0.0-rc.6",
    "@commitlint/cli": "^16.1.0",
    "@commitlint/config-conventional": "^16.0.0",
    "@nestjs/cli": "^8.2.0",
    "@nestjs/schematics": "^8.0.5",
    "@nestjs/testing": "^8.2.6",
    "@redocly/openapi-cli": "^1.0.0-beta.80",
    "@tsconfig/node16": "^1.0.2",
    "@types/expect-puppeteer": "^4.4.7",
    "@types/jest": "^27.4.0",
    "@types/jest-environment-puppeteer": "^4.4.1",
    "@types/k6": "^0.36.0",
    "@types/node": "^16.11.12",
    "@types/puppeteer": "^5.4.4",
    "@types/supertest": "^2.0.11",
    "@types/xml2js": "^0.4.9",
    "@typescript-eslint/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^5.10.0",
    "audit-ci": "^5.1.2",
    "eslint": "^8.7.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^16.1.0",
    "eslint-config-prettier": "^8.2.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jest": "^26.0.0",
    "eslint-plugin-prettier": "^4.0.0",
    "expect-puppeteer": "^6.0.2",
    "husky": "^7.0.4",
    "is-ci": "^3.0.1",
    "jest": "^27.4.7",
    "jest-puppeteer": "^6.0.3",
    "jest-sonar": "^0.2.11",
    "lint-staged": "^12.3.1",
    "multiformats": "^9.6.2",
    "nock": "^13.2.2",
    "prettier": "^2.5.1",
    "puppeteer": "^13.1.1",
    "rimraf": "^3.0.2",
    "standard-version": "^9.3.2",
    "supertest": "^6.2.2",
    "ts-jest": "^27.1.3",
    "ts-node": "^10.4.0",
    "tsc-watch": "^4.6.0",
    "tsconfig-paths": "^3.12.0",
    "typescript": "4.5.4"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
