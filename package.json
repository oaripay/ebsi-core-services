{
  "name": "proxy-smart-contract",
  "private": "true",
  "version": "1.0.0",
  "description": "Proxy Smart Contract",
  "main": "truffle-config.js",
  "scripts": {
    "prettier-format": "prettier --write '**/*.{js,json,md,sol}'",
    "ganache": "ganache-cli --gasLimit=8000000 --allowUnlimitedContractSize -i 5042 >/dev/null 2>&1 &",
    "compile": "truffle compile contracts",
    "build": "truffle build --compile-all",
    "lint": "yarn run lint:prettier && yarn run lint:js && yarn run lint:sol",
    "lint:sol": " solhint 'contracts/**/*.sol'",
    "lint:prettier": "prettier . --check",
    "lint-staged": "lint-staged",
    "lint:js": "eslint --ext .js . --fix --ignore-pattern '*.json'",
    "test": "truffle compile && jest --verbose"
  },
  "author": "",
  "license": "EUPL-1.2",
  "dependencies": {
    "@truffle/hdwallet-provider": "^1.1.1",
    "ganache-core": "^2.13.1",
    "web3": "^1.3.0",
    "web3-eth-contract": "^1.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^11.0.0",
    "@openzeppelin/test-environment": "^0.1.6",
    "@openzeppelin/test-helpers": "^0.5.9",
    "eslint": "^7.12.1",
    "eslint-config-airbnb-base": "^14.2.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jest": "^24.1.0",
    "eslint-plugin-prettier": "^3.1.4",
    "ganache-cli": "^6.12.1",
    "husky": "^4.3.0",
    "jest": "^26.6.1",
    "lint-staged": "^10.4.2",
    "prettier": "^2.1.2",
    "prettier-plugin-solidity": "^1.0.0-alpha.59",
    "solhint": "^3.3.1",
    "solidity-coverage": "^0.7.11",
    "truffle": "^5.1.51",
    "truffle-flattener": "^1.5.0",
    "truffle-typings": "^1.0.8"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  }
}
