{
  "private": true,
  "version": "2.0.0-rc.7",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate --skip-dev",
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "configure:cassandra": "yarn configure:cassandra:keyspace && yarn configure:cassandra:tables",
    "configure:cassandra:keyspace": "yarn dotenv -c test ./scripts/createKeyspace.sh",
    "configure:cassandra:tables": "yarn dotenv -c test ./scripts/createTables.sh",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "release": "standard-version",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=e2e --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar",
    "prepare": "is-ci || husky install"
  },
  "dependencies": {
    "@cef-ebsi/oauth2-auth": "^1.0.0-alpha.17",
    "@cef-ebsi/problem-details-errors": "^1.0.0-alpha.11",
    "@cef-ebsi/siop-auth": "^1.0.0-alpha.10",
    "@nestjs/axios": "^0.0.4",
    "@nestjs/common": "^8.2.6",
    "@nestjs/config": "^1.1.7",
    "@nestjs/core": "^8.2.6",
    "@nestjs/passport": "^8.1.0",
    "@nestjs/platform-fastify": "^8.2.6",
    "@nestjs/terminus": "8.0.4",
    "axios": "^0.24.0",
    "cassandra-driver": "^4.6.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "did-jwt": "^5.12.4",
    "fast-json-patch": "^3.1.0",
    "fastify-helmet": "^7.0.1",
    "fastify-multipart": "^5.3.1",
    "joi": "^17.6.0",
    "nest-winston": "^1.6.2",
    "passport": "^0.5.2",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.5.4",
    "winston": "^3.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^16.2.1",
    "@commitlint/config-conventional": "^16.2.1",
    "@nestjs/cli": "^8.2.0",
    "@nestjs/schematics": "^8.0.6",
    "@nestjs/testing": "^8.2.6",
    "@stoplight/spectral-cli": "^6.3.0",
    "@tsconfig/node16": "^1.0.2",
    "@types/busboy": "^1.3.0",
    "@types/jest": "27.4.0",
    "@types/k6": "^0.36.0",
    "@types/node": "^16.11.12",
    "@types/passport-http-bearer": "^1.0.37",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.11.0",
    "@typescript-eslint/parser": "^5.11.0",
    "audit-ci": "^5.1.2",
    "dotenv-cli": "^5.0.0",
    "elliptic": "^6.5.4",
    "eslint": "^8.9.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^16.1.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jest": "^26.1.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^7.0.4",
    "is-ci": "^3.0.1",
    "jest": "^27.5.1",
    "jest-sonar": "^0.2.12",
    "key-encoder": "^2.0.3",
    "lint-staged": "^12.3.4",
    "prettier": "^2.5.1",
    "rimraf": "^3.0.2",
    "standard-version": "^9.3.2",
    "supertest": "^6.2.2",
    "ts-jest": "^27.1.3",
    "ts-node": "^10.5.0",
    "tsconfig-paths": "^3.12.0",
    "typescript": "4.5.4"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
