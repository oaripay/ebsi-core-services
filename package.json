{
  "private": true,
  "version": "2.0.0-rc.1",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate -a 1674",
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:openapi": "openapi preview-docs api/openapi.yaml",
    "start:prod": "node dist/main",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "openapi lint api/openapi.yaml",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "copy:types:timestamp": "rimraf src/contracts/timestamp && copyfiles submodules/timestamp-ethereum-sc/src/types/*.ts submodules/timestamp-ethereum-sc/src/types/factories/*.ts src/contracts/timestamp --up 4",
    "postinstall:timestamp": "cd submodules/timestamp-ethereum-sc && yarn install --frozen-lockfile && CI=true yarn compile && cd ../.. && yarn copy:types:timestamp",
    "postinstall": "yarn postinstall:timestamp",
    "release": "standard-version",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=e2e --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar",
    "prepare": "is-ci || husky install"
  },
  "dependencies": {
    "@cef-ebsi/did-jwt": "^1.0.0-alpha.4",
    "@cef-ebsi/oauth2-auth": "^1.0.0-alpha.5",
    "@cef-ebsi/problem-details-errors": "1.0.0-alpha.3",
    "@cef-ebsi/siop-auth": "^0.3.2",
    "@nestjs/common": "^7.6.15",
    "@nestjs/config": "^0.6.3",
    "@nestjs/core": "^7.6.15",
    "@nestjs/platform-fastify": "^7.6.15",
    "@nestjs/terminus": "^7.1.2",
    "axios": "^0.21.1",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.13.1",
    "did-resolver": "^3.1.0",
    "ethers": "^5.1.0",
    "fastify": "3.15.1",
    "fastify-helmet": "^5.3.1",
    "joi": "^17.4.0",
    "multibase": "^4.0.4",
    "multihashes": "^4.0.2",
    "nest-winston": "^1.4.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.0.0",
    "uuid": "^8.3.2",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^12.1.1",
    "@commitlint/config-conventional": "^12.1.1",
    "@ethersproject/abstract-provider": "^5.1.0",
    "@nestjs/cli": "^7.6.0",
    "@nestjs/schematics": "^7.3.1",
    "@nestjs/testing": "^7.6.15",
    "@redocly/openapi-cli": "^1.0.0-beta.42",
    "@tsconfig/node14": "^1.0.0",
    "@types/bs58": "^4.0.1",
    "@types/jest": "26.0.23",
    "@types/k6": "^0.31.0",
    "@types/node": "^14.14.37",
    "@types/supertest": "^2.0.11",
    "@types/uuid": "^8.3.0",
    "@typescript-eslint/eslint-plugin": "^4.21.0",
    "@typescript-eslint/parser": "^4.21.0",
    "audit-ci": "^4.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^7.23.0",
    "eslint-config-airbnb-typescript": "^12.3.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jest": "^24.3.4",
    "eslint-plugin-prettier": "^3.3.1",
    "ganache-core": "^2.13.2",
    "husky": "^6.0.0",
    "is-ci": "^3.0.0",
    "jest": "^26.6.3",
    "jest-sonar": "^0.2.12",
    "lint-staged": "^10.5.4",
    "prettier": "^2.2.1",
    "rimraf": "^3.0.2",
    "standard-version": "^9.2.0",
    "supertest": "^6.1.3",
    "ts-jest": "^26.5.4",
    "ts-node": "^9.1.1",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^4.2.3"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "resolutions": {
    "ganache-core/lodash": "4.17.21"
  }
}
