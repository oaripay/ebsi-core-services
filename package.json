{
  "private": true,
  "version": "0.0.1",
  "license": "EUPL-1.2",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start:debug": "tsc-watch -p tsconfig.build.json --onSuccess \"node --inspect-brk dist/main.js\"",
    "start:prod": "node dist/main.js",
    "lint-staged": "lint-staged",
    "lint": "npm run lint:js && npm run lint:ts && npm run lint:prettier",
    "lint:js": "eslint \"*/**/*.{js,ts}\"",
    "lint:ts": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier --check \"**/*.{md,json,yml,yaml,js,ts}\"",
    "test": "jest --clearCache && jest --runInBand --verbose false",
    "test:watch": "jest --watch",
    "test:unit": "jest --clearCache && jest --runInBand --verbose false --testPathPattern=unit --collectCoverageFrom=!src/app.ts --collectCoverageFrom=!src/app.module.ts --collectCoverageFrom=!src/main.ts --collectCoverageFrom=!src/contracts/EBSIApplicationRegistry.json",
    "test:integration": "jest --clearCache && jest --runInBand --verbose false --testPathPattern=integration",
    "test:e2e": "jest --clearCache && jest --runInBand --verbose false --testPathPattern=e2e"
  },
  "dependencies": {
    "@hapi/joi": "^17.1.1",
    "@nestjs/common": "^7.2.0",
    "@nestjs/config": "^0.5.0",
    "@nestjs/core": "^7.2.0",
    "@nestjs/platform-express": "^7.2.0",
    "@nestjs/swagger": "^4.5.10",
    "class-transformer": "^0.2.3",
    "class-validator": "^0.12.2",
    "ethers": "^4.0.47",
    "express": "^4.17.1",
    "helmet": "^3.23.1",
    "nest-winston": "^1.3.5",
    "node-rsa": "^1.0.8",
    "reflect-metadata": "^0.1.12",
    "rxjs": "^6.5.5",
    "swagger-ui-express": "^4.1.4",
    "web3": "^1.2.9",
    "web3-utils": "^1.2.9",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^7.2.0",
    "@types/express": "^4.17.6",
    "@types/jest": "^26.0.0",
    "@types/node": "^14.0.13",
    "@types/supertest": "^2.0.9",
    "@typescript-eslint/eslint-plugin": "^3.3.0",
    "eslint": "^6.8.0",
    "eslint-config-airbnb-typescript": "^8.0.2",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.21.2",
    "eslint-plugin-jest": "^23.13.2",
    "eslint-plugin-prettier": "^3.1.4",
    "husky": "^4.2.5",
    "jest": "^26.0.1",
    "jest-sonar": "^0.2.8",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^10.2.11",
    "prettier": "^2.0.5",
    "rimraf": "^3.0.2",
    "supertest": "^4.0.2",
    "ts-jest": "^26.1.0",
    "ts-node": "^8.10.2",
    "tsc-watch": "^4.2.8",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^3.9.5"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
