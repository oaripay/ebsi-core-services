{
  "private": true,
  "version": "2.0.0-rc.0",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate -a 1674",
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "generate-types": "typechain --outDir src/contracts --target=ethers-v5 'submodules/trusted-issuers-registry-ethereum-sc/build/contracts/*.json'",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:openapi": "openapi preview-docs api/openapi.yaml",
    "start:prod": "node dist/main",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:openapi && yarn lint:ts && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "openapi lint api/openapi.yaml",
    "lint:ts": "eslint \"*/**/*.{js,ts}\"",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "postinstall": "cd submodules/trusted-issuers-registry-ethereum-sc && yarn install --frozen-lockfile && yarn compile && cd ../.. && yarn generate-types",
    "release": "standard-version",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=e2e --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prepare": "husky install"
  },
  "dependencies": {
    "@cef-ebsi/did-jwt": "^1.0.0-alpha.4",
    "@cef-ebsi/oauth2-auth": "^1.0.0-alpha.5",
    "@cef-ebsi/problem-details-errors": "1.0.0-alpha.3",
    "@cef-ebsi/siop-auth": "^0.3.2",
    "@nestjs/common": "^7.6.15",
    "@nestjs/config": "^0.6.3",
    "@nestjs/core": "^7.6.15",
    "@nestjs/passport": "^7.1.5",
    "@nestjs/platform-fastify": "^7.6.15",
    "@nestjs/terminus": "^7.1.2",
    "axios": "^0.21.1",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.13.1",
    "ethers": "^5.1.4",
    "fastify": "3.14.0",
    "fastify-helmet": "^5.3.1",
    "joi": "^17.4.0",
    "nest-winston": "^1.5.0",
    "passport": "^0.4.1",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^6.6.7",
    "uuid": "^8.3.2",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^12.1.1",
    "@commitlint/config-conventional": "^12.1.1",
    "@ethersproject/abstract-provider": "^5.1.0",
    "@nestjs/cli": "^7.6.0",
    "@nestjs/schematics": "^7.3.1",
    "@nestjs/testing": "^7.6.15",
    "@redocly/openapi-cli": "^1.0.0-beta.44",
    "@tsconfig/node14": "^1.0.0",
    "@typechain/ethers-v5": "^6.0.5",
    "@types/bs58": "^4.0.1",
    "@types/jest": "26.0.23",
    "@types/node": "^14.14.41",
    "@types/passport-http-bearer": "^1.0.36",
    "@types/supertest": "^2.0.11",
    "@types/uuid": "^8.3.0",
    "@typescript-eslint/eslint-plugin": "^4.22.1",
    "@typescript-eslint/parser": "^4.22.1",
    "audit-ci": "^4.0.0",
    "bs58": "^4.0.1",
    "eslint": "^7.26.0",
    "eslint-config-airbnb-typescript": "^12.3.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jest": "^24.3.6",
    "eslint-plugin-prettier": "^3.4.0",
    "ganache-core": "^2.13.2",
    "husky": "^6.0.0",
    "jest": "^26.6.3",
    "jest-sonar": "^0.2.12",
    "lint-staged": "^11.0.0",
    "prettier": "^2.3.0",
    "rimraf": "^3.0.2",
    "standard-version": "^9.3.0",
    "supertest": "^6.1.3",
    "ts-jest": "^26.5.6",
    "ts-node": "^9.1.1",
    "tsconfig-paths": "^3.9.0",
    "typechain": "^4.0.3",
    "typescript": "4.2.3"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "resolutions": {
    "ganache-core/lodash": "4.17.21"
  }
}
