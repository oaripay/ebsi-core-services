{
  "private": true,
  "scripts": {
    "audit": "audit-ci --moderate && run-s audit:frontend",
    "audit:backend": "cd backend && audit-ci --moderate",
    "audit:frontend": "cd frontend && audit-ci --moderate",
    "bootstrap": "run-s bootstrap:*",
    "bootstrap:besu": "cd packages/besu && npm install",
    "pre-commit": "run-s pre-commit:*",
    "pre-commit:backend": "cd packages/essif-backend && npm run lint-staged ",
    "pre-commit:frontend": "cd packages/essif-frontend && npm run lint-staged",
    "test": "run-s test:*",
    "test:besu": "cd packages/besu && npm test"
  },
  "devDependencies": {
    "audit-ci": "^2.5.1",
    "husky": "^4.2.5",
    "npm-run-all": "^4.1.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run pre-commit"
    }
  }
}
