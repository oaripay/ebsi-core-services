{
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "prettier-format": "prettier --write 'src/**/*.{js,ts,tsx}'",
    "start": "node src/start.js",
    "lint-staged": "lint-staged",
    "lint": "yarn run lint:js && yarn run lint:prettier",
    "lint:js": "eslint \"*/**/*.{js,ts}\"",
    "lint:prettier": "prettier --check \"**/*.{md,mdx,html,json,yml,js,jsx,ts,tsx,css,scss}\"",
    "full-lint": "eslint --fix \"*/**/*.{js,ts}\" && prettier --write \"**/*.{md,mdx,html,json,yml,js,jsx,ts,tsx,css,scss}\"",
    "test": "yarn run test:unit && yarn run test:e2e",
    "test:unit": "jest --coverage --reporters=default --reporters=jest-sonar  --runInBand",
    "test:e2e": "jest --config ./jest-e2e.json --runInBand"
  },
  "keywords": [
    "EBSI",
    "REST",
    "API"
  ],
  "dependencies": {
    "@cef-ebsi/app-jwt": "0.0.11",
    "@cef-ebsi/express-problem-details": "0.0.2",
    "@cef-ebsi/problem-details-errors": "0.0.3",
    "body-parser": "^1.19.0",
    "busboy": "^0.3.1",
    "cassandra-driver": "^4.6.0",
    "cors": "^2.8.5",
    "dotenv": "^8.1.0",
    "ethers": "^5.0.14",
    "express": "^4.17.1",
    "fast-json-patch": "^3.0.0-1",
    "jose": "^1.27.3",
    "uuid": "^8.3.0",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "eslint": "^7.9.0",
    "eslint-config-airbnb-base": "^14.1.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jest": "^23.20.0",
    "eslint-plugin-prettier": "^3.1.3",
    "husky": "^4.3.0",
    "jest": "^26.4.2",
    "jest-sonar": "^0.2.11",
    "lint-staged": "^10.4.0",
    "prettier": "^2.1.2",
    "supertest": "^4.0.2"
  },
  "jest": {
    "coverageDirectory": "./coverage/",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./tests/jest.setup.js"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{md,mdx,html,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
