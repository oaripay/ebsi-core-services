{
  "private": true,
  "scripts": {
    "prettier-format": "prettier --write 'src/**/*.{js,ts,tsx}'",
    "start": "node src/start.js",
    "lint-staged": "lint-staged",
    "lint": "npm run lint:js && npm run lint:prettier",
    "lint:js": "eslint \"*/**/*.{js,ts}\"",
    "lint:prettier": "prettier --check \"**/*.{md,mdx,html,json,yml,js,jsx,ts,tsx,css,scss}\"",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --coverage --reporters=default --reporters=jest-sonar  --runInBand",
    "test:e2e": "jest --config ./jest-e2e.json --runInBand"
  },
  "keywords": [
    "EBSI",
    "REST",
    "API"
  ],
  "dependencies": {
    "@cef-ebsi/app-jwt": "0.0.3",
    "axios": "^0.19.0",
    "body-parser": "^1.19.0",
    "busboy": "^0.3.1",
    "cassandra-driver": "^4.5.2",
    "cors": "^2.8.5",
    "dotenv": "^8.1.0",
    "ethers": "^4.0.47",
    "express": "^4.17.1",
    "fast-json-patch": "^3.0.0-1",
    "form-data": "^3.0.0",
    "jose": "^1.27.1",
    "uuid": "^8.1.0",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "eslint": "^6.8.0",
    "eslint-config-airbnb-base": "^14.1.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jest": "^23.13.2",
    "eslint-plugin-prettier": "^3.1.3",
    "husky": "^4.2.5",
    "jest": "^26.0.1",
    "jest-sonar": "^0.2.8",
    "lint-staged": "^10.2.7",
    "prettier": "^2.0.5",
    "supertest": "^4.0.2"
  },
  "jest": {
    "coverageDirectory": "./coverage/",
    "testEnvironment": "node"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{md,mdx,html,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
