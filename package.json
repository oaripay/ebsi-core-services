{
  "name": "@ebsi/core-services",
  "version": "0.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --skip-dev --moderate",
    "clean": "nx run-many --target=clean --all",
    "build": "nx affected --target=build --parallel=1",
    "build:all": "nx run-many --target=build --all",
    "docker-build:core": "docker build . -t ebsi/core-services:${GIT_COMMIT}",
    "docker-build:affected": "yarn docker-build:core && nx affected --target=docker:build",
    "docker-build:all": "yarn docker-build:core && nx run-many --target=docker:build --all",
    "lint": "nx affected --target=lint",
    "lint:all": "nx run-many --target=lint --all",
    "test": "nx affected --target=test:unit",
    "test:all": "nx run-many --target=test:unit --all",
    "lint-staged": "lint-staged",
    "prepare": "is-ci || husky",
    "print-affected": "scripts/print-affected.js",
    "postinstall": "yarn run patch-package",
    "patch-package": "patch-package"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.8",
    "@changesets/types": "^6.0.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@nx/workspace": "17.2.8",
    "@stoplight/spectral-cli": "^6.12.0",
    "@types/mustache": "^4.2.5",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "audit-ci": "^6.6.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vitest": "^0.4.0",
    "husky": "^9.1.6",
    "is-ci": "^3.0.1",
    "lint-staged": "^15.2.10",
    "mustache": "^4.2.0",
    "nx": "17.2.8",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.3.3",
    "prettier-plugin-solidity": "^1.4.1",
    "rimraf": "^5.0.5",
    "solhint": "^3.6.2",
    "typescript": "5.3.3"
  },
  "workspaces": {
    "packages": [
      "apis/*",
      "contracts/*",
      "subgraphs/*"
    ],
    "nohoist": [
      "**/@types/**",
      "**/undici-types",
      "**/@graphprotocol/graph-ts",
      "**/@graphprotocol/graph-ts/**",
      "**/matchstick-as"
    ]
  },
  "resolutions": {
    "**/ganache/bufferutil": "^4.0.8",
    "**/ganache/utf-8-validate": "^6.0.3",
    "**/ganache/secp256k1": "^4.0.4",
    "**/@ganache/utils/@trufflesuite/bigint-buffer": "1.1.10",
    "**/@ethersproject/providers/ws": "^7.5.10",
    "**/@ethersproject/signing-key/elliptic": "^6.6.0",
    "**/@graphql-mesh/cli/node-libcurl": "link:./node_modules/.cache/null",
    "**/@graphprotocol/graph-cli/semver": "^7.5.2",
    "**/gluegun/cross-spawn": "^7.0.5",
    "**/gluegun/semver": "^7.5.2",
    "**/gluegun/ejs": "^3.1.10",
    "**/@nestjs/core/path-to-regexp": "^3.3.0",
    "**/@nestjs/platform-fastify/path-to-regexp": "^3.3.0"
  }
}
