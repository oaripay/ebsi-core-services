{
  "private": true,
  "version": "2.0.0-rc.0",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate",
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:openapi": "openapi preview-docs api/openapi.yaml",
    "start:prod": "node dist/main",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "openapi lint api/openapi.yaml",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "release": "standard-version",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=e2e --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar",
    "prepare": "is-ci || husky install"
  },
  "dependencies": {
    "@cef-ebsi/oauth2-auth": "^1.0.0-alpha.2",
    "@cef-ebsi/problem-details-errors": "1.0.0-alpha.2",
    "@ethereumjs/common": "2.1.0",
    "@ethereumjs/tx": "3.0.2",
    "@nestjs/common": "^7.6.15",
    "@nestjs/config": "^0.6.3",
    "@nestjs/core": "^7.6.15",
    "@nestjs/platform-fastify": "^7.6.15",
    "@nestjs/terminus": "^7.1.2",
    "@tsconfig/node14": "^1.0.0",
    "axios": "^0.21.1",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.13.1",
    "fastify": "3.14.2",
    "fastify-helmet": "^5.3.1",
    "joi": "^17.4.0",
    "jose": "^3.11.5",
    "mem": "^8.1.0",
    "nest-winston": "^1.4.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^6.6.7",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@cef-ebsi/did-jwt": "^1.0.0-alpha.2",
    "@commitlint/cli": "^12.1.1",
    "@commitlint/config-conventional": "^12.1.1",
    "@nestjs/cli": "^7.6.0",
    "@nestjs/schematics": "^7.3.1",
    "@nestjs/testing": "^7.6.15",
    "@redocly/openapi-cli": "^1.0.0-beta.44",
    "@types/jest": "^26.0.22",
    "@types/k6": "^0.31.0",
    "@types/node": "^14.14.41",
    "@types/supertest": "^2.0.11",
    "@types/uuid": "^8.3.0",
    "@typescript-eslint/eslint-plugin": "^4.22.0",
    "@typescript-eslint/parser": "^4.22.0",
    "audit-ci": "^3.2.0",
    "elliptic": "^6.5.4",
    "eslint": "^7.24.0",
    "eslint-config-airbnb-typescript": "^12.3.1",
    "eslint-config-prettier": "^8.2.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jest": "^24.3.5",
    "eslint-plugin-prettier": "^3.4.0",
    "eth-crypto": "^1.9.0",
    "ethers": "^5.1.3",
    "ganache-core": "^2.13.2",
    "husky": "^6.0.0",
    "is-ci": "^3.0.0",
    "jest": "^26.6.3",
    "jest-sonar": "^0.2.12",
    "key-encoder": "^2.0.3",
    "lint-staged": "^10.5.4",
    "prettier": "^2.2.1",
    "rimraf": "^3.0.2",
    "standard-version": "^9.2.0",
    "supertest": "^6.1.3",
    "ts-jest": "^26.5.5",
    "ts-node": "^9.1.1",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^4.2.4",
    "uuid": "^8.3.2"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
