{
  "private": true,
  "version": "0.0.1",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:ts && yarn lint:tsc && yarn lint:prettier",
    "lint:ts": "eslint \"*/**/*.{js,ts}\"",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier --check \"**/*.{md,json,yml,yaml,js,ts}\"",
    "full-lint": "eslint --fix \"*/**/*.{js,ts}\" && prettier --write \"**/*.{md,mdx,html,json,yml,js,jsx,ts,tsx,css,scss}\"",
    "test:watch": "jest --watch",
    "test:unit": "jest --coverage --reporters=default --reporters=jest-sonar --testPathPattern=\"^.+\\.(spec|test)\\.ts$\"",
    "test:e2e": "jest --clearCache && jest --config ./tests/jest-e2e.json --runInBand",
    "test": "jest --clearCache && jest --config ./tests/jest-all.json --runInBand --verbose false",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@cef-ebsi/app-jwt": "0.0.10",
    "@cef-ebsi/problem-details-errors": "0.0.2",
    "@hapi/joi": "^17.1.1",
    "@nestjs/common": "^7.4.2",
    "@nestjs/config": "^0.5.0",
    "@nestjs/core": "^7.4.2",
    "@nestjs/platform-express": "^7.4.2",
    "@nestjs/swagger": "^4.5.9",
    "axios": "^0.19.2",
    "class-transformer": "^0.3.1",
    "class-validator": "^0.12.2",
    "ethers": "^4.0.47",
    "helmet": "^4.0.0",
    "nest-winston": "^1.3.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^6.6.2",
    "swagger-ui-express": "^4.1.4",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^7.2.0",
    "@nestjs/schematics": "^7.0.1",
    "@nestjs/testing": "^7.4.2",
    "@types/express": "^4.17.6",
    "@types/jest": "26.0.8",
    "@types/node": "^14.0.27",
    "@types/supertest": "^2.0.9",
    "@typescript-eslint/eslint-plugin": "^3.7.1",
    "@typescript-eslint/parser": "^3.7.1",
    "audit-ci": "^3.0.0",
    "eslint": "^7.6.0",
    "eslint-config-airbnb-typescript": "^9.0.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jest": "^23.20.0",
    "eslint-plugin-prettier": "^3.1.3",
    "husky": "^4.2.5",
    "jest": "^26.2.2",
    "jest-sonar": "^0.2.7",
    "lint-staged": "^10.1.3",
    "prettier": "^2.0.5",
    "rimraf": "^3.0.2",
    "supertest": "^4.0.2",
    "ts-jest": "^26.1.4",
    "ts-loader": "^8.0.2",
    "ts-node": "^8.10.2",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^3.9.7"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
