{
  "name": "@ebsi/core-services",
  "version": "0.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "nx run-many --target=audit --all",
    "clean": "nx run-many --target=clean --all",
    "build": "nx affected --target=build --parallel",
    "build:all": "nx run-many --target=build --all",
    "docker-build": "docker build . -t core-services",
    "docker-build:affected": "nx affected --target=docker:build --parallel",
    "docker-build:all": "nx run-many --target=docker:build --all",
    "lint": "nx affected --target=lint --parallel",
    "lint:all": "nx run-many --target=lint --all",
    "test": "nx affected --target=test:ci --parallel",
    "test:all": "nx run-many --target=test:ci --all",
    "lint-staged": "lint-staged",
    "prepare": "is-ci || husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.3",
    "@commitlint/config-conventional": "^17.0.3",
    "@nrwl/cli": "14.4.3",
    "@nrwl/workspace": "14.4.3",
    "@stoplight/spectral-cli": "^6.5.0",
    "husky": "^8.0.1",
    "is-ci": "^3.0.1",
    "lint-staged": "^13.0.3",
    "nx": "14.4.3",
    "prettier": "^2.7.1",
    "prettier-plugin-solidity": "^1.0.0-beta.19",
    "rimraf": "^3.0.2",
    "solhint": "^3.3.7",
    "solhint-plugin-prettier": "^0.0.5",
    "solidity-coverage": "^0.7.21",
    "standard-version": "^9.5.0",
    "typescript": "4.7.4"
  },
  "workspaces": [
    "apis/**",
    "contracts/**"
  ]
}
