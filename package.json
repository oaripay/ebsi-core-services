{
  "name": "trusted-issuers-registry-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate",
    "prebuild": "rimraf dist",
    "eslint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "eslint:fix": "eslint --ext .js,.jsx,.ts,.tsx . --fix",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint-staged": "lint-staged",
    "lint": "npm run lint:js && npm run lint:ts && npm run lint:prettier",
    "lint:js": "eslint \"*/**/*.{js,ts}\"",
    "lint:ts": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier --check \"**/*.{md,json,yml,yaml,js,ts}\"",
    "test:watch": "jest --watch",
    "test": "jest --coverage --reporters=default --reporters=jest-sonar",
    "test:e2e": "jest --clearCache && jest --config ./tests/jest-e2e.json --runInBand",
    "test:all": "jest --clearCache && jest --config ./tests/jest-all.json --runInBand --verbose false",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@cef-ebsi/app-jwt": "0.0.2",
    "@hapi/joi": "^17.1.1",
    "@nestjs/common": "^7.1.3",
    "@nestjs/config": "^0.5.0",
    "@nestjs/core": "^7.1.3",
    "@nestjs/platform-express": "^7.1.3",
    "@nestjs/swagger": "^4.5.9",
    "axios": "^0.19.2",
    "class-transformer": "^0.2.3",
    "class-validator": "^0.12.2",
    "ethers": "^4.0.47",
    "helmet": "^3.22.0",
    "nest-winston": "^1.3.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^6.5.5",
    "swagger-ui-express": "^4.1.4",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "rimraf": "^3.0.2",
    "@nestjs/cli": "^7.2.0",
    "@nestjs/schematics": "^7.0.1",
    "@nestjs/testing": "^7.1.3",
    "@types/express": "^4.17.6",
    "@types/jest": "25.2.1",
    "@types/node": "^14.0.11",
    "@types/supertest": "^2.0.9",
    "@typescript-eslint/eslint-plugin": "^2.28.0",
    "@typescript-eslint/parser": "^2.23.0",
    "audit-ci": "^3.0.0",
    "eslint": "^6.8.0",
    "eslint-config-airbnb-typescript": "^7.2.1",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jest": "^23.13.2",
    "eslint-plugin-prettier": "^3.1.3",
    "husky": "^4.2.5",
    "jest": "^26.0.1",
    "jest-sonar": "^0.2.7",
    "lint-staged": "^10.1.3",
    "prettier": "^2.0.5",
    "supertest": "^4.0.2",
    "ts-jest": "^26.1.0",
    "ts-loader": "^7.0.5",
    "ts-node": "^8.10.2",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^3.9.5"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
