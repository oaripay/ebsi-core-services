{
  "name": "users-onboarding-web-client",
  "version": "1.0.0-rc.3",
  "private": true,
  "license": "EUPL-1.2",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "audit": "audit-ci --moderate -a 1693 1747 1748",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "compress": "precompress build",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "lint:stylelint": "stylelint \"**/*.css\"",
    "release": "standard-version",
    "prepare": "husky install",
    "test:ci": "cross-env SKIP_PREFLIGHT_CHECK=true react-scripts test --watchAll=false --ci --coverage --reporters=default --reporters=jest-sonar"
  },
  "dependencies": {
    "@ecl/ec-preset-website": "^2.38.0",
    "@ecl/ec-resources-logo": "^2.38.0",
    "@react-hook/window-size": "^3.0.7",
    "axios": "^0.21.1",
    "classnames": "^2.2.6",
    "history": "^4.10.1",
    "prop-types": "^15.7.2",
    "qrcode.react": "^1.0.1",
    "query-string": "^7.0.0",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-focus-on": "^3.5.1",
    "react-google-recaptcha-v3": "^1.9.4",
    "react-router-dom": "^5.2.0",
    "react-scripts": "4.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^12.1.4",
    "@commitlint/config-conventional": "^12.1.4",
    "@testing-library/dom": "^7.31.0",
    "@testing-library/jest-dom": "^5.12.0",
    "@testing-library/react": "^11.2.7",
    "@testing-library/user-event": "^13.1.9",
    "@types/classnames": "^2.2.11",
    "@types/enzyme": "^3.10.8",
    "@types/enzyme-adapter-react-16": "^1.0.6",
    "@types/node": "^14.14.45",
    "@types/qrcode.react": "^1.0.1",
    "@types/react": "^17.0.9",
    "@types/react-dom": "^17.0.6",
    "@types/react-router-dom": "^5.1.7",
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "audit-ci": "^4.0.0",
    "cross-env": "^7.0.3",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.6",
    "eslint": "^7.27.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-airbnb-typescript": "^12.0.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-react-app": "^6.0.0",
    "eslint-plugin-flowtype": "^5.7.2",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-jest": "^24.3.6",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-react": "^7.24.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "eslint-plugin-testing-library": "^4.6.0",
    "husky": "^6.0.0",
    "jest-sonar": "^0.2.11",
    "lint-staged": "^11.0.0",
    "precompress": "^6.3.2",
    "prettier": "^2.3.0",
    "source-map-explorer": "^2.5.2",
    "standard-version": "^9.3.0",
    "stylelint": "^13.13.1",
    "stylelint-config-prettier": "^8.0.2",
    "stylelint-config-standard": "^22.0.0",
    "stylelint-prettier": "^1.1.2",
    "typescript": "^4.3.2"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "airbnb-typescript",
      "airbnb/hooks",
      "plugin:@typescript-eslint/recommended",
      "plugin:@typescript-eslint/recommended-requiring-type-checking",
      "react-app/jest",
      "plugin:jest/recommended",
      "plugin:jest/style",
      "prettier",
      "plugin:prettier/recommended"
    ],
    "parserOptions": {
      "project": "./tsconfig.eslint.json"
    }
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard",
      "stylelint-prettier/recommended"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/env.js",
      "!src/index.js"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "standard-version": {
    "skip": {
      "commit": true,
      "tag": true
    },
    "header": "# Changelog\n\nAll notable changes to this project will be documented in this file.\n",
    "types": [
      {
        "type": "feat",
        "section": "🚀 Features"
      },
      {
        "type": "fix",
        "section": "🐛 Bug Fixes"
      },
      {
        "type": "chore",
        "hidden": true
      },
      {
        "type": "docs",
        "hidden": true
      },
      {
        "type": "style",
        "hidden": true
      },
      {
        "type": "refactor",
        "hidden": true
      },
      {
        "type": "perf",
        "hidden": true
      },
      {
        "type": "test",
        "hidden": true
      }
    ],
    "commitUrlFormat": "https://ec.europa.eu/cefdigital/code/projects/EBSI/repos/users-onboarding-web-client/commits/{{hash}}",
    "issueUrlFormat": "https://ec.europa.eu/cefdigital/code/projects/EBSI/repos/users-onboarding-web-client/pull-requests/{{id}}/overview",
    "compareUrlFormat": "https://ec.europa.eu/cefdigital/code/projects/EBSI/repos/users-onboarding-web-client/compare/diff?targetBranch=refs%2Ftags%2F{{previousTag}}&sourceBranch=refs%2Ftags%2F{{currentTag}}&targetRepoId=406"
  }
}
