{
  "private": true,
  "main": "server.js",
  "scripts": {
    "prettier-format": "prettier --write 'src/**/*.{js,ts,tsx}'",
    "start": "node server.js",
    "test": "EBSI_TEST_MODE=true jest --runInBand --detectOpenHandles --coverage --reporters=default --reporters=jest-sonar",
    "test:e2e": "jest --config ./tests/jest-e2e.json"
  },
  "keywords": [
    "EBSI",
    "REST",
    "API"
  ],
  "dependencies": {
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "debug": "^4.1.1",
    "dotenv": "^8.1.0",
    "ethers": "^4.0.40",
    "express": "^4.17.1",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "axios": "^0.19.2",
    "eslint": "^6.8.0",
    "eslint-config-airbnb-base": "^14.1.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jest": "^23.8.2",
    "eslint-plugin-prettier": "^3.1.3",
    "husky": "^4.2.5",
    "jest": "^25.1.0",
    "jest-sonar": "^0.2.5",
    "lint-staged": "^10.1.3",
    "prettier": "^2.0.4"
  },
  "jest": {
    "coverageDirectory": "./coverage/",
    "collectCoverage": true,
    "coverageReporters": [
      "text",
      "lcov",
      "json",
      "text",
      "clover",
      "cobertura"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{md,mdx,html,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
