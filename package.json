{
  "private": true,
  "version": "1.0.0-rc.0",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate --skip-dev",
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:openapi": "openapi preview-docs api/openapi.yaml",
    "start:prod": "node dist/main",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:openapi": "openapi lint api/openapi.yaml",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "prepare": "is-ci || husky install",
    "release": "standard-version",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=e2e --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar"
  },
  "dependencies": {
    "@cef-ebsi/problem-details-errors": "^1.0.0-alpha.9",
    "@cef-ebsi/siop-auth": "^1.0.0-alpha.8",
    "@nestjs/axios": "^0.0.3",
    "@nestjs/common": "^8.2.3",
    "@nestjs/config": "^1.1.5",
    "@nestjs/core": "^8.2.3",
    "@nestjs/passport": "^8.0.1",
    "@nestjs/platform-fastify": "^8.2.3",
    "@nestjs/terminus": "^8.0.1",
    "axios": "^0.23.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "did-jwt": "^5.12.0",
    "fastify-helmet": "^5.3.2",
    "joi": "^17.4.3",
    "nest-winston": "^1.6.2",
    "passport": "^0.5.0",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.13",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^15.0.0",
    "@commitlint/config-conventional": "^15.0.0",
    "@nestjs/cli": "^8.1.4",
    "@nestjs/schematics": "^8.0.4",
    "@nestjs/testing": "^8.2.3",
    "@redocly/openapi-cli": "^1.0.0-beta.67",
    "@tsconfig/node16": "^1.0.2",
    "@types/jest": "^27.0.2",
    "@types/k6": "^0.35.2",
    "@types/node": "^16.11.11",
    "@types/passport-http-bearer": "^1.0.37",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^4.32.0",
    "@typescript-eslint/parser": "^4.32.0",
    "audit-ci": "^5.1.2",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-airbnb-typescript": "^14.0.2",
    "eslint-config-prettier": "^8.2.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-jest": "^24.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^7.0.4",
    "is-ci": "^3.0.1",
    "jest": "^27.4.2",
    "jest-sonar": "^0.2.11",
    "lint-staged": "^11.2.6",
    "nock": "^13.1.4",
    "prettier": "^2.5.0",
    "rimraf": "^3.0.2",
    "rxjs": "^7.4.0",
    "standard-version": "^9.3.2",
    "supertest": "^6.1.6",
    "ts-jest": "^27.0.7",
    "ts-node": "^10.4.0",
    "tsc-watch": "^4.5.0",
    "tsconfig-paths": "^3.12.0",
    "typescript": "4.3.5"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
