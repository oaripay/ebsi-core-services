{
  "private": true,
  "version": "2.0.0-rc.3",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate --skip-dev",
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "configure:cassandra": "yarn configure:cassandra:keyspace && yarn configure:cassandra:tables",
    "configure:cassandra:keyspace": "yarn dotenv -c test ./scripts/createKeyspace.sh",
    "configure:cassandra:tables": "yarn dotenv -c test ./scripts/createTables.sh",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:openapi": "openapi preview-docs api/openapi.yaml",
    "start:prod": "node dist/main",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "openapi lint api/openapi.yaml",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "release": "standard-version",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=e2e --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar",
    "prepare": "is-ci || husky install"
  },
  "dependencies": {
    "@cef-ebsi/did-jwt": "^1.0.0-alpha.8",
    "@cef-ebsi/oauth2-auth": "^1.0.0-alpha.10",
    "@cef-ebsi/problem-details-errors": "1.0.0-alpha.6",
    "@cef-ebsi/siop-auth": "^0.5.5",
    "@nestjs/axios": "^0.0.1",
    "@nestjs/common": "^8.0.6",
    "@nestjs/config": "^1.0.1",
    "@nestjs/core": "^8.0.6",
    "@nestjs/passport": "^8.0.1",
    "@nestjs/platform-fastify": "^8.0.6",
    "@nestjs/terminus": "8.0.0",
    "axios": "^0.21.1",
    "cassandra-driver": "^4.6.3",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.13.1",
    "fast-json-patch": "^3.1.0",
    "fastify": "3.20.1",
    "fastify-helmet": "^5.3.2",
    "fastify-multipart": "^4.0.7",
    "joi": "^17.4.2",
    "jose": "^3.16.1",
    "nest-winston": "^1.6.0",
    "passport": "^0.4.1",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.3.0",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^13.1.0",
    "@commitlint/config-conventional": "^13.1.0",
    "@nestjs/cli": "^8.1.1",
    "@nestjs/schematics": "^8.0.3",
    "@nestjs/testing": "^8.0.6",
    "@redocly/openapi-cli": "^1.0.0-beta.58",
    "@tsconfig/node14": "^1.0.1",
    "@types/busboy": "^0.2.4",
    "@types/jest": "27.0.1",
    "@types/k6": "^0.32.2",
    "@types/node": "^14.14.41",
    "@types/passport-http-bearer": "^1.0.37",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^4.31.0",
    "@typescript-eslint/parser": "^4.31.0",
    "audit-ci": "^4.1.0",
    "dotenv-cli": "^4.0.0",
    "elliptic": "^6.5.4",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-airbnb-typescript": "^14.0.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-jest": "^24.4.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^7.0.2",
    "is-ci": "^3.0.0",
    "jest": "^27.1.1",
    "jest-sonar": "^0.2.12",
    "key-encoder": "^2.0.3",
    "lint-staged": "^11.1.2",
    "prettier": "^2.3.2",
    "rimraf": "^3.0.2",
    "standard-version": "^9.3.1",
    "supertest": "^6.1.6",
    "ts-jest": "^27.0.5",
    "ts-node": "^10.2.1",
    "tsconfig-paths": "3.10.1",
    "typescript": "4.3.5"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
