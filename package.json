{
  "private": true,
  "scripts": {
    "audit": "audit-ci --moderate",
    "bootstrap": "run-s bootstrap:*",
    "bootstrap:besu": "cd packages/besu && yarn install",
    "bootstrap:fabric-test": "cd packages/fabric/tests && yarn install",
    "lint": "run-s lint:*",
    "lint:backend": "cd packages/besu && yarn run lint ",
    "pre-commit": "run-s pre-commit:*",
    "pre-commit:backend": "cd packages/besu && yarn run lint-staged ",
    "test": "run-s test:*",
    "test:besu": "cd packages/besu && yarn test",
    "test:besu-unit": "cd packages/besu && yarn run test:unit",
    "test:fabric-e2e": "cd packages/fabric/tests && yarn run test"
  },
  "devDependencies": {
    "audit-ci": "^3.1.1",
    "husky": "^4.2.5",
    "npm-run-all": "^4.1.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn run pre-commit"
    }
  }
}
