{
  "name": "ebsi-identity-hub",
  "private": true,
  "version": "1.0.0",
  "description": "EBSI Identity Hub",
  "author": "",
  "license": "EUPL-1.2",
  "repository": {
    "type": "bitbucket",
    "url": "https://ec.europa.eu/cefdigital/code/scm/ebsi/identity-hub-api.git"
  },
  "scripts": {
    "audit": "audit-ci --moderate",
    "start": "node dist/start.js",
    "start:dev": "nodemon --watch src --exec 'ts-node' src/start.ts",
    "build": "npm run clean && tsc -p tsconfig-build.json",
    "clean": "rm -rf ./dist ./coverage ./log ./build",
    "clearCache": "jest --clearCache",
    "compile": "tsc",
    "compile:dev": "tsc -w",
    "coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.{js,ts,tsx}' 'tests/**/*.{js,ts,tsx}' --quiet",
    "full-lint": "tsc --noEmit && eslint 'src/**/*.{js,ts,tsx}' --quiet --fix && prettier --write 'src/**/*.{js,ts,tsx}'",
    "format": "prettier --write 'src/**/*.{js,ts,tsx}' 'tests/**/*.{js,ts,tsx}'",
    "test": "jest --clearCache && jest --runInBand --verbose false",
    "test:unit": "jest --clearCache && jest --runInBand --verbose false --testPathPattern=unit",
    "test:integration": "jest --clearCache && jest --runInBand --verbose false --testPathPattern=integration",
    "test:e2e": "jest --clearCache && jest --runInBand --verbose false --testPathPattern=e2e"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.0",
    "@types/cors": "^2.8.6",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.7",
    "@types/form-data": "^2.5.0",
    "@types/jest": "^26.0.4",
    "@types/node": "^14.0.18",
    "@types/supertest": "^2.0.10",
    "@types/swagger-ui-express": "^4.1.2",
    "@types/uuid": "^8.0.0",
    "@types/yamljs": "^0.2.31",
    "@typescript-eslint/eslint-plugin": "^2.34.0",
    "@typescript-eslint/parser": "^2.34.0",
    "audit-ci": "^3.1.1",
    "eslint": "^6.8.0",
    "eslint-config-airbnb-typescript": "^7.2.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-jest": "^23.18.0",
    "eslint-plugin-prettier": "^3.1.4",
    "husky": "^4.2.5",
    "jest": "^26.1.0",
    "jest-sonar": "^0.2.9",
    "lint-staged": "^10.2.11",
    "node-mocks-http": "^1.8.1",
    "nodemon": "^2.0.4",
    "prettier": "^2.0.5",
    "supertest": "^4.0.2",
    "ts-jest": "^26.1.1",
    "ts-node": "^8.10.2",
    "typescript": "^3.9.6"
  },
  "dependencies": {
    "@cef-ebsi/app-jwt": "0.0.6",
    "axios": "^0.19.2",
    "base64url": "^3.0.1",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "eciesjs": "^0.3.6",
    "ethers": "^4.0.47",
    "express": "^4.17.1",
    "fast-deep-equal": "^3.1.3",
    "form-data": "^3.0.0",
    "jose": "^1.27.2",
    "key-encoder": "^2.0.3",
    "moment": "^2.27.0",
    "swagger-ui-express": "^4.1.4",
    "uuid": "^8.2.0",
    "winston": "^3.3.3",
    "winston-daily-rotate-file": "^4.5.0",
    "yamljs": "^0.3.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
