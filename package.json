{
  "private": true,
  "version": "2.0.0-rc.7",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate --skip-dev",
    "build": "nest build -p tsconfig.production.json",
    "clinic:doctor": "yarn build && clinic doctor -- node dist/main",
    "clinic:bubbleprof": "yarn build && clinic bubbleprof -- node dist/main",
    "clinic:flame": "yarn build && clinic flame -- node dist/main",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:prettier": "prettier . --check",
    "lint:tsc": "tsc --noEmit --incremental false",
    "postinstall": "hardhat compile",
    "prebuild": "rimraf dist",
    "release": "standard-version",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar",
    "test:e2e": "jest --testPathPattern=tests/e2e --runInBand",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:watch": "jest --watch",
    "prepare": "is-ci || husky install"
  },
  "dependencies": {
    "@cef-ebsi/problem-details-errors": "^1.0.0-alpha.15",
    "@cef-ebsi/siop-auth": "^1.0.0-alpha.14",
    "@nestjs/axios": "^0.0.7",
    "@nestjs/common": "^8.4.3",
    "@nestjs/config": "^2.0.0",
    "@nestjs/core": "^8.4.3",
    "@nestjs/passport": "^8.2.1",
    "@nestjs/platform-fastify": "^8.4.3",
    "@nestjs/terminus": "^8.0.6",
    "axios": "^0.26.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "did-jwt": "^5.12.4",
    "ethers": "^5.6.2",
    "fastify-helmet": "^7.0.1",
    "joi": "^17.6.0",
    "jose": "^4.6.0",
    "multiformats": "^9.6.4",
    "nest-winston": "^1.6.2",
    "passport": "^0.5.2",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.12",
    "rxjs": "^7.5.5",
    "winston": "^3.6.0"
  },
  "devDependencies": {
    "@cef-ebsi/wallet-lib": "^1.0.0-rc.7",
    "@commitlint/cli": "^16.2.3",
    "@commitlint/config-conventional": "^16.2.1",
    "@ethersproject/abstract-provider": "^5.6.0",
    "@nestjs/cli": "^8.2.4",
    "@nestjs/schematics": "^8.0.9",
    "@nestjs/testing": "^8.4.3",
    "@nomiclabs/hardhat-ethers": "^2.0.5",
    "@openzeppelin/contracts": "^4.5.0",
    "@stoplight/spectral-cli": "^6.3.0",
    "@tsconfig/node16": "^1.0.2",
    "@typechain/ethers-v5": "^10.0.0",
    "@typechain/hardhat": "^6.0.0",
    "@types/jest": "^27.4.1",
    "@types/k6": "^0.36.0",
    "@types/node": "^17.0.23",
    "@types/passport-http-bearer": "^1.0.37",
    "@types/supertest": "^2.0.12",
    "@types/ws": "^8.5.3",
    "@typescript-eslint/eslint-plugin": "^5.17.0",
    "@typescript-eslint/parser": "^5.17.0",
    "audit-ci": "^6.1.2",
    "clinic": "^11.1.0",
    "eslint": "^8.12.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^16.2.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jest": "^26.1.3",
    "eslint-plugin-prettier": "^4.0.0",
    "hardhat": "^2.9.2",
    "husky": "^7.0.4",
    "is-ci": "^3.0.1",
    "jest": "^27.5.1",
    "jest-sonar": "^0.2.11",
    "lint-staged": "^12.3.7",
    "nock": "^13.2.4",
    "prettier": "^2.6.2",
    "rimraf": "^3.0.2",
    "standard-version": "^9.3.2",
    "supertest": "^6.2.2",
    "ts-jest": "^27.1.4",
    "ts-node": "^10.7.0",
    "tsconfig-paths": "^3.14.1",
    "typechain": "^8.0.0",
    "typescript": "4.6.2"
  },
  "resolutions": {
    "@nestjs/axios/axios": "0.26.1",
    "@nestjs/common/axios": "0.26.1"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
