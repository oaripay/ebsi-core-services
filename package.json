{
  "name": "trusted-apps-registry-smart-contract",
  "version": "2.0.0",
  "license": "EUPL-1.2",
  "private": "true",
  "description": "Trusted Apps Registry",
  "scripts": {
    "fork": "hardhat node --fork https://eth-mainnet.alchemyapi.io/v2/GVQRQezmyi7tO268bhIl5CSo6lM9ubfp --fork-block-number 11095000",
    "compile": "hardhat compile",
    "coverage": "hardhat coverage --testfiles 'tests/*.ts'",
    "lint": "yarn run lint:prettier && yarn lint:eslint && yarn lint:tsc && yarn run lint:sol",
    "lint:sol": "hardhat check",
    "lint:eslint": "eslint . --ext .js,.ts",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "test": "hardhat compile && hardhat test",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^16.0.3",
    "@commitlint/config-conventional": "^16.0.0",
    "@nomiclabs/hardhat-ethers": "^2.0.2",
    "@nomiclabs/hardhat-solhint": "^2.0.0",
    "@nomiclabs/hardhat-waffle": "^2.0.1",
    "@typechain/ethers-v5": "^9.0.0",
    "@typechain/hardhat": "^4.0.0",
    "@types/chai": "^4.2.19",
    "@types/mocha": "^9.0.0",
    "@types/node": "^17.0.10",
    "@typescript-eslint/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^5.10.0",
    "chai": "^4.3.4",
    "eslint": "^8.7.0",
    "eslint-config-airbnb-typescript": "^16.1.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-prettier": "^4.0.0",
    "ethereum-waffle": "^3.4.0",
    "ethers": "^5.4.1",
    "hardhat": "^2.4.1",
    "hardhat-abi-exporter": "^2.8.0",
    "husky": "^7.0.0",
    "lint-staged": "^12.2.0",
    "prettier": "^2.3.2",
    "prettier-plugin-solidity": "^1.0.0-beta.13",
    "solhint": "^3.3.6",
    "solhint-plugin-prettier": "^0.0.5",
    "solidity-coverage": "^0.7.18",
    "ts-generator": "^0.1.1",
    "ts-node": "^10.0.0",
    "typechain": "^7.0.0",
    "typescript": "^4.3.5"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.4.2"
  }
}
