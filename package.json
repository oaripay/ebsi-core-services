{
  "name": "ebsi-identity-hub",
  "private": true,
  "version": "1.0.0",
  "description": "EBSI Identity Hub",
  "author": "",
  "license": "EUPL-1.2",
  "repository": {
    "type": "bitbucket",
    "url": "https://ec.europa.eu/cefdigital/code/scm/ebsi/identity-hub-api.git"
  },
  "scripts": {
    "start": "node dist/start.js",
    "start:dev": "nodemon dist/start.js",
    "build": "npm run clean && tsc -p tsconfig-build.json",
    "clean": "rm -rf ./dist ./coverage ./log ./build",
    "compile": "tsc",
    "compile:dev": "tsc -w",
    "coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.{js,ts,tsx}' 'test/**/*.{js,ts,tsx}' --quiet",
    "full-lint": "tsc --noEmit && eslint 'src/**/*.{js,ts,tsx}' --quiet --fix && prettier --write 'src/**/*.{js,ts,tsx}'",
    "format": "prettier --write 'src/**/*.{js,ts,tsx}' 'test/**/*.{js,ts,tsx}'",
    "test": "jest --clearCache && jest --runInBand --verbose false --coverage --reporters=default --reporters=jest-sonar",
    "test:e2e": "jest --clearCache && jest --config ./test/jest-e2e.json",
    "clearCache": "jest --clearCache"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.0",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.3",
    "@types/express-http-proxy": "^1.5.12",
    "@types/form-data": "^2.5.0",
    "@types/jest": "^25.2.1",
    "@types/moment": "^2.13.0",
    "@types/node": "^12.12.31",
    "@types/request": "^2.48.4",
    "@types/request-promise-native": "^1.0.17",
    "@typescript-eslint/eslint-plugin": "^2.27.0",
    "@typescript-eslint/parser": "^2.25.0",
    "eslint": "^6.8.0",
    "eslint-config-airbnb-typescript": "^7.2.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jest": "^23.8.2",
    "eslint-plugin-prettier": "^3.1.2",
    "express-http-proxy": "^1.6.0",
    "husky": "^4.2.5",
    "jest": "^25.1.0",
    "jest-sonar": "^0.2.5",
    "lint-staged": "^10.1.3",
    "mkdirp": "^1.0.3",
    "node-mocks-http": "^1.8.1",
    "nodemon": "^2.0.2",
    "prettier": "^2.0.4",
    "supertest": "^4.0.2",
    "ts-node": "^8.8.1",
    "typescript": "^3.8.3"
  },
  "dependencies": {
    "@types/cors": "^2.8.6",
    "@types/elliptic": "^6.4.12",
    "@types/libsodium-wrappers": "^0.7.7",
    "@types/node-fetch": "^2.5.5",
    "@types/supertest": "^2.0.8",
    "@types/swagger-jsdoc": "^3.0.2",
    "@types/swagger-ui-express": "^4.1.2",
    "@types/uuid": "^7.0.2",
    "@types/yamljs": "^0.2.30",
    "axios": "^0.19.2",
    "base64url": "^3.0.1",
    "bn.js": "latest",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "deep-object-diff": "^1.1.0",
    "did-jwt": "^4.0.0",
    "did-resolver": "^1.1.0",
    "dotenv": "^8.2.0",
    "ebsi-did": "0.0.1",
    "ebsi-did-resolver": "0.0.3",
    "eciesjs": "^0.3.5",
    "ethers": "^4.0.46",
    "ethjs-abi": "latest",
    "ethjs-contract": "latest",
    "express": "^4.17.1",
    "form-data": "^3.0.0",
    "jose": "^1.25.0",
    "key-encoder": "^2.0.3",
    "minimist": "^1.2.5",
    "moment": "^2.24.0",
    "qs": "^6.9.3",
    "request": "^2.88.2",
    "swagger-ui-express": "^4.1.4",
    "ts-jest": "^25.2.1",
    "uninstall": "0.0.0",
    "uuid": "^7.0.2",
    "winston": "^3.2.1",
    "winston-daily-rotate-file": "^4.4.2",
    "xml2js": "^0.4.23",
    "yamljs": "^0.3.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{md,mdx,html,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
