    "@ethereumjs/common": "^2.4.0",
    "@ethereumjs/tx": "^3.2.1",
    "@nestjs/axios": "^0.0.1",
    "@nestjs/common": "^8.0.6",
    "@nestjs/config": "^1.0.1",
    "@nestjs/core": "^8.0.6",
    "@nestjs/platform-fastify": "^8.0.6",
    "@nestjs/terminus": "8.0.0-next.0",
    "axios": "^0.21.1",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.13.1",
    "ethers": "^5.4.4",
    "fabric-common": "^2.2.8",
    "fabric-network": "^2.2.8",
    "fabric-protos": "^2.2.8",
    "fastify": "3.20.1",
    "fastify-helmet": "^5.3.2",
    "joi": "^17.4.2",
    "multibase": "4.0.4",
    "nest-winston": "^1.5.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.3.0",
    "winston": "^3.3.3",
    "ws": "^7.5.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^13.1.0",
    "@commitlint/config-conventional": "^13.1.0",
    "@nestjs/cli": "^8.1.1",
    "@nestjs/schematics": "^8.0.2",
    "@nestjs/testing": "^8.0.6",
    "@nomiclabs/hardhat-ethers": "^2.0.2",
    "@redocly/openapi-cli": "^1.0.0-beta.54",
    "@tsconfig/node14": "^1.0.1",
    "@types/jest": "^26.0.24",
    "@types/k6": "^0.32.2",
    "@types/multibase": "^3.1.0",
    "@types/node": "^14.14.41",
    "@types/supertest": "^2.0.11",
    "@types/ws": "^7.4.7",
    "@typescript-eslint/eslint-plugin": "^4.29.1",
    "@typescript-eslint/parser": "^4.29.1",
    "audit-ci": "^4.1.0",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-typescript": "^12.3.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.24.0",
    "eslint-plugin-jest": "^24.4.0",
    "eslint-plugin-prettier": "^3.4.0",
    "hardhat": "^2.5.0",
    "husky": "^7.0.1",
    "is-ci": "^3.0.0",
    "jest": "^27.0.6",
    "jest-sonar": "^0.2.12",
    "lint-staged": "^11.1.2",
    "nock": "^13.1.1",
    "prettier": "^2.3.2",
    "rimraf": "^3.0.2",
    "standard-version": "^9.3.1",
    "supertest": "^6.1.4",
    "ts-jest": "^27.0.4",
    "ts-node": "^10.2.0",
    "tsconfig-paths": "3.10.1",
    "typescript": "4.3.5"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
