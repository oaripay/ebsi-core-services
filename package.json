{
  "private": true,
  "version": "2.0.0-rc.9",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate --skip-dev",
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "spectral lint api/openapi.yaml",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "release": "standard-version",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=e2e --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar",
    "prepare": "husky install"
  },
  "dependencies": {
    "@cef-ebsi/oauth2-auth": "^1.0.0",
    "@cef-ebsi/problem-details-errors": "^1.0.0",
    "@cef-ebsi/siop-auth": "^1.0.0",
    "@nestjs/axios": "^0.0.4",
    "@nestjs/common": "^8.2.6",
    "@nestjs/config": "^1.1.6",
    "@nestjs/core": "^8.2.6",
    "@nestjs/platform-fastify": "^8.2.6",
    "@nestjs/terminus": "8.0.4",
    "axios": "^0.24.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "did-jwt": "^5.12.4",
    "fast-json-patch": "^3.1.0",
    "fastify-helmet": "^7.0.1",
    "joi": "^17.6.0",
    "multiformats": "^9.6.2",
    "multihashes": "^4.0.3",
    "nest-winston": "^1.6.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.5.2",
    "winston": "^3.5.1",
    "yaml": "^2.1.1"
  },
  "devDependencies": {
    "@cef-ebsi/wallet-lib": "^1.0.1",
    "@commitlint/cli": "^16.1.0",
    "@commitlint/config-conventional": "^16.0.0",
    "@nestjs/cli": "^8.2.0",
    "@nestjs/schematics": "^8.0.5",
    "@nestjs/testing": "^8.2.6",
    "@stoplight/spectral-cli": "^6.3.0",
    "@tsconfig/node16": "^1.0.2",
    "@types/jest": "27.4.0",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/k6": "^0.36.0",
    "@types/node": "^16.11.12",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.10.2",
    "@typescript-eslint/parser": "^5.10.2",
    "audit-ci": "^5.1.2",
    "eslint": "^8.8.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^16.1.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jest": "^26.0.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^7.0.4",
    "jest": "^27.4.7",
    "jest-sonar": "^0.2.12",
    "jsonwebtoken": "^8.5.1",
    "lint-staged": "^12.3.3",
    "nock": "^13.2.2",
    "prettier": "^2.5.1",
    "rimraf": "^3.0.2",
    "standard-version": "^9.3.2",
    "supertest": "^6.2.2",
    "ts-jest": "^27.1.3",
    "ts-node": "^10.4.0",
    "tsconfig-paths": "^3.12.0",
    "typescript": "4.5.4"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
