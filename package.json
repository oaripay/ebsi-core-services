{
  "name": "@ebsi/core-services",
  "version": "0.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --skip-dev --moderate -a GHSA-776f-qx25-q3cc",
    "clean": "nx run-many --target=clean --all",
    "build": "nx affected --target=build",
    "build:all": "nx run-many --target=build --all",
    "docker-build:core": "docker build . -t ebsi/core-services:${GIT_COMMIT}",
    "docker-build:affected": "yarn docker-build:core && nx affected --target=docker:build",
    "docker-build:all": "yarn docker-build:core && nx run-many --target=docker:build --all",
    "lint": "nx affected --target=lint",
    "lint:all": "nx run-many --target=lint --all",
    "test": "nx affected --target=test:unit",
    "test:all": "nx run-many --target=test:unit --all",
    "lint-staged": "lint-staged",
    "prepare": "is-ci || husky install",
    "print-affected": "scripts/print-affected.js",
    "postinstall": "yarn run patch-package",
    "patch-package": "patch-package"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.0",
    "@changesets/types": "^5.2.1",
    "@commitlint/cli": "^17.4.4",
    "@commitlint/config-conventional": "^17.4.4",
    "@nrwl/cli": "15.8.7",
    "@nrwl/workspace": "15.8.7",
    "@stoplight/spectral-cli": "^6.6.0",
    "@typescript-eslint/eslint-plugin": "^5.55.0",
    "@typescript-eslint/parser": "^5.55.0",
    "audit-ci": "^6.6.1",
    "eslint": "^8.36.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.7.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.5.0",
    "eslint-plugin-testing-library": "^5.10.2",
    "husky": "^8.0.3",
    "is-ci": "^3.0.1",
    "lint-staged": "^13.2.0",
    "nx": "15.8.7",
    "patch-package": "^6.5.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^2.8.5",
    "prettier-plugin-solidity": "^1.1.3",
    "rimraf": "^4.4.0",
    "solhint": "^3.4.1",
    "solhint-plugin-prettier": "^0.0.5",
    "stylelint": "^15.3.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard": "^31.0.0",
    "stylelint-prettier": "^3.0.0",
    "typescript": "4.9.5"
  },
  "workspaces": {
    "packages": [
      "apis/*",
      "apps/*",
      "contracts/*"
    ],
    "nohoist": [
      "**/@types/**"
    ]
  }
}
