{
  "private": true,
  "version": "2.0.0-rc.1",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate -a 1748 1753",
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "configure:cassandra": "yarn configure:cassandra:keyspace && yarn configure:cassandra:tables",
    "configure:cassandra:keyspace": "yarn dotenv -c test ./scripts/createKeyspace.sh",
    "configure:cassandra:tables": "yarn dotenv -c test ./scripts/createTables.sh",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:openapi": "openapi preview-docs api/openapi.yaml",
    "start:prod": "node dist/main",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "openapi lint api/openapi.yaml",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "release": "standard-version",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=e2e --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar",
    "prepare": "is-ci || husky install"
  },
  "dependencies": {
    "@cef-ebsi/did-jwt": "^1.0.0-alpha.6",
    "@cef-ebsi/oauth2-auth": "^1.0.0-alpha.8",
    "@cef-ebsi/problem-details-errors": "1.0.0-alpha.5",
    "@cef-ebsi/siop-auth": "^0.5.2",
    "@nestjs/common": "^7.6.17",
    "@nestjs/config": "^0.6.3",
    "@nestjs/core": "^7.6.17",
    "@nestjs/passport": "^7.1.5",
    "@nestjs/platform-fastify": "^7.6.17",
    "@nestjs/terminus": "^7.2.0",
    "axios": "^0.21.1",
    "cassandra-driver": "^4.6.3",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.13.1",
    "fast-json-patch": "^3.0.0-1",
    "fastify": "3.14.0",
    "fastify-helmet": "^5.3.1",
    "fastify-multipart": "^4.0.6",
    "joi": "^17.4.0",
    "jose": "^3.12.3",
    "nest-winston": "^1.5.0",
    "passport": "^0.4.1",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^6.6.7",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^12.1.4",
    "@commitlint/config-conventional": "^12.1.4",
    "@nestjs/cli": "^7.6.0",
    "@nestjs/schematics": "^7.3.1",
    "@nestjs/testing": "^7.6.17",
    "@redocly/openapi-cli": "^1.0.0-beta.49",
    "@tsconfig/node14": "^1.0.0",
    "@types/busboy": "^0.2.3",
    "@types/jest": "26.0.23",
    "@types/k6": "^0.32.0",
    "@types/node": "^14.14.41",
    "@types/passport-http-bearer": "^1.0.36",
    "@types/supertest": "^2.0.11",
    "@types/uuid": "^8.3.0",
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "audit-ci": "^4.0.0",
    "dotenv-cli": "^4.0.0",
    "elliptic": "^6.5.4",
    "eslint": "^7.28.0",
    "eslint-config-airbnb-typescript": "^12.3.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-jest": "^24.3.6",
    "eslint-plugin-prettier": "^3.4.0",
    "husky": "^6.0.0",
    "is-ci": "^3.0.0",
    "jest": "^27.0.4",
    "jest-sonar": "^0.2.12",
    "key-encoder": "^2.0.3",
    "lint-staged": "^11.0.0",
    "prettier": "^2.3.1",
    "rimraf": "^3.0.2",
    "standard-version": "^9.3.0",
    "supertest": "^6.1.3",
    "ts-jest": "^27.0.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^3.9.0",
    "typescript": "4.2.3",
    "uuid": "^8.3.2"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
