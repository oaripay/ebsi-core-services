{
  "private": true,
  "version": "1.0.0",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate",
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:openapi": "openapi preview-docs api/openapi.yaml",
    "start:prod": "node dist/main",
    "configure:cassandra": "yarn configure:cassandra:keyspace && yarn configure:cassandra:table",
    "configure:cassandra:keyspace": "dotenv -c -- ./scripts/createKeyspace.sh",
    "configure:cassandra:table": "dotenv -c -- ./scripts/createTable.sh",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:openapi && yarn lint:ts && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "openapi lint api/openapi.yaml",
    "lint:ts": "eslint . --ext .js,.ts ",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "release": "standard-version",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar"
  },
  "dependencies": {
    "@cef-ebsi/app-jwt": "^0.0.13",
    "@cef-ebsi/problem-details-errors": "0.0.4",
    "@nestjs/common": "^7.6.14",
    "@nestjs/config": "^0.6.3",
    "@nestjs/core": "^7.6.14",
    "@nestjs/platform-fastify": "^7.6.14",
    "@nestjs/terminus": "^7.1.0",
    "cassandra-driver": "^4.6.0",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.13.1",
    "fastify": "3.14.0",
    "fastify-helmet": "^5.3.1",
    "joi": "^17.4.0",
    "jwt-decode": "^3.1.1",
    "nest-winston": "^1.4.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^6.6.6",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^12.0.1",
    "@commitlint/config-conventional": "^12.0.1",
    "@nestjs/cli": "^7.5.6",
    "@nestjs/schematics": "^7.3.0",
    "@nestjs/testing": "^7.6.14",
    "@redocly/openapi-cli": "^1.0.0-beta.38",
    "@tsconfig/node14": "^1.0.0",
    "@types/jest": "26.0.21",
    "@types/k6": "^0.31.0",
    "@types/node": "^14.14.35",
    "@types/supertest": "^2.0.9",
    "@typescript-eslint/eslint-plugin": "^4.18.0",
    "@typescript-eslint/parser": "^4.18.0",
    "audit-ci": "^3.0.0",
    "dotenv-cli": "^4.0.0",
    "eslint": "^7.22.0",
    "eslint-config-airbnb-typescript": "^12.3.1",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jest": "^24.3.2",
    "eslint-plugin-prettier": "^3.1.3",
    "husky": "^4.3.8",
    "jest": "^26.6.1",
    "jest-sonar": "^0.2.12",
    "lint-staged": "^10.5.4",
    "prettier": "^2.1.2",
    "rimraf": "^3.0.2",
    "standard-version": "^9.1.1",
    "supertest": "^6.1.3",
    "ts-jest": "^26.5.4",
    "ts-loader": "^8.0.18",
    "ts-node": "^9.0.0",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^4.2.3"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  }
}
