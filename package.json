{
  "private": true,
  "version": "1.0.0-rc.6",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate --skip-dev",
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:openapi": "openapi preview-docs api/openapi.yaml",
    "start:prod": "node dist/main",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "openapi lint api/openapi.yaml",
    "lint:eslint": "eslint . --ext .js,.ts ",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "release": "standard-version",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=e2e --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar",
    "prepare": "is-ci || husky install"
  },
  "dependencies": {
    "@cef-ebsi/did-jwt": "^1.0.0-alpha.8",
    "@cef-ebsi/oauth2-auth": "^1.0.0-alpha.10",
    "@cef-ebsi/problem-details-errors": "1.0.0-alpha.6",
    "@cef-ebsi/siop-auth": "^0.5.5",
    "@cef-ebsi/verifiable-credential": "^1.0.0-rc.4",
    "@cef-ebsi/verifiable-presentation": "^1.0.0-rc.4",
    "@nestjs/axios": "^0.0.1",
    "@nestjs/common": "^8.0.4",
    "@nestjs/config": "^1.0.0",
    "@nestjs/core": "^8.0.4",
    "@nestjs/platform-fastify": "^8.0.4",
    "@nestjs/terminus": "8.0.0-next.0",
    "axios": "^0.21.1",
    "base64url": "^3.0.1",
    "canonicalize": "^1.0.5",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.13.1",
    "did-resolver": "^3.1.0",
    "fastify": "3.19.1",
    "fastify-helmet": "^5.3.2",
    "joi": "^17.4.1",
    "jose": "^3.14.3",
    "nest-winston": "^1.5.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@cef-ebsi/wallet-lib": "^1.0.0-rc.0",
    "@commitlint/cli": "^12.1.4",
    "@commitlint/config-conventional": "^12.1.4",
    "@nestjs/cli": "^8.0.2",
    "@nestjs/schematics": "^8.0.2",
    "@nestjs/testing": "^8.0.4",
    "@redocly/openapi-cli": "^1.0.0-beta.53",
    "@tsconfig/node14": "^1.0.1",
    "@types/bs58": "^4.0.1",
    "@types/elliptic": "^6.4.13",
    "@types/jest": "26.0.24",
    "@types/k6": "^0.32.2",
    "@types/node": "^14.14.39",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^4.28.3",
    "@typescript-eslint/parser": "^4.28.3",
    "audit-ci": "^4.1.0",
    "bs58": "^4.0.1",
    "elliptic": "^6.5.4",
    "eslint": "^7.30.0",
    "eslint-config-airbnb-typescript": "^12.3.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-jest": "^24.3.6",
    "eslint-plugin-prettier": "^3.4.0",
    "ethers": "^5.4.1",
    "husky": "^7.0.1",
    "is-ci": "^3.0.0",
    "jest": "^27.0.6",
    "jest-sonar": "^0.2.12",
    "key-encoder": "^2.0.3",
    "lint-staged": "^11.0.1",
    "nock": "^13.1.1",
    "prettier": "^2.3.2",
    "rimraf": "^3.0.2",
    "secp256k1": "^4.0.2",
    "standard-version": "^9.3.1",
    "supertest": "^6.1.3",
    "ts-jest": "^27.0.3",
    "ts-node": "^10.1.0",
    "tsconfig-paths": "3.10.1",
    "typescript": "4.3.5"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
