{
  "name": "@ebsi/core-services",
  "version": "0.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --config audit-ci.jsonc",
    "clean": "nx run-many --target=clean --all",
    "build": "nx affected --target=build --parallel=1",
    "build:all": "nx run-many --target=build --all",
    "docker-build:core": "docker build . -t ebsi/core-services:${GIT_COMMIT}",
    "docker-build:affected": "pnpm run docker-build:core && nx affected --target=docker:build",
    "docker-build:all": "pnpm run docker-build:core && nx run-many --target=docker:build --all",
    "lint": "nx affected --target=lint",
    "lint:all": "nx run-many --target=lint --all",
    "test": "nx affected --target=test:unit",
    "test:all": "nx run-many --target=test:unit --all",
    "lint-staged": "lint-staged",
    "postinstall": "node ./scripts/postinstall.mjs",
    "prepare": "is-ci || husky",
    "print-affected": "scripts/print-affected.js"
  },
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@changesets/types": "6.1.0",
    "@commitlint/cli": "20.4.2",
    "@commitlint/config-conventional": "20.4.2",
    "@eslint/js": "9.39.2",
    "@nx/workspace": "20.8.3",
    "@scaleway/changesets-renovate": "2.2.4",
    "@stoplight/spectral-cli": "6.15.0",
    "@tsconfig/node24": "24.0.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/mustache": "4.2.6",
    "@types/node": "24.11.0",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@vitest/eslint-plugin": "1.6.9",
    "audit-ci": "7.1.0",
    "copyfiles": "2.4.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-perfectionist": "5.6.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-regexp": "3.0.0",
    "eslint-plugin-unicorn": "63.0.0",
    "glob": "13.0.6",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "lint-staged": "16.3.1",
    "mustache": "4.2.0",
    "nx": "20.8.3",
    "prettier": "3.8.1",
    "prettier-plugin-solidity": "2.2.1",
    "read-pkg": "10.1.0",
    "rimraf": "6.1.3",
    "solhint": "5.0.2",
    "spdx-license-list": "6.11.0",
    "syncpack": "14.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "yaml": "2.8.2"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
