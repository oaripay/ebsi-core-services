{
  "private": true,
  "scripts": {
    "prettier-format": "prettier --write 'src/**/*.{js,ts,tsx}'",
    "start": "node src/start.js",
    "lint-staged": "lint-staged",
    "lint": "yarn run lint:js && yarn run lint:prettier",
    "lint:js": "eslint \"*/**/*.{js,ts}\"",
    "lint:prettier": "prettier --check \"**/*.{md,mdx,html,json,yml,js,jsx,ts,tsx,css,scss}\"",
    "full-lint": "eslint \"*/**/*.{js,ts}\" --quiet --fix && prettier --write \"**/*.{md,mdx,html,json,yml,js,jsx,ts,tsx,css,scss}\"",
    "test": "yarn run test:unit && yarn run test:e2e",
    "test:unit": "jest --runInBand --detectOpenHandles --coverage --reporters=default --reporters=jest-sonar",
    "test:e2e": "jest --runInBand --config ./tests/jest-e2e.json"
  },
  "dependencies": {
    "@cef-ebsi/app-jwt": "0.0.11",
    "@cef-ebsi/express-problem-details": "0.0.2",
    "@cef-ebsi/problem-details-errors": "0.0.3",
    "axios": "^0.19.0",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^8.1.0",
    "ethereumjs-common": "^1.5.2",
    "ethereumjs-tx": "^2.1.2",
    "ethers": "^5.0.14",
    "express": "^4.17.1",
    "fabric-client": "^1.4.10",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "eslint": "^7.9.0",
    "eslint-config-airbnb-base": "^14.1.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jest": "^23.20.0",
    "eslint-plugin-prettier": "^3.1.3",
    "husky": "^4.3.0",
    "jest": "^26.4.2",
    "jest-express": "^1.12.0",
    "jest-sonar": "^0.2.11",
    "jose": "^1.27.2",
    "lint-staged": "^10.4.0",
    "prettier": "^2.1.2",
    "supertest": "^4.0.2",
    "web3": "^1.3.0"
  },
  "jest": {
    "coverageDirectory": "./coverage/",
    "testEnvironment": "node"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{md,mdx,html,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
