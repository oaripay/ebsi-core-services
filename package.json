{
  "name": "trusted-issuers-registry-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "license": "EUPL Version 1.2",
  "scripts": {
    "audit": "audit-ci --moderate",
    "prebuild": "rimraf dist",
    "eslint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "eslint:fix": "eslint --ext .js,.jsx,.ts,.tsx . --fix",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint:ts": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:prettier": "prettier --check \"**/*.{md,mdx,html,json,yml,ts,tsx,css,scss}\"",
    "lint": "npm run lint:ts && npm run lint:prettier",
    "test:watch": "jest --watch",
    "test": "jest --clearCache && jest --runInBand --verbose false",
    "test:e2e": "jest --clearCache && jest --config ./tests/jest-e2e.json --runInBand",
    "test:all": "jest --clearCache && jest --config ./tests/jest-all.json --runInBand --verbose false",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@cef-ebsi/app-jwt": "0.0.2",
    "@nestjs/common": "^7.1.0",
    "@nestjs/config": "^0.5.0",
    "@nestjs/core": "^7.1.0",
    "@nestjs/platform-express": "^7.1.0",
    "@nestjs/swagger": "^4.5.8",
    "@types/jest": "25.2.1",
    "@types/node": "^13.13.4",
    "axios": "^0.19.2",
    "class-transformer": "^0.2.3",
    "class-validator": "^0.12.2",
    "dotenv": "^8.2.0",
    "ethers": "^4.0.47",
    "jose": "^1.27.0",
    "nest-winston": "^1.3.4",
    "node-rsa": "^1.0.8",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.0",
    "rxjs": "^6.5.5",
    "swagger-ui-express": "^4.1.4",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^7.1.5",
    "@nestjs/schematics": "^7.0.0",
    "@nestjs/testing": "^7.0.9",
    "@types/express": "^4.17.3",
    "@types/supertest": "^2.0.8",
    "@typescript-eslint/eslint-plugin": "^2.28.0",
    "@typescript-eslint/parser": "^2.23.0",
    "audit-ci": "^3.0.0",
    "eslint": "^6.8.0",
    "eslint-config-airbnb-typescript": "^7.2.1",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-prettier": "^3.1.3",
    "husky": "^4.2.5",
    "jest": "^25.1.0",
    "jest-sonar": "^0.2.7",
    "lint-staged": "^10.1.3",
    "prettier": "^1.19.1",
    "supertest": "^4.0.2",
    "ts-jest": "25.2.1",
    "ts-loader": "^6.2.1",
    "ts-node": "^8.6.2",
    "tsconfig-paths": "^3.9.0",
    "tslint": "^6.1.1",
    "typescript": "^3.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "{src,apps,libs,test}/**/*.ts": [
      "eslint  --fix"
    ],
    "*.{md,mdx,html,json,yml}": "prettier --write"
  }
}
