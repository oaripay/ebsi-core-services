{
  "private": true,
  "version": "2.0.0-rc.8",
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --moderate --skip-dev",
    "prebuild": "rimraf dist",
    "build": "nest build -p tsconfig.production.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:openapi": "openapi preview-docs api/openapi.yaml",
    "start:prod": "node dist/main",
    "lint-staged": "lint-staged",
    "lint": "yarn lint:openapi && yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:openapi": "openapi lint api/openapi.yaml",
    "lint:eslint": "eslint \"*/**/*.{js,ts}\"",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "postinstall": "hardhat compile",
    "release": "standard-version",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --testPathPattern=e2e --runInBand",
    "test:ci": "yarn test:unit --coverage --reporters=default --reporters=jest-sonar",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prepare": "husky install"
  },
  "dependencies": {
    "@cef-ebsi/oauth2-auth": "^1.0.0-alpha.16",
    "@cef-ebsi/problem-details-errors": "^1.0.0-alpha.10",
    "@cef-ebsi/siop-auth": "^1.0.0-alpha.9",
    "@nestjs/axios": "^0.0.4",
    "@nestjs/common": "^8.2.5",
    "@nestjs/config": "^1.1.6",
    "@nestjs/core": "^8.2.5",
    "@nestjs/passport": "^8.1.0",
    "@nestjs/platform-fastify": "^8.2.5",
    "@nestjs/terminus": "^8.0.4",
    "axios": "^0.24.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "did-jwt": "^5.12.3",
    "ethers": "^5.5.3",
    "fastify-helmet": "^7.0.0",
    "joi": "^17.5.0",
    "multiformats": "^9.5.8",
    "nest-winston": "^1.6.2",
    "passport": "^0.5.2",
    "passport-http-bearer": "^1.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.5.2",
    "winston": "^3.4.0"
  },
  "devDependencies": {
    "@cef-ebsi/wallet-lib": "^1.0.0-rc.6",
    "@commitlint/cli": "^16.0.2",
    "@commitlint/config-conventional": "^16.0.0",
    "@ethersproject/abstract-provider": "^5.5.1",
    "@nestjs/cli": "^8.2.0",
    "@nestjs/schematics": "^8.0.5",
    "@nestjs/testing": "^8.2.5",
    "@nomiclabs/hardhat-ethers": "^2.0.4",
    "@redocly/openapi-cli": "^1.0.0-beta.79",
    "@tsconfig/node14": "^1.0.1",
    "@typechain/ethers-v5": "^9.0.0",
    "@typechain/hardhat": "^4.0.0",
    "@types/jest": "^27.4.0",
    "@types/k6": "^0.35.2",
    "@types/node": "^16.11.12",
    "@types/passport-http-bearer": "^1.0.37",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^5.10.0",
    "audit-ci": "^5.1.2",
    "eslint": "^8.7.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^16.1.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jest": "^25.7.0",
    "eslint-plugin-prettier": "^4.0.0",
    "hardhat": "^2.8.2",
    "husky": "^7.0.4",
    "jest": "^27.4.7",
    "jest-sonar": "^0.2.12",
    "lint-staged": "^12.2.0",
    "nock": "^13.2.2",
    "prettier": "^2.5.1",
    "rimraf": "^3.0.2",
    "standard-version": "^9.3.2",
    "supertest": "^6.2.1",
    "ts-jest": "^27.1.3",
    "ts-node": "^10.4.0",
    "tsconfig-paths": "^3.12.0",
    "typechain": "^7.0.0",
    "typescript": "4.5.4"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
