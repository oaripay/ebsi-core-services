{
  "name": "@ebsi/core-services",
  "version": "0.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "scripts": {
    "audit": "audit-ci --skip-dev --moderate",
    "clean": "nx run-many --target=clean --all",
    "build": "nx affected --target=build --parallel=1",
    "build:all": "nx run-many --target=build --all",
    "docker-build:core": "docker build . -t ebsi/core-services:${GIT_COMMIT}",
    "docker-build:affected": "yarn docker-build:core && nx affected --target=docker:build",
    "docker-build:all": "yarn docker-build:core && nx run-many --target=docker:build --all",
    "lint": "nx affected --target=lint",
    "lint:all": "nx run-many --target=lint --all",
    "test": "nx affected --target=test:unit",
    "test:all": "nx run-many --target=test:unit --all",
    "lint-staged": "lint-staged",
    "prepare": "is-ci || husky",
    "print-affected": "scripts/print-affected.js",
    "postinstall": "yarn run patch-package",
    "patch-package": "patch-package"
  },
  "dependencies": {
    "keyv": "^5.3.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@changesets/types": "^6.1.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@nx/workspace": "17.2.8",
    "@stoplight/spectral-cli": "^6.14.2",
    "@tsconfig/node22": "^22.0.0",
    "@tsconfig/strictest": "^2.0.5",
    "@types/mustache": "^4.2.5",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "audit-ci": "^7.1.0",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-typescript": "^3.8.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-perfectionist": "^4.10.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-regexp": "^2.7.0",
    "eslint-plugin-unicorn": "^57.0.0",
    "eslint-plugin-vitest": "^0.5.4",
    "glob": "^11.0.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^15.5.0",
    "mustache": "^4.2.0",
    "nx": "17.2.8",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.5.3",
    "prettier-plugin-solidity": "^1.4.2",
    "read-pkg": "^9.0.1",
    "rimraf": "^6.0.1",
    "solhint": "^5.0.5",
    "spdx-license-list": "^6.9.0",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.26.1"
  },
  "workspaces": {
    "packages": [
      "apis/*",
      "contracts/*",
      "subgraphs/*"
    ],
    "nohoist": [
      "**/@types/**",
      "**/undici-types",
      "**/@graphprotocol/graph-ts",
      "**/@graphprotocol/graph-ts/**",
      "**/matchstick-as",
      "**/vite",
      "**/vitest",
      "**/@sphereon/**",
      "**/@tsconfig/*"
    ]
  },
  "resolutions": {
    "**/@ethersproject/providers/ws": "^7.5.10",
    "**/@ethersproject/signing-key/elliptic": "^6.6.0",
    "**/@graphql-mesh/cli/node-libcurl": "link:./node_modules/.cache/null",
    "**/@graphprotocol/graph-cli/undici": "7.2.3",
    "**/gluegun/cross-spawn": "^7.0.6",
    "**/gluegun/semver": "^7.7.1",
    "**/gluegun/ejs": "^3.1.10"
  },
  "packageManager": "yarn@1.22.21+sha1.1959a18351b811cdeedbd484a8f86c3cc3bbaf72"
}
