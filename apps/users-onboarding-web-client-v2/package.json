{
  "name": "@ebsiint-app/users-onboarding-web-client-v2",
  "version": "2.0.0-rc.0",
  "private": true,
  "license": "EUPL-1.2",
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env DISABLE_ESLINT_PLUGIN=true react-scripts build && yarn compress",
    "docker:build": "docker build . -t ebsi/users-onboarding-web-client-v2:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "eject": "react-scripts eject",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "compress": "precompress build",
    "lint": "yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "lint:stylelint": "stylelint \"**/*.css\"",
    "release": "standard-version",
    "test": "react-scripts test",
    "test:unit": "react-scripts test --watchAll=false",
    "test:ci": "yarn test:unit --ci --coverage --reporters=default --reporters=jest-sonar --runInBand"
  },
  "dependencies": {
    "@ecl/ec-preset-website": "^2.39.0",
    "@ecl/ec-resources-logo": "^2.39.0",
    "@react-hook/window-size": "^3.0.7",
    "axios": "1.2.1",
    "classnames": "^2.2.6",
    "history": "^5.3.0",
    "prop-types": "^15.8.1",
    "qrcode.react": "^3.0.2",
    "query-string": "^7.1.3",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-focus-on": "^3.7.0",
    "react-google-recaptcha-v3": "^1.10.1",
    "react-router-dom": "^6.6.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^8.19.1",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^12.1.3",
    "@testing-library/user-event": "^14.2.0",
    "@types/enzyme": "^3.10.12",
    "@types/enzyme-adapter-react-16": "^1.0.6",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.11",
    "@types/react": "^17.0.43",
    "@types/react-dom": "^17.0.14",
    "@types/testing-library__jest-dom": "^5.14.5",
    "autoprefixer": "^10.4.13",
    "cross-env": "^7.0.3",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.7",
    "jest-sonar": "^0.2.15",
    "postcss": "^8.4.20",
    "precompress": "^10.0.0",
    "react-scripts": "^5.0.1",
    "source-map-explorer": "^2.5.2",
    "typescript": "4.9.4"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard",
      "stylelint-prettier/recommended"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(axios|@ecl))"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/env.js",
      "!src/index.js"
    ]
  },
  "nx": {
    "namedInputs": {
      "default": [
        "{projectRoot}/**/*"
      ],
      "production": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/public/**/*",
        "!{projectRoot}/**/*.spec.ts",
        "!{projectRoot}/**/*.spec.tsx",
        "!{projectRoot}/**/*.test.ts",
        "!{projectRoot}/**/*.test.tsx",
        "{projectRoot}/tsconfig.json"
      ]
    }
  }
}
