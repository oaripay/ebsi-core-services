# ENDPOINT
PUBLIC_URL=/users-onboarding/v2

# The following variables must be defined in order to run the webapp

# reCAPTCHA key
# REACT_APP_CAPTCHA_KEY=

# EBSI APIs domain (e.g. https://api.test.intebsi.xyz)
# REACT_APP_EBSI_API_DOMAIN=

# EBSI APPs domain (e.g. https://app.test.intebsi.xyz)
# REACT_APP_EBSI_APP_DOMAIN=

# EU Login instance (https://ecas.acceptance.ec.europa.eu/cas or https://ecas.ec.europa.eu/cas)
# REACT_APP_EULOGIN=
