{
  "name": "@ebsiint-app/users-onboarding",
  "version": "2.0.0-rc.0",
  "private": true,
  "license": "EUPL-1.2",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "audit": "audit-ci --skip-dev --moderate -a GHSA-rp65-9cf3-cjxr",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "compress": "precompress build",
    "lint": "yarn lint:eslint && yarn lint:tsc && yarn lint:prettier",
    "lint:eslint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:tsc": "tsc --noEmit --incremental false",
    "lint:prettier": "prettier . --check",
    "lint:stylelint": "stylelint \"**/*.css\"",
    "release": "standard-version",
    "test:ci": "react-scripts test --watchAll=false --ci --coverage --reporters=default --reporters=jest-sonar --runInBand"
  },
  "dependencies": {
    "@ecl/ec-preset-website": "^2.39.0",
    "@ecl/ec-resources-logo": "^2.39.0",
    "@react-hook/window-size": "^3.0.7",
    "axios": "^0.27.2",
    "classnames": "^2.2.6",
    "history": "^5.3.0",
    "prop-types": "^15.8.1",
    "qrcode.react": "^3.0.2",
    "query-string": "^7.1.1",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-focus-on": "^3.6.0",
    "react-google-recaptcha-v3": "^1.9.8",
    "react-router-dom": "^6.3.0",
    "react-scripts": "^5.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^8.13.0",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^12.1.3",
    "@testing-library/user-event": "^14.2.0",
    "@types/enzyme": "^3.10.12",
    "@types/enzyme-adapter-react-16": "^1.0.6",
    "@types/node": "^17.0.41",
    "@types/qrcode.react": "^1.0.2",
    "@types/react": "^17.0.43",
    "@types/react-dom": "^17.0.14",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^5.27.1",
    "@typescript-eslint/parser": "^5.27.1",
    "audit-ci": "^6.3.0",
    "autoprefixer": "^10.4.7",
    "cross-env": "^7.0.3",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.6",
    "eslint": "^8.17.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^25.3.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.30.0",
    "eslint-plugin-react-hooks": "^4.5.0",
    "eslint-plugin-testing-library": "^5.5.1",
    "jest-sonar": "^0.2.11",
    "lint-staged": "^13.0.0",
    "postcss": "^8.4.14",
    "precompress": "^7.0.1",
    "prettier": "^2.6.2",
    "source-map-explorer": "^2.5.2",
    "standard-version": "^9.5.0",
    "stylelint": "^14.8.5",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-standard": "^25.0.0",
    "stylelint-prettier": "^2.0.0",
    "typescript": "~4.7.3"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "airbnb/hooks",
      "plugin:@typescript-eslint/recommended",
      "plugin:@typescript-eslint/recommended-requiring-type-checking",
      "plugin:jest/recommended",
      "plugin:jest/style",
      "prettier",
      "plugin:prettier/recommended"
    ],
    "parserOptions": {
      "project": "./tsconfig.eslint.json"
    },
    "rules": {
      "@typescript-eslint/no-unsafe-return": "off",
      "@typescript-eslint/no-floating-promises": "off",
      "@typescript-eslint/no-empty-function": "off"
    }
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard",
      "stylelint-prettier/recommended"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "standard-version": {
    "skip": {
      "commit": true,
      "tag": true
    },
    "header": "# Changelog\n\nAll notable changes to this project will be documented in this file.\n",
    "types": [
      {
        "type": "feat",
        "section": "🚀 Features"
      },
      {
        "type": "fix",
        "section": "🐛 Bug Fixes"
      },
      {
        "type": "chore",
        "hidden": true
      },
      {
        "type": "docs",
        "hidden": true
      },
      {
        "type": "style",
        "hidden": true
      },
      {
        "type": "refactor",
        "hidden": true
      },
      {
        "type": "perf",
        "hidden": true
      },
      {
        "type": "test",
        "hidden": true
      }
    ],
    "commitUrlFormat": "https://ec.europa.eu/digital-building-blocks/code/projects/EBSI/repos/users-onboarding-web-client/commits/{{hash}}",
    "issueUrlFormat": "https://ec.europa.eu/digital-building-blocks/code/projects/EBSI/repos/users-onboarding-web-client/pull-requests/{{id}}/overview",
    "compareUrlFormat": "https://ec.europa.eu/digital-building-blocks/code/projects/EBSI/repos/users-onboarding-web-client/compare/diff?targetBranch=refs%2Ftags%2F{{previousTag}}&sourceBranch=refs%2Ftags%2F{{currentTag}}&targetRepoId=406"
  }
}
