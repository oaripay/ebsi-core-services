{
  "name": "@ebsiint-app/registries-manager",
  "version": "0.1.0",
  "private": true,
  "homepage": "/registries-manager",
  "scripts": {
    "audit": "audit-ci --moderate --skip-dev -a 1747 1751",
    "start": "SKIP_PREFLIGHT_CHECK=true craco start",
    "build": "SKIP_PREFLIGHT_CHECK=true craco build",
    "docker:build": "docker build . -t ebsi/registries-manager:${GIT_COMMIT} --build-arg DOCKER_TAG=${GIT_COMMIT}",
    "test": "craco test",
    "eject": "react-scripts eject",
    "lint:css": "stylelint \"./src/**/*.css\"",
    "lint:js": "eslint src/ --ext .ts,.tsx --fix",
    "lint:prettier": "prettier --check \"**/*.{md,mdx,html,json,yml,js,jsx,ts,tsx,css,scss}\"",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:prettier"
  },
  "dependencies": {
    "@ant-design/charts": "1.3.3",
    "@ant-design/icons": "4.2.1",
    "@cef-ebsi/wallet-lib": "1.0.0-rc.2",
    "@craco/craco": "6.2.0",
    "@metamask/detect-provider": "1.2.0",
    "antd": "^4.23.1",
    "bn.js": "5.2.0",
    "bs58": "4.0.1",
    "craco-less": "1.18.0",
    "elliptic": "6.5.4",
    "ethers": "5.0.2",
    "fuse.js": "6.2.1",
    "moment": "2.29.1",
    "multiformats": "9.4.8",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-json-pretty": "2.2.0",
    "react-router-dom": "^5.3.3",
    "react-scripts": "4.0.3"
  },
  "devDependencies": {
    "@testing-library/react": "^9.3.2",
    "@testing-library/user-event": "^7.1.2",
    "@testing-library/jest-dom": "^4.2.4",
    "@types/bs58": "4.0.1",
    "@types/jest": "24.0.0",
    "@types/node": "12.0.0",
    "@types/react": "^16.9.49",
    "@types/react-dom": "^16.9.8",
    "@types/react-router-dom": "^5.3.3",
    "audit-ci": "4.1.0",
    "eslint": "^8.17.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^25.3.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.30.0",
    "eslint-plugin-react-hooks": "^4.5.0",
    "eslint-plugin-testing-library": "^5.5.1",
    "prettier": "^2.6.2",
    "stylelint": "^14.8.5",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-standard": "^25.0.0",
    "stylelint-prettier": "^2.0.0",
    "typescript": "~4.7.4"
  },
  "resolutions": {
    "**/@types/react": "~17.0.0",
    "**/@types/react-dom": "~17.0.0"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "airbnb/hooks",
      "plugin:@typescript-eslint/recommended",
      "plugin:@typescript-eslint/recommended-requiring-type-checking",
      "plugin:jest/recommended",
      "plugin:jest/style",
      "prettier",
      "plugin:prettier/recommended"
    ],
    "parserOptions": {
      "project": "./tsconfig.eslint.json"
    },
    "rules": {
      "@typescript-eslint/no-unsafe-return": "off",
      "@typescript-eslint/no-floating-promises": "off",
      "@typescript-eslint/no-empty-function": "off",
      "@typescript-eslint/no-unsafe-call": "off",
      "@typescript-eslint/no-unsafe-member-access": "off",
      "@typescript-eslint/no-unsafe-assignment": "off",
      "@typescript-eslint/no-unsafe-argument": "off",
      "@typescript-eslint/unbound-method": "off",
      "@typescript-eslint/ban-types": "off",
      "@typescript-eslint/no-misused-promises": "off",
      "@typescript-eslint/await-thenable": "off",
      "@typescript-eslint/require-await": "off",
      "@typescript-eslint/restrict-plus-operands": "off",
      "@typescript-eslint/restrict-template-expressions": "off"
    }
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard",
      "stylelint-prettier/recommended"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
