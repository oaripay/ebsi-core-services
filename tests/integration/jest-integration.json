{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../..",
  "testEnvironment": "node",
  "testMatch": ["<rootDir>/tests/integration/**/*.spec.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "src/**/*.{js,ts}",
    "!**/*.spec.ts",
    "!**/node_modules/**",
    "!src/app.ts",
    "!src/main.ts"
  ]
}
