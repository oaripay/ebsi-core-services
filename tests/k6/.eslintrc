{
  "root": true,
  "extends": [
    "airbnb-base",
    "plugin:jest/recommended",
    "plugin:jest/style",
    "plugin:prettier/recommended",
    "prettier/@typescript-eslint"
  ],
  "rules": {
    "import/no-unresolved": ["error", { "ignore": ["^k6"] }]
  },
  "globals": {
    "__ENV": true
  }
}
