{
  "extends": "nx/presets/npm.json",
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "affected": {
    "defaultBase": "origin/main"
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "test": [
      "{projectRoot}/src/**/*",
      "{projectRoot}/tests/**/*",
      "{projectRoot}/vitest.config.ts",
      "{projectRoot}/tsconfig.json",
      "{projectRoot}/.env*"
    ],
    "production": [
      "{projectRoot}/src/**/*",
      "{projectRoot}/contracts/**/*",
      "{projectRoot}/scripts/**/*",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/.solhint*",
      "{projectRoot}/.graphclientrc.yml",
      "{projectRoot}/hardhat.config.ts",
      "{projectRoot}/nest-cli.json",
      "{projectRoot}/package.json",
      "{projectRoot}/schema.graphql",
      "{projectRoot}/subgraph.template.yaml",
      "{projectRoot}/tsconfig.production.json",
      "{projectRoot}/tsconfig.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/generated"],
      "dependsOn": ["^build", "prepare"],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "^production", "!{projectRoot}/.env*"],
      "outputs": [],
      "dependsOn": ["^build", "prepare"],
      "cache": true
    },
    "prepare": {
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/.graphclient"],
      "dependsOn": ["^build"],
      "cache": true
    },
    "postinstall": {
      "dependsOn": []
    },
    "start:prod": {
      "inputs": ["production", "^production"],
      "outputs": [],
      "dependsOn": ["^build", "build"]
    },
    "test": {
      "inputs": ["test", "^production"],
      "outputs": [],
      "dependsOn": ["^build", "prepare"],
      "cache": true
    },
    "test:unit": {
      "inputs": ["test", "^production"],
      "outputs": [],
      "dependsOn": ["^build", "prepare"],
      "cache": true
    },
    "test:ci": {
      "inputs": ["test", "^production"],
      "outputs": [],
      "dependsOn": ["^build", "prepare"],
      "cache": true
    },
    "test:e2e": {
      "inputs": ["test", "^production"],
      "outputs": [],
      "dependsOn": ["^build", "prepare"]
    },
    "compile": {
      "cache": true
    },
    "prepare-contracts": {
      "cache": true
    }
  }
}
