{
  "extends": "nx/presets/npm.json",
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "npmScope": "@ebsi/core-services",
  "affected": {
    "defaultBase": "origin/main"
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": ["build", "lint", "test", "test:unit", "test:ci"]
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "test": [
      "{workspaceRoot}/jest-resolver.js",
      "{projectRoot}/src/**/*",
      "{projectRoot}/tests/**/*",
      "{projectRoot}/jest.config.js",
      "{projectRoot}/tsconfig.json",
      "{projectRoot}/.env*"
    ],
    "production": [
      "{projectRoot}/src/**/*",
      "{projectRoot}/contracts/**/*",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/.solhint*",
      "{projectRoot}/hardhat.config.ts",
      "{projectRoot}/nest-cli.json",
      "{projectRoot}/tsconfig.production.json",
      "{projectRoot}/tsconfig.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"]
    },
    "lint": {
      "inputs": ["default", "^production", "!{projectRoot}/.env*"],
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "inputs": ["test", "^production"],
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "test:ci": {
      "inputs": ["test", "^production"],
      "outputs": [],
      "dependsOn": ["^build"]
    }
  }
}
