# Override .env settings for testing
# E.g. make sure all the tests run in "test" env
# You can override these settings by creating a new file called .env.test.local
EBSI_ENV=test
EU_LOGIN_VALIDATE_SERVICE_URL=https://ecas.acceptance.ec.europa.eu/cas/TicketValidationService

# Test App
# Used for e2e tests. This App must be registered in the Trusted Apps Registry
TEST_APP_ID=
TEST_APP_NAME=
TEST_APP_PRIVATE_KEY=

# A secp256k1 elliptic curve private key for the user
USER_PRIVATE_KEY=

# DID, as registered in the DID Registry for the user
USER_DID=
