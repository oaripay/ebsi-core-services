# Override .env settings for testing
# E.g. make sure all the tests run in "test" env
# You can override these settings by creating a new file called .env.test.local
EBSI_ENV=test
CASSANDRA_USER=cassandra_test
CASSANDRA_PASSWORD=cassandra_test
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_KEYSPACE=ebsi_test
CASSANDRA_CONSISTENCY_READ=one
CASSANDRA_CONSISTENCY_WRITE=one
ENCRYPTION_SECRET=secret
