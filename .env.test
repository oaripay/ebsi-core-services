# Override .env settings for testing
# E.g. make sure all the tests run in "test" env
# You can override these settings by creating a new file called .env.test.local
EBSI_ENV=test

# For e2e tests
EU_LOGIN_VALIDATE_SERVICE_URL=https://ecas.ec.europa.eu/cas/TicketValidationService
EULOGIN_SERVICE_PARAM=https://app.test.intebsi.xyz/users-onboarding/authentication
APPLICATION_ID=0x19d004e7f6ecf264523e136924cb68796ca9dbfa25bca053b2f6af0fc6fdd88c
APPLICATION_DID=did:ebsi:zwC56DZdiJh8kSxbgg4fMCu
APPLICATION_VERIFICATION_METHOD_KID="did:ebsi:zwC56DZdiJh8kSxbgg4fMCu#keys-1"
AUTHORISATION_CREDENTIAL_SCHEMA=https://api.test.intebsi.xyz/trusted-schemas-registry/v1/schemas/0x312e332e362e312e342e312e313539332e312e3130342e322e312e332e3733
RECAPTCHA_API_KEY=test

# A secp256k1 elliptic curve private key for the user
# TEST_USER_PRIVATE_KEY=

# DID, as registered in the DID Registry for the user
# TEST_USER_DID=

# EU Login test user
