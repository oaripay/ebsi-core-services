# Override .env settings for testing
# E.g. make sure all the tests run in "test" env
# You can override these settings by creating a new file called .env.test.local
EBSI_ENV=test
CONTRACT_ADDR=0x4d06B562588cb61616959806726c5D9f060b0F21

# When running e2e tests locally
BESU_RPC_NODE=https://username:password@www.test.intebsi.xyz/besu

# Test Clients
# Used for e2e tests
# TEST_USER_DID=
# TEST_USER_PRIVATE_KEY=
# This client must be registered in the DID Registry AND have the right attributes in TPR.
# TEST_ADMIN_DID=
# TEST_ADMIN_PRIVATE_KEY=
