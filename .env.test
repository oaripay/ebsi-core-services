# Override .env settings for testing
# E.g. make sure all the tests run in "test" env
# You can override these settings by creating a new file called .env.test.local
EBSI_ENV=test

DOMAIN=https://test.intebsi.xyz

# For the unit tests, any URL is valid
BESU_RPC_NODE=https://besu.local

# API Authorisation URL. Used in e2e tests.
# Default value: depends on the environment, see src/config/configuration.ts
# AUTHORISATION_API_URL=

# Test User
# TEST_USER_KID=
# TEST_USER_PRIVATE_KEY=

# Test App
# Used for e2e tests. This App must be registered in the Trusted Apps Registry
# TEST_APP_ID=
# TEST_APP_NAME=
# TEST_APP_PRIVATE_KEY=

# Authorisation URL
# Default value: depends on the environment, see src/config/configuration.ts
# AUTHORISATION=

# Fabric (replace these values in .env.test.local)
FABRIC_ENABLED=true
FABRIC_USERNAME=username
FABRIC_PASSWORD=password
FABRIC_ADMIN_PEM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n-----END PRIVATE KEY-----\n"
FABRIC_ADMIN_XPATH_PRIVATE_KEY=/path/to/private.key

# Env for e2e tests. Switch to remote API instance with `TEST_ENV=remote`
# TEST_ENV=
